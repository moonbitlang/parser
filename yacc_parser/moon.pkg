import {
  "moonbitlang/parser/syntax",
  "moonbitlang/parser/syntax/util",
  "moonbitlang/parser/tokens",
  "moonbitlang/parser/basic",
  "moonbitlang/parser/attribute",
  "moonbitlang/core/list",
}

warnings = "-6"

rule(
  name: "moonyacc",
  command: "moon runwasm moonbitlang/yacc@0.7.14 --no-comments --external-tokens $input -o $output && moonfmt -w $output && moonfmt -w $output",
)

dev_build(rule: "moonyacc", input: "parser.mbty", output: "parser.mbt")
