import {
  "moonbitlang/parser/syntax",
  "moonbitlang/parser/syntax/util",
  "moonbitlang/lexer/tokens",
  "moonbitlang/lexer/basic",
  "moonbitlang/parser/attribute",
  "moonbitlang/core/list",
}

warnings = "-6"

formatter(ignore: [ "parser.mbt" ])

rule(
  name: "moonyacc",
  command: "moonx moonbitlang/yacc@0.7.22 --no-comments --external-tokens $input -o $output",
)

dev_build(rule: "moonyacc", input: "parser.mbty", output: "parser.mbt")
