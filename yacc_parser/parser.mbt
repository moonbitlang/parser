// Workaround for EOI unused warning

///|
fn init {
  match (EOI : YYSymbol) {
    EOI => ()
    _ => ()
  }
}

// file:///./parser.mbty
// 424|    list_semis(structure_item) EOF { $1 }

///|
fn yy_action_0(
  _last_pos : Position,
  _args : ArrayView[(YYObj, Position, Position)],
) -> YYObj {
  guard _args[0].0 is YYObj_List_Impl_(_dollar1)
  YYObj_List_Impl_(
    {
      ()
      _dollar1
    },
  )
}

// file:///./parser.mbty
// 223|    non_empty_list_semis(X) { $1 }

///|
fn yy_action_1(
  _last_pos : Position,
  _args : ArrayView[(YYObj, Position, Position)],
) -> YYObj {
  guard _args[0].0 is YYObj_List_Impl_(_dollar1)
  YYObj_List_Impl_(
    {
      ()
      _dollar1
    },
  )
}

// file:///./parser.mbty
// 308|    attributes visibility is_async fun_header_generic option(parameters) func_return_type {
// 309|    let ((type_name, f), has_error, quants) = $4
// 310|    let (return_type, error_type) = $6
// 311|    FunDecl::{
// 312|      type_name,
// 313|      name: f,
// 314|      has_error,
// 315|      is_async : $3,
// 316|      quantifiers: quants,
// 317|      decl_params: $5,
// 318|      params_loc: mk_loc($loc($5)),
// 319|      return_type,
// 320|      error_type,
// 321|      vis: $2,
// 322|      doc: DocString::empty(),
// 323|      attrs: $1,
// 324|    }
// 325|  }

///|
fn yy_action_2(
  _last_pos : Position,
  _args : ArrayView[(YYObj, Position, Position)],
) -> YYObj {
