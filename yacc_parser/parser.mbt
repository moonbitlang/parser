  match _lookahead {
    T_LPAREN => Shift(yy_state_137)
    NT_parameters_with_locs => Shift(yy_state_1065)
    NT_option_parameters_with_locs_ => Shift(yy_state_2021)
    T_RAISE | T_EQUAL | T_LBRACE | T_THIN_ARROW | T_NORAISE | T_WHERE =>
      Reduce(0, NT_option_parameters_with_locs_, yy_action_288)
    _ => Error
  }
}

///|
fn yy_state_2021(_lookahead : YYSymbol) -> YYDecision {
  match _lookahead {
    NT_error_annotation => Shift(yy_state_48)
    T_THIN_ARROW => Shift(yy_state_49)
    T_NORAISE => Shift(yy_state_76)
    T_RAISE => Shift(yy_state_77)
    NT_func_return_type_with_loc => Shift(yy_state_2022)
    T_EQUAL | T_LBRACE | T_WHERE =>
      Reduce(0, NT_func_return_type_with_loc, yy_action_895)
    _ => Error
  }
}

