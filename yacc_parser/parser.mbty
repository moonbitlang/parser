%derive<Debug> Token
%derive<Eq> TokenKind
%derive<Hash> TokenKind
%derive<Compare> TokenKind
%position<Position>
%derive<Debug> ParseError

%start structure
%start expression

%token<CharLiteral> CHAR
%token<String> INT
%token<CharLiteral> BYTE
%token<StringLiteral> BYTES
%token<String> FLOAT
%token<String> DOUBLE
%token<StringLiteral> STRING
%token<String> MULTILINE_STRING
%token<InterpLiteral> MULTILINE_INTERP
%token<InterpLiteral> INTERP
%token<String> REGEX_LITERAL
%token<InterpLiteral> REGEX_INTERP
%token<(String, String?, String)> ATTRIBUTE
%token<String> LIDENT
%token<String> UIDENT
%token<String> POST_LABEL
%token<Comment> COMMENT
%token NEWLINE
%token<String> INFIX1
%token<String> INFIX2
%token<String> INFIX3
%token<String> INFIX4
%token<String> AUGMENTED_ASSIGNMENT
%token PLUS_EQUAL "+="
%token EOF
%token FALSE
%token TRUE
%token PUB "pub"
%token PRIV "priv"
%token READONLY "readonly"
%token IMPORT "import"
%token EXTERN "extern"
%token BREAK "break"
%token CONTINUE "continue"
%token STRUCT "struct"
%token ENUM "enum"
%token TRAIT "trait"
%token DERIVE "derive"
%token IMPL "impl"
%token WITH "with"
%token RAISE "raise"
%token THROW "throw"
%token TRY "try"
%token CATCH "catch"
%token ASYNC "async"
%token TYPEALIAS "typealias"
%token TRAITALIAS "traitalias"
%token FNALIAS "fnalias"
%token EQUAL "="
%token EQ_TILDE "=~"
%token LPAREN "("
%token RPAREN ")"
%token COMMA ","
%token MINUS "-"
%token QUESTION "?"
%token EXCLAMATION "!"
%token<String> DOT_LIDENT
%token<String> DOT_UIDENT
%token<Int> DOT_INT
%token DOT_LPAREN ".("
%token COLONCOLON "::"
%token COLON ":"
%token<Bool> SEMI
%token LBRACKET "["
%token PLUS "+"
%token RBRACKET "]"
%token UNDERSCORE "_"
%token BAR "|"
%token LBRACE "{"
%token RBRACE "}"
%token AMPERAMPER "&&"
%token AMPER "&"
%token CARET "^"
%token BARBAR "||"
%token<String> PACKAGE_NAME
%token AS "as"
%token PIPE "|>"
%token PIPE_LEFT "<|"
%token LT_PLUS "<+"
%token ELSE "else"
%token FN "fn"
%token IF "if"
%token LET "let"
%token PROOF_ASSERT "proof_assert"
%token PROOF_LET "proof_let"
%token CONST "const"
%token MATCH "match"
%token USING "using"
%token MUTABLE "mut"
%token TYPE "type"
%token FAT_ARROW "=>"
%token THIN_ARROW "->"
%token WHILE "while"
%token RETURN "return"
%token DOTDOT ".."
%token RANGE_INCLUSIVE "..="
%token RANGE_LT_INCLUSIVE  "..<="
%token RANGE_EXCLUSIVE "..<"
%token RANGE_INCLUSIVE_REV ">=.."
%token RANGE_EXCLUSIVE_REV ">.."
%token ELLIPSIS "..."
%token TEST "test"
%token LOOP "loop"
%token GUARD "guard"
%token DEFER "defer"
%token FOR "for"
%token IN "in"
%token IS "is"
%token SUBERROR "suberror"
%token AND "and"
%token FORALL "∀"
%token EXISTS "∃"
%token IMPLIES "→"
%token LETREC "letrec"
%token ENUMVIEW "enumview"
%token EXTENUM "extenum"
%token DECLARE         "declare"
%token NORAISE "noraise"
%token NOBREAK         "nobreak"
%token WHERE           "where"
%token TRY_QUESTION    "try?"
%token TRY_EXCLAMATION "try!"
%token LEXMATCH        "lexmatch"
%token LEXMATCH_QUESTION "lexmatch?"

// Note: this token is only used by `.mbti` parser
%token PACKAGE         "package"


%right IMPLIES
%right BARBAR
%right AMPERAMPER
%left BAR
%left CARET
%left AMPER

// x.f(...) should be [Pexpr_dot_apply], not [Pexpr_apply(Pexpr_field, ...)]
// these two precedences are used to resolve this.
%nonassoc prec_field
%nonassoc LPAREN
%left INFIX1
%left INFIX2
%left PLUS MINUS
%left INFIX3
%left INFIX4
%nonassoc prec_lower_than_as
%nonassoc "as"
%nonassoc prec_apply_non_ident_fn
%nonassoc "!"
%nonassoc "?"

// the precedence of "," and ")" are used to compare with prec_apply_non_ident_fn
// to make sure when parsing (a, b) => ...
// the comma and rparen are always shifted
%nonassoc prec_lower_than_arrow_fn
%nonassoc ","
%nonassoc ")"
%nonassoc ":"

// to resolve ambiguities with the "with" keyword.
// E.g. `lexmatch a lexmatch? "" with longest {}`
%nonassoc prec_LEXMATCH_QUESTION
%nonassoc WITH

%%


non_empty_list_rev[T](X : T) -> List[T]
  : X { @list.singleton($1) }
  | non_empty_list_rev(X) X { $1.add($2) }
  ;

non_empty_list[T](X : T) -> List[T]
  : X { @list.singleton($1) }
  | X non_empty_list(X) { $2.add($1) }
  ;

non_empty_list_commas_rev[T](X : T) -> List[T]
  : X { @list.singleton($1) }
  | non_empty_list_commas_rev(X) "," X { $1.add($3) }
  ;

non_empty_list_commas_no_trailing[T](X : T) -> List[T]
  : non_empty_list_commas_rev(X) { $1.rev() }
  ;

non_empty_list_commas[T](X : T) -> List[T]
  : non_empty_list_commas_rev(X) option(",") { $1.rev() }
  ;

non_empty_list_commas_with_tail[T](X : T) -> List[T]
  : non_empty_list_commas_rev(X) "," { $1.rev() }
  ;

list_commas[T](X : T) -> List[T]
  : { @list.empty() }
  | non_empty_list_commas(X) { $1 }
  ;

list_commas_no_trailing[T](X : T) -> List[T]
  : { @list.empty() }
  | non_empty_list_commas_no_trailing(X) { $1 }
  ;

non_empty_list_commas_info_rev[T](X : T) -> (List[T], List[Location])
  : X { (@list.singleton($1), @list.empty()) }
  | non_empty_list_commas_info_rev(X) "," X {
      let (items, comma_locs) = $1
      (items.add($3), comma_locs.add(mk_loc($loc($2))))
    }
  ;

non_empty_list_commas_info[T](X : T) -> (List[T], List[Location], Location?)
  : non_empty_list_commas_info_rev(X) {
      let (items, comma_locs) = $1
      (items.rev(), comma_locs.rev(), None)
    }
  | non_empty_list_commas_info_rev(X) "," {
      let (items, comma_locs) = $1
      (items.rev(), comma_locs.rev(), Some(mk_loc($loc($2))))
    }
  ;

list_commas_info[T](X : T) -> (List[T], List[Location], Location?)
  : { (@list.empty(), @list.empty(), None) }
  | non_empty_list_commas_info(X) { $1 }
  ;

non_empty_list_commas_with_trailing_info[T](X : T) -> (List[T], Bool)
  : non_empty_list_commas_rev(X) option(",") {
    ($1.rev(), $2 is Some(_))
  }
  ;

list_commas_with_trailing_info[T](X : T) -> (List[T], Bool)
  : { (@list.empty(), false) }
  | non_empty_list_commas_with_trailing_info(X) { $1 }
  ;

non_empty_list_semi_rev_aux[T](X : T) -> List[T]
  : X { @list.singleton($1) }
  | non_empty_list_semi_rev_aux(X) SEMI X { $1.add($3) }
  ;

non_empty_list_semis_rev[T](X : T) -> List[T]
  : non_empty_list_semi_rev_aux(X) option(SEMI) { $1 }
  ;

non_empty_list_semis_info_rev[T](X : T) -> (List[T], List[Location])
  : X { (@list.singleton($1), @list.empty()) }
  | non_empty_list_semis_info_rev(X) SEMI X {
      let (items, semi_locs) = $1
      (items.add($3), semi_locs.add(mk_loc($loc($2))))
    }
  ;

non_empty_list_semis_info[T](X : T) -> (List[T], List[Location], Location?)
  : non_empty_list_semis_info_rev(X) {
      let (items, semi_locs) = $1
      (items.rev(), semi_locs.rev(), None)
    }
  | non_empty_list_semis_info_rev(X) SEMI {
      let (items, semi_locs) = $1
      (items.rev(), semi_locs.rev(), Some(mk_loc($loc($2))))
    }
  ;

list_semis_info[T](X : T) -> (List[T], List[Location], Location?)
  : { (@list.empty(), @list.empty(), None) }
  | non_empty_list_semis_info(X) { $1 }
  ;

none_empty_list_semis_rev_with_trailing_info[T](X : T) -> (List[T], Bool)
  : non_empty_list_semi_rev_aux(X) option(SEMI) { ($1, $2 is Some(_)) }
  ;

non_empty_list_semis[T](X : T) -> List[T]
  : X option(SEMI) { @list.singleton($1) }
  | X SEMI non_empty_list_semis(X) { $3.add($1) }
  ;

list_semis_rev[T](X : T) -> List[T]
  : { @list.empty() }
  | non_empty_list_semis_rev(X) { $1 }
  ;

list_semis[T](X : T) -> List[T]
  : { @list.empty() }
  | non_empty_list_semis(X) { $1 }
  ;

%inline id[T](X : T) -> T
  : X { $1 }
  ;

%inline annot -> Type
  : ":" type_ { $2 }
  ;

%inline opt_annot -> Type?
  : ioption(annot) { $1 }
  ;

%inline annot_info -> (Type, Location)
  : ":" type_ { ($2, mk_loc($loc($1))) }
  ;

%inline opt_annot_info -> (Type?, Location?)
  : ioption(annot_info) {
      match $1 {
        Some((ty, colon_loc)) => (Some(ty), Some(colon_loc))
        None => (None, None)
      }
    }
  ;

parameter -> Parameter
  : "_" opt_annot_info {
      let (ty, colon_loc) = $2
      DiscardPositional(ty~, loc = mk_loc($loc($1)), colon_loc~)
    }
  | binder opt_annot_info {
      let (ty, colon_loc) = $2
      Positional(binder = $1, ty~, colon_loc~)
    }
  | POST_LABEL opt_annot_info {
      let binder = Binder::{ name: $1, loc: mk_loc($loc($1)).trim_last_char() }
      let (ty, colon_loc) = $2
      Labelled(binder~, ty~, colon_loc~)
    }
  | POST_LABEL opt_annot_info "=" expr {
      let binder = Binder::{ name: $1, loc: mk_loc($loc($1)).trim_last_char() }
      let (ty, colon_loc) = $2
      Optional(
        binder~,
        ty~,
        default = $4,
        question_loc = None,
        colon_loc~,
        equal_loc = Some(mk_loc($loc($3))),
      )
    }
  | LIDENT "?" opt_annot_info "=" expr {
      let binder = Binder::{ name: $1, loc: mk_loc($loc($1)) }
      let (ty, colon_loc) = $3
      Optional(
        binder~,
        ty~,
        default = $5,
        question_loc = Some(mk_loc($loc($2))),
        colon_loc~,
        equal_loc = Some(mk_loc($loc($4))),
      )
    }
  | LIDENT "?" opt_annot_info {
      let binder = Binder::{ name: $1, loc: mk_loc($loc($1)) }
      let (ty, colon_loc) = $3
      QuestionOptional(
        binder~,
        ty~,
        question_loc = Some(mk_loc($loc($2))),
        colon_loc~,
      )
    }
  ;

parameters_info -> (List[Parameter], Location, Location, List[Location], Location?)
  : "(" list_commas_info(parameter) ")" {
    let (params, comma_locs, trailing_comma_loc) = $2
    (
      params,
      mk_loc($loc($1)),
      mk_loc($loc($3)),
      comma_locs,
      trailing_comma_loc,
    )
  }
  ;

parameters -> List[Parameter]
  : parameters_info { $1.0 }
  ;

type_parameters_info -> (List[TypeVarBinder], Location, Location, List[Location], Location?)
  : "[" non_empty_list_commas_info(id(tvar_binder)) "]" {
    let (params, comma_locs, trailing_comma_loc) = $2
    (
      params,
      mk_loc($loc($1)),
      mk_loc($loc($3)),
      comma_locs,
      trailing_comma_loc,
    )
  }
  ;

type_parameters -> List[TypeVarBinder]
  : type_parameters_info { $1.0 }
  ;

%inline is_async -> Location?
  : "async" { Some(mk_loc($loc($1))) }
  | { None }
  ;

optional_type_parameters_info -> (List[TypeVarBinder], Location?, Location?, List[Location], Location?)
  : option(type_parameters_info) {
    match $1 {
      None => (@list.empty(), None, None, @list.empty(), None)
      Some((params, lbracket_loc, rbracket_loc, comma_locs, trailing_comma_loc)) =>
        (
          params,
          Some(lbracket_loc),
          Some(rbracket_loc),
          comma_locs,
          trailing_comma_loc,
        )
    }
  }
  ;

optional_type_parameters -> List[TypeVarBinder]
  : optional_type_parameters_info { $1.0 }
  ;

optional_type_parameters_no_constraints_info -> (List[TypeDeclBinder], Location?, Location?, List[Location], Location?)
  : { (@list.empty(), None, None, @list.empty(), None) }
  | "[" non_empty_list_commas_info(id(type_decl_binder)) "]" {
      let (params, comma_locs, trailing_comma_loc) = $2
      (
        params,
        Some(mk_loc($loc($1))),
        Some(mk_loc($loc($3))),
        comma_locs,
        trailing_comma_loc,
      )
    }
  ;

optional_type_parameters_no_constraints -> List[TypeDeclBinder]
  : optional_type_parameters_no_constraints_info { $1.0 }
  ;

%inline optional_type_arguments -> (List[Type], Location?, Location?, List[Location], Location?)
  : {
      (@list.empty(), None, None, @list.empty(), None)
    }
  | "[" non_empty_list_commas_info(type_) "]" {
      let (params, comma_locs, trailing_comma_loc) = $2
      (
        params,
        Some(mk_loc($loc($1))),
        Some(mk_loc($loc($3))),
        comma_locs,
        trailing_comma_loc,
      )
    }
  ;

luident -> String
  : LIDENT { $1 }
  | UIDENT { $1 }
  ;

fun_binder -> (TypeName?, Binder)
  : type_name "::" luident {
    let binder = Binder::{ name: $3, loc: mk_loc($loc($3)) }
    (Some($1), binder)
  }
  | binder { (None, $1) }
  ;

fun_header -> FunDecl
  : attributes visibility is_async fun_header_generic option(parameters_info) func_return_type_info {
    let ((type_name, f), has_error, quants, fn_loc, type_params_lbracket_loc, type_params_rbracket_loc, type_param_comma_locs, type_param_trailing_comma_loc) = $4
    let (decl_params, params_lparen_loc, params_rparen_loc, param_comma_locs, trailing_param_comma_loc) = match $5 {
      None => (None, None, None, @list.empty(), None)
      Some((params, lparen_loc, rparen_loc, comma_locs, trailing_comma_loc)) =>
        (
          Some(params),
          Some(lparen_loc),
          Some(rparen_loc),
          comma_locs,
          trailing_comma_loc,
        )
    }
    let (return_type, error_type, thin_arrow_loc) = $6
    FunDecl::{
      type_name,
      name: f,
      has_error,
      is_async : $3,
      quantifiers: quants,
      decl_params,
      params_loc: mk_loc($loc($5)),
      return_type,
      error_type,
      vis: $2,
      doc: DocString::empty(),
      attrs: $1,
      loc : mk_loc($loc),
      declare_loc: None,
      extern_loc: None,
      fn_loc: Some(fn_loc),
      type_params_lbracket_loc,
      type_params_rbracket_loc,
      type_param_comma_locs,
      type_param_trailing_comma_loc,
      params_lparen_loc,
      params_rparen_loc,
      param_comma_locs,
      trailing_param_comma_loc,
      thin_arrow_loc,
    }
  }
  ;

declare_fun_header -> FunDecl
  : attributes "declare" visibility is_async fun_header_generic option(parameters_info) func_return_type_info {
    let ((type_name, f), has_error, quants, fn_loc, type_params_lbracket_loc, type_params_rbracket_loc, type_param_comma_locs, type_param_trailing_comma_loc) = $5
    let (decl_params, params_lparen_loc, params_rparen_loc, param_comma_locs, trailing_param_comma_loc) = match $6 {
      None => (None, None, None, @list.empty(), None)
      Some((params, lparen_loc, rparen_loc, comma_locs, trailing_comma_loc)) =>
        (
          Some(params),
          Some(lparen_loc),
          Some(rparen_loc),
          comma_locs,
          trailing_comma_loc,
        )
    }
    let (return_type, error_type, thin_arrow_loc) = $7
    FunDecl::{
      type_name,
      name: f,
      has_error,
      is_async : $4,
      quantifiers: quants,
      decl_params,
      params_loc: mk_loc($loc($6)),
      return_type,
      error_type,
      vis: $3,
      doc: DocString::empty(),
      attrs: $1,
      loc : mk_loc($loc),
      declare_loc: Some(mk_loc($loc($2))),
      extern_loc: None,
      fn_loc: Some(fn_loc),
      type_params_lbracket_loc,
      type_params_rbracket_loc,
      type_param_comma_locs,
      type_param_trailing_comma_loc,
      params_lparen_loc,
      params_rparen_loc,
      param_comma_locs,
      trailing_param_comma_loc,
      thin_arrow_loc,
    }
  }

fun_header_generic -> ((TypeName?, Binder), Location?, List[TypeVarBinder], Location, Location?, Location?, List[Location], Location?)
  : "fn" type_parameters_info fun_binder optional_bang {
    let (quants, lbracket_loc, rbracket_loc, comma_locs, trailing_comma_loc) = $2
    (
      $3,
      $4,
      quants,
      mk_loc($loc($1)),
      Some(lbracket_loc),
      Some(rbracket_loc),
      comma_locs,
      trailing_comma_loc,
    )
  }
  | "fn" fun_binder optional_bang optional_type_parameters_info {
    let (quants, lbracket_loc, rbracket_loc, comma_locs, trailing_comma_loc) = $4
    (
      $2,
      $3,
      quants,
      mk_loc($loc($1)),
      lbracket_loc,
      rbracket_loc,
      comma_locs,
      trailing_comma_loc,
    )
  }
  ;

local_type_decl -> LocalTypeDecl
  : "struct" UIDENT "{" list_semis(record_decl_field) "}" deriving_directive_list_info {
    let (deriving, derive_loc, derive_lparen_loc, derive_rparen_loc, derive_comma_locs) = $6
    LocalTypeDecl::{
      tycon : $2,
      tycon_loc : mk_loc($loc($2)),
      components: Record(fields = $4, constr_decl = None),
      deriving,
      keyword_loc: Some(mk_loc($loc($1))),
      body_lbrace_loc: Some(mk_loc($loc($3))),
      body_rbrace_loc: Some(mk_loc($loc($5))),
      body_lparen_loc: None,
      body_rparen_loc: None,
      body_comma_locs: @list.empty(),
      body_trailing_comma_loc: None,
      derive_loc,
      derive_lparen_loc,
      derive_rparen_loc,
      derive_comma_locs,
    }
  }
  | "struct" UIDENT "(" non_empty_list_commas_info(type_) ")" deriving_directive_list_info {
    let (components, body_comma_locs, body_trailing_comma_loc) = $4
    let (deriving, derive_loc, derive_lparen_loc, derive_rparen_loc, derive_comma_locs) = $6
    LocalTypeDecl::{
      tycon : $2,
      tycon_loc : mk_loc($loc($2)),
      components: TupleStruct(components),
      deriving,
      keyword_loc: Some(mk_loc($loc($1))),
      body_lbrace_loc: None,
      body_rbrace_loc: None,
      body_lparen_loc: Some(mk_loc($loc($3))),
      body_rparen_loc: Some(mk_loc($loc($5))),
      body_comma_locs,
      body_trailing_comma_loc,
      derive_loc,
      derive_lparen_loc,
      derive_rparen_loc,
      derive_comma_locs,
    }
  }
  | "enum" UIDENT "{" list_semis(enum_constructor) "}" deriving_directive_list_info {
    let (deriving, derive_loc, derive_lparen_loc, derive_rparen_loc, derive_comma_locs) = $6
    LocalTypeDecl::{
      tycon : $2,
      tycon_loc : mk_loc($loc($2)),
      components: Variant($4),
      deriving,
      keyword_loc: Some(mk_loc($loc($1))),
      body_lbrace_loc: Some(mk_loc($loc($3))),
      body_rbrace_loc: Some(mk_loc($loc($5))),
      body_lparen_loc: None,
      body_rparen_loc: None,
      body_comma_locs: @list.empty(),
      body_trailing_comma_loc: None,
      derive_loc,
      derive_lparen_loc,
      derive_rparen_loc,
      derive_comma_locs,
    }
  }
  ;

extern_fun_header -> (StringLiteral, FunDecl)
  : attributes visibility "extern" STRING "fn" fun_binder optional_bang optional_type_parameters_info option(parameters_info) func_return_type_info {
    let (type_name, f) = $6
    let (quantifiers, type_params_lbracket_loc, type_params_rbracket_loc, type_param_comma_locs, type_param_trailing_comma_loc) = $8
    let (decl_params, params_lparen_loc, params_rparen_loc, param_comma_locs, trailing_param_comma_loc) = match $9 {
      None => (None, None, None, @list.empty(), None)
      Some((params, lparen_loc, rparen_loc, comma_locs, trailing_comma_loc)) =>
        (
          Some(params),
          Some(lparen_loc),
          Some(rparen_loc),
          comma_locs,
          trailing_comma_loc,
        )
    }
    let (return_type, error_type, thin_arrow_loc) = $10
    let fn_decl = FunDecl::{
      type_name,
      name: f,
      has_error: $7,
      is_async : None,
      quantifiers,
      decl_params,
      params_loc: mk_loc($loc($9)),
      return_type,
      error_type,
      vis: $2,
      doc: DocString::empty(),
      attrs: $1,
      loc : mk_loc($loc),
      declare_loc: None,
      extern_loc: Some(mk_loc($loc($3))),
      fn_loc: Some(mk_loc($loc($5))),
      type_params_lbracket_loc,
      type_params_rbracket_loc,
      type_param_comma_locs,
      type_param_trailing_comma_loc,
      params_lparen_loc,
      params_rparen_loc,
      param_comma_locs,
      trailing_param_comma_loc,
      thin_arrow_loc,
    }
    ($4, fn_decl)
  }
  ;

block_expr_info -> (Expr, Location, Location, List[Location], Location?)
  : "{" list_semis_info(statement) "}" {
    let (stmts, semi_locs, trailing_semi_loc) = $2
