      params_lparen_loc = Some(params_lparen_loc),
      params_rparen_loc = Some(params_rparen_loc),
      param_comma_locs = param_comma_locs,
      trailing_param_comma_loc = trailing_param_comma_loc,
      thin_arrow_loc = thin_arrow_loc,
    )
  }
  | attributes visibility "impl" optional_type_parameters_info type_name "with" binder optional_bang parameters_info func_return_type_info impl_body {
    let (quantifiers, type_params_lbracket_loc, type_params_rbracket_loc, type_param_comma_locs, type_param_trailing_comma_loc) = $4
    let (params, params_lparen_loc, params_rparen_loc, param_comma_locs, trailing_param_comma_loc) = $9
    let (ret_ty, err_ty, thin_arrow_loc) = $10
    TopImpl(
      self_ty = None,
      trait_ = $5,
      method_name = $7,
      has_error = $8,
      quantifiers = quantifiers,
      params = params,
      ret_ty~,
      err_ty~,
      body = $11,
      vis = $2,
      loc = mk_loc($sloc),
      attrs = $1,
      doc = DocString::empty(),
      trailing_semi_loc = None,
      impl_loc = Some(mk_loc($loc($3))),
      type_params_lbracket_loc = type_params_lbracket_loc,
      type_params_rbracket_loc = type_params_rbracket_loc,
      type_param_comma_locs = type_param_comma_locs,
      type_param_trailing_comma_loc = type_param_trailing_comma_loc,
      for_loc = None,
      with_loc = Some(mk_loc($loc($6))),
      params_lparen_loc = Some(params_lparen_loc),
      params_rparen_loc = Some(params_rparen_loc),
      param_comma_locs = param_comma_locs,
      trailing_param_comma_loc = trailing_param_comma_loc,
      thin_arrow_loc = thin_arrow_loc,
    )
  }
  | attributes declare_info visibility "impl" optional_type_parameters_info type_name "for" type_ {
    let (is_declare, declare_loc) = $2
    let (quantifiers, type_params_lbracket_loc, type_params_rbracket_loc, type_param_comma_locs, type_param_trailing_comma_loc) = $5
    TopImplRelation(
      self_ty = $8,
      trait_ = $6,
      quantifiers = quantifiers,
      vis = $3,
      attrs = $1,
      loc = mk_loc($sloc),
      doc = DocString::empty(),
      is_declare = is_declare,
      trailing_semi_loc = None,
      declare_loc = declare_loc,
      impl_loc = Some(mk_loc($loc($4))),
      type_params_lbracket_loc = type_params_lbracket_loc,
      type_params_rbracket_loc = type_params_rbracket_loc,
      type_param_comma_locs = type_param_comma_locs,
      type_param_trailing_comma_loc = type_param_trailing_comma_loc,
      for_loc = Some(mk_loc($loc($7))),
    )
  }
  | attributes visibility "enumview" optional_type_parameters_info UIDENT "{" list_semis(enum_constructor) "}" "for" type_ "with" binder parameters_info block_expr {
    let (quantifiers, type_params_lbracket_loc, type_params_rbracket_loc, type_param_comma_locs, type_param_trailing_comma_loc) = $4
    let (parameters, params_lparen_loc, params_rparen_loc, param_comma_locs, trailing_param_comma_loc) = $13
    TopView(
      quantifiers = quantifiers,
      source_ty = $10,
      view_type_name = $5,
      view_type_loc = mk_loc($loc($5)),
      view_func_name = $12,
      parameters = parameters,
      params_loc = mk_loc($loc($13)),
      view_constrs = $7,
      body = $14,
      vis = $2,
      loc = mk_loc($sloc),
      attrs = $1,
      doc = DocString::empty(),
      trailing_semi_loc = None,
      enumview_loc = Some(mk_loc($loc($3))),
      type_params_lbracket_loc = type_params_lbracket_loc,
      type_params_rbracket_loc = type_params_rbracket_loc,
      type_param_comma_locs = type_param_comma_locs,
      type_param_trailing_comma_loc = type_param_trailing_comma_loc,
      constr_lbrace_loc = Some(mk_loc($loc($6))),
      constr_rbrace_loc = Some(mk_loc($loc($8))),
      for_loc = Some(mk_loc($loc($9))),
      with_loc = Some(mk_loc($loc($11))),
      params_lparen_loc = Some(params_lparen_loc),
      params_rparen_loc = Some(params_rparen_loc),
      param_comma_locs = param_comma_locs,
      trailing_param_comma_loc = trailing_param_comma_loc,
    )
  }
  | attributes visibility "using" PACKAGE_NAME "{" list_commas_info(using_binder) "}" {
    let (names, comma_locs, trailing_comma_loc) = $6
    TopUsing(
      pkg = {
        name : $4,
        loc : mk_loc($loc($4))
      },
      names = names,
      vis = $2,
      attrs = $1,
      loc = mk_loc($loc),
      doc = DocString::empty(),
      trailing_semi_loc = None,
      using_loc = Some(mk_loc($loc($3))),
      lbrace_loc = Some(mk_loc($loc($5))),
      rbrace_loc = Some(mk_loc($loc($7))),
      comma_locs = comma_locs,
      trailing_comma_loc = trailing_comma_loc,
    )
  }
  ;

%inline attributes -> List[Attribute]
  :  { @list.empty() }
  | non_empty_list(attribute) { $1 }
  ;

%inline attribute -> Attribute
  : ATTRIBUTE { Attribute::new(loc=mk_loc($sloc), $1) }
  ;

%inline visibility -> Visibility
  :  { Default }
  | "priv" { Priv(loc = mk_loc($sloc)) }
  | "pub" pub_attr { Pub(loc = mk_loc($sloc), attr = $2) }
  ;

pub_attr -> String?
  :  { None }
  | "(" "readonly" ")" { Some("readonly") }
  | "(" LIDENT ")" { Some($2) }
  ;

%inline is_declare -> Bool
  : "declare" { true }
  | { false }

%inline declare_info -> (Bool, Location?)
  : "declare" { (true, Some(mk_loc($loc($1)))) }
  | { (false, None) }
  ;

type_header -> (
  List[Attribute],
  Visibility,
  Bool,
  Location?,
  Location,
  String,
  Location,
  List[TypeDeclBinder],
  Location?,
  Location?,
  List[Location],
  Location?
)
  : attributes declare_info visibility "type" UIDENT optional_type_parameters_no_constraints_info {
    let (is_declare, declare_loc) = $2
    let (params, type_params_lbracket_loc, type_params_rbracket_loc, type_param_comma_locs, type_param_trailing_comma_loc) = $6
    (
      $1,
      $3,
      is_declare,
      declare_loc,
      mk_loc($loc($4)),
      $5,
      mk_loc($loc($5)),
      params,
      type_params_lbracket_loc,
      type_params_rbracket_loc,
      type_param_comma_locs,
      type_param_trailing_comma_loc,
    )
  }
  ;

suberror_header -> (List[Attribute], Visibility, Bool, Location?, Location, String, Location)
  : attributes declare_info visibility "suberror" UIDENT {
    let (is_declare, declare_loc) = $2
    ($1, $3, is_declare, declare_loc, mk_loc($loc($4)), $5, mk_loc($loc($5)))
  }
  ;

struct_header -> (
  List[Attribute],
  Visibility,
  Location,
  String,
  Location,
  List[TypeDeclBinder],
  Location?,
  Location?,
  List[Location],
  Location?
)
  : attributes visibility "struct" UIDENT optional_type_parameters_no_constraints_info {
    let (params, type_params_lbracket_loc, type_params_rbracket_loc, type_param_comma_locs, type_param_trailing_comma_loc) = $5
    (
      $1,
      $2,
      mk_loc($loc($3)),
      $4,
      mk_loc($loc($4)),
      params,
      type_params_lbracket_loc,
      type_params_rbracket_loc,
      type_param_comma_locs,
      type_param_trailing_comma_loc,
    )
  }
  ;

enum_header -> (
  List[Attribute],
  Visibility,
  Location,
  String,
  Location,
  List[TypeDeclBinder],
  Location?,
  Location?,
  List[Location],
  Location?
)
  : attributes visibility "enum" UIDENT optional_type_parameters_no_constraints_info {
    let (params, type_params_lbracket_loc, type_params_rbracket_loc, type_param_comma_locs, type_param_trailing_comma_loc) = $5
    (
      $1,
      $2,
      mk_loc($loc($3)),
      $4,
      mk_loc($loc($4)),
      params,
      type_params_lbracket_loc,
      type_params_rbracket_loc,
      type_param_comma_locs,
      type_param_trailing_comma_loc,
    )
  }
  ;

extenum_extension_target -> (String, Location, List[TypeDeclBinder], TypeName)
  : UIDENT optional_type_parameters_no_constraints {
    let loc = mk_loc($loc($1))
    let target = TypeName::{ name: Ident(name = $1), is_object: false, loc }
    ($1, loc, $2, target)
  }
  | PACKAGE_NAME DOT_UIDENT optional_type_parameters_no_constraints {
    let tycon_loc = mk_loc($loc($2))
    let target = TypeName::{ name: Dot(pkg = $1, id = $2), is_object: false, loc: mk_loc($sloc) }
    ($2, tycon_loc, $3, target)
  }
  ;

batch_type_alias_targets -> (Bool, Label?, List[AliasTarget])
  : PACKAGE_NAME batch_type_alias_target(DOT_UIDENT) {
    let pkg = Label::{ name: $1, loc: mk_loc($loc($1)) }
    (false, Some(pkg), @list.singleton($2))
  }
  | PACKAGE_NAME ".(" non_empty_list_commas(batch_type_alias_target(UIDENT)) ")" {
    let pkg = Label::{ name: $1, loc: mk_loc($loc($1)) }
    (true, Some(pkg), $3)
  }
  | batch_type_alias_target(UIDENT) { (false, None, @list.singleton($1)) }
  ;

batch_type_alias_target(UIDENT_MAYBE_DOT) -> AliasTarget
  : UIDENT_MAYBE_DOT {
    let binder = Binder::{ name: $1, loc: mk_loc($loc($1)) }
    AliasTarget::{ binder, target: None }
  }
  | UIDENT_MAYBE_DOT "as" UIDENT {
    let target = Label::{ name: $1, loc: mk_loc($loc($1)) }
    let binder = Binder::{ name: $3, loc: mk_loc($loc($3)) }
    AliasTarget::{ binder, target: Some(target) }
  }
  ;

func_alias_targets -> (Label?, Label?, Bool, List[AliasTarget])
  : ioption(func_alias_type_name(LIDENT, UIDENT)) func_alias_target(LIDENT) {
    (None, $1, false, @list.singleton($2))
  }
  | PACKAGE_NAME func_alias_target(DOT_LIDENT) {
    let pkg = Label::{ name: $1, loc: mk_loc($loc($1)) }
    (Some(pkg), None, false, @list.singleton($2))
  }
  | PACKAGE_NAME func_alias_type_name(DOT_LIDENT, DOT_UIDENT) func_alias_target(LIDENT) {
    let pkg = Label::{ name: $1, loc: mk_loc($loc($1)) }
    (Some(pkg), Some($2), false, @list.singleton($3))
  }
  | option(func_alias_type_name(LIDENT, UIDENT)) "(" non_empty_list_commas(func_alias_target(LIDENT)) ")" {
    (None, $1, true, $3)
  }
  | PACKAGE_NAME ".(" non_empty_list_commas(func_alias_target(LIDENT)) ")" {
    let pkg = Label::{ name: $1, loc: mk_loc($loc($1)) }
    (Some(pkg), None, true, $3)
  }
  | PACKAGE_NAME func_alias_type_name(DOT_LIDENT, DOT_UIDENT) "(" non_empty_list_commas(func_alias_target(LIDENT)) ")" {
    let pkg = Label::{ name: $1, loc: mk_loc($loc($1)) }
    (Some(pkg), Some($2), true, $4)
  }
  ;

func_alias_type_name(LIDENT_MAYBE_DOT, UIDENT_MAYBE_DOT) -> Label
  : LIDENT_MAYBE_DOT "::" { Label::{ name: $1, loc: mk_loc($loc($1)) } }
  | UIDENT_MAYBE_DOT "::" { Label::{ name: $1, loc: mk_loc($loc($1)) } }
  ;

func_alias_target(LIDENT_MAYBE_DOT) -> AliasTarget
  : LIDENT_MAYBE_DOT option(preceded("as", binder)) {
    match $2 {
      None => {
        let binder = Binder::{ name: $1, loc: mk_loc($loc($1)) }
        AliasTarget::{ binder, target: None }
      }
      Some(binder) => {
        let target = Label::{ name: $1, loc: mk_loc($loc($1)) }
        AliasTarget::{ binder, target: Some(target) }
      }
    }
  }
  ;

using_binder -> (AliasTarget, UsingKind):
  | LIDENT
  | UIDENT {
    let binder = Binder::{
      name : $1,
      loc : mk_loc($loc)
    }
    ({ binder, target : None }, UsingKind::Value)
  }
  | LIDENT "as" LIDENT
  | UIDENT "as" UIDENT {
    let binder = Binder::{
      name : $3,
      loc : mk_loc($loc($3))
    }
    let target = Label::{
      name : $1,
      loc : mk_loc($loc($1))
    }
    ({ binder, target : Some(target) }, UsingKind::Value)
  }
  | "type" UIDENT {
    let binder = Binder::{
      name : $2,
      loc : mk_loc($loc($2))
    }
    ({ binder, target : None }, UsingKind::Type)
  }
  | "type" UIDENT "as" UIDENT {
    let binder = Binder::{
      name : $4,
      loc : mk_loc($loc($4))
    }
    let target = Label::{
      name : $2,
      loc : mk_loc($loc($2))
    }
    ({ binder, target : Some(target) }, UsingKind::Type)
  }
  | "trait" UIDENT {
    let binder = Binder::{
      name : $2,
      loc : mk_loc($loc($2))
    }
    ({ binder, target : None }, UsingKind::Trait)
  }
  | "trait" UIDENT "as" UIDENT {
    let binder = Binder::{
      name : $4,
      loc : mk_loc($loc($4))
    }
    let target = Label::{
      name : $2,
      loc : mk_loc($loc($2))
    }
    ({ binder, target : Some(target) }, UsingKind::Trait)
  }

deriving_directive -> DerivingDirective
  : type_name { DerivingDirective::{ type_name: $1, args: @list.empty(), loc: mk_loc($sloc) } }
  | type_name "(" list_commas(argument) ")" { DerivingDirective::{ type_name: $1, args: $3, loc: mk_loc($sloc) } }
  ;

deriving_directive_list_info -> (List[DerivingDirective], Location?, Location?, Location?, List[Location])
  :  { (@list.empty(), None, None, None, @list.empty()) }
  | "derive" "(" list_commas_info(deriving_directive) ")" {
    let (directives, comma_locs, _) = $3
    (
      directives,
      Some(mk_loc($loc($1))),
      Some(mk_loc($loc($2))),
      Some(mk_loc($loc($4))),
      comma_locs,
    )
  }
  ;

deriving_directive_list -> List[DerivingDirective]
  : deriving_directive_list_info { $1.0 }
  ;

trait_supers_info_rev -> (List[TypeVarConstraint], List[Location])
  : tvar_constraint { (@list.singleton($1), @list.empty()) }
  | tvar_constraint PLUS trait_supers_info_rev {
    ($3.0.add($1), $3.1.add(mk_loc($loc($2))))
  }
  ;

trait_supers_info -> (List[TypeVarConstraint], Location?, List[Location])
  : { (@list.empty(), None, @list.empty()) }
  | ":" trait_supers_info_rev {
    ($2.0, Some(mk_loc($loc($1))), $2.1)
  }
  ;

trait_method_params_info -> (List[Parameter], Location, Location, List[Location], Location?)
  : "(" list_commas_info(trait_method_param) ")" {
    let (params, comma_locs, trailing_comma_loc) = $2
    (
      params,
      mk_loc($loc($1)),
      mk_loc($loc($3)),
      comma_locs,
      trailing_comma_loc,
    )
  }
  ;

trait_method_decl -> TraitMethodDecl
  : attributes is_async binder optional_bang optional_type_parameters_info trait_method_params_info func_return_type_info option(trait_method_default_info) {
    let (quantifiers, type_params_lbracket_loc, type_params_rbracket_loc, type_param_comma_locs, type_param_trailing_comma_loc) = $5
    let (params, params_lparen_loc, params_rparen_loc, param_comma_locs, trailing_param_comma_loc) = $6
    let (return_type, error_type, thin_arrow_loc) = $7
    let (has_default, equal_loc) = match $8 {
      None => (None, None)
      Some((equal_loc, wildcard_loc)) => (Some(wildcard_loc), Some(equal_loc))
    }
    TraitMethodDecl::{
      name: $3,
      has_error: $4,
      is_async: $2,
      quantifiers,
      params,
      return_type,
      error_type,
      has_default,
      attrs: $1,
      loc: mk_loc($sloc),
      type_params_lbracket_loc,
      type_params_rbracket_loc,
      type_param_comma_locs,
      type_param_trailing_comma_loc,
      params_lparen_loc: Some(params_lparen_loc),
      params_rparen_loc: Some(params_rparen_loc),
      param_comma_locs,
      trailing_param_comma_loc,
      thin_arrow_loc,
      equal_loc,
    }
  }
  ;

optional_bang -> Location?
  : "!" { Some(mk_loc($sloc)) }
  |  { None }
  ;

trait_method_default_info -> (Location, Location)
  : "=" wildcard { (mk_loc($loc($1)), $2) }
  ;

wildcard -> Location
  : "_" { mk_loc($sloc) }
  ;

trait_method_param -> Parameter
  : type_ { DiscardPositional(ty = Some($1), loc = mk_loc($sloc), colon_loc = None) }
  | binder ":" type_ { Positional(binder = $1, ty = Some($3), colon_loc = Some(mk_loc($loc($2)))) }
  | binder "?" ":" type_ {
    QuestionOptional(
      binder = $1,
      ty = Some($4),
      question_loc = Some(mk_loc($loc($2))),
      colon_loc = Some(mk_loc($loc($3))),
    )
  }
  | POST_LABEL ":" type_ {
    let binder = Binder::{ name: $1, loc: mk_loc($loc($1)).trim_last_char() }
    Labelled(binder~, ty = Some($3), colon_loc = Some(mk_loc($loc($2))))
  }
  ;

qual_ident -> LongIdent
  : LIDENT { Ident(name = $1) }
  | PACKAGE_NAME DOT_LIDENT { Dot(pkg = $1, id = $2) }
  ;

%inline qual_uident -> LongIdent
  : UIDENT { Ident(name = $1) }
  | PACKAGE_NAME DOT_UIDENT { Dot(pkg = $1, id = $2) }
  ;

qual_ident_simple_expr -> LongIdent
  : LIDENT %prec prec_apply_non_ident_fn { Ident(name = $1) }
  | PACKAGE_NAME DOT_LIDENT { Dot(pkg = $1, id = $2) }
  ;

%inline qual_ident_ty_inline -> LongIdent
  : UIDENT { LongIdent::Ident(name = $1) }
  | PACKAGE_NAME DOT_LIDENT { LongIdent::Dot(pkg = $1, id = $2) }
  | PACKAGE_NAME DOT_UIDENT { LongIdent::Dot(pkg = $1, id = $2) }
  ;

qual_ident_ty -> LongIdent
  : qual_ident_ty_inline { $1 }
  ;

%inline semi_expr_semi_opt -> (Expr, Location?)
  : non_empty_list_semis_info(statement) {
    let (stmts, semi_locs, trailing_semi_loc) = $1
    (
      Statement::compact_rev(
        Statement::attach_semi_locs(stmts, semi_locs, trailing_semi_loc).rev(),
        loc = mk_loc($sloc),
      ),
      trailing_semi_loc,
    )
  }
  ;

letand_func -> Func
  : arrow_fn_expr { $1 }
  | anony_fn { $1 }
  ;

and_func -> (Binder, Type?, Func)
  : "and" binder opt_annot "=" letand_func { ($2, $3, $5) }
  ;

statement -> Statement
  : "let" pattern opt_annot "=" expr {
    let pat = match $3 {
      None => $2
      Some(ty) => Pattern::Constraint(pat = $2, ty~, loc = mk_loc($sloc))
    }
    StmtLet(
      pat~,
      expr = $5,
      loc = mk_loc($sloc),
      let_loc = Some(mk_loc($loc($1))),
      equal_loc = Some(mk_loc($loc($4))),
      semi_loc = None,
    )
  }
  | "letrec" binder opt_annot "=" letand_func list(and_func) {
    let bindings = $6.add(($2, $3, $5))
    StmtLetand(
      bindings~,
      loc = mk_loc($sloc),
      letrec_loc = Some(mk_loc($loc($1))),
      semi_loc = None,
    )
  }
  | "let" "mut" binder opt_annot "=" expr {
    StmtLetmut(
      binder = $3,
      ty_opt = $4,
      expr = $6,
      loc = mk_loc($sloc),
      let_loc = Some(mk_loc($loc($1))),
      mut_loc = Some(mk_loc($loc($2))),
      equal_loc = Some(mk_loc($loc($5))),
      semi_loc = None,
    )
  }
  | is_async "fn" binder optional_bang parameters func_return_type block_expr_info {
    let (return_type, error_type) = $6
    let (body, body_lbrace_loc, body_rbrace_loc, body_semi_locs, body_trailing_semi_loc) = $7
    let func = Func::{
      parameters : $5,
      params_loc : mk_loc($loc($5)),
      body,
      return_type,
      error_type,
      kind : Lambda,
      has_error : $4,
      is_async : $1,
      loc : mk_loc($sloc),
      fn_loc : Some(mk_loc($loc($2))),
      body_lbrace_loc : Some(body_lbrace_loc),
      body_rbrace_loc : Some(body_rbrace_loc),
      body_semi_locs,
      body_trailing_semi_loc,
    }
    StmtFunc(
      binder = $3,
      func~,
      loc = mk_loc($sloc),
      fn_loc = Some(mk_loc($loc($2))),
      semi_loc = None,
    )
  }
  | guard_statement { $1 }
  | "defer" pipe_expr {
    StmtDefer(
      expr = $2,
      loc = mk_loc($sloc),
      defer_loc = Some(mk_loc($loc($1))),
      semi_loc = None,
    )
  }
  | "proof_assert" expr {
    StmtExpr(expr = ProofAssert(expr = $2, loc = mk_loc($sloc)), semi_loc = None)
  }
  | "proof_let" binder "=" expr {
    StmtExpr(
      expr = ProofLet(binder = $2, expr = $4, loc = mk_loc($sloc)),
      semi_loc = None,
    )
  }
  | expr_statement { StmtExpr(expr = $1, semi_loc = None) }
  ;

guard_statement -> Statement
  : "guard" infix_expr {
    StmtGuard(
      cond = $2,
      otherwise = None,
      loc = mk_loc($sloc),
      guard_loc = Some(mk_loc($loc($1))),
      else_loc = None,
      else_lbrace_loc = None,
      else_rbrace_loc = None,
      else_semi_locs = @list.empty(),
      else_trailing_semi_loc = None,
      semi_loc = None,
    )
  }
  | "guard" infix_expr "else" block_expr_info {
    let (otherwise, else_lbrace_loc, else_rbrace_loc, else_semi_locs, else_trailing_semi_loc) = $4
    StmtGuard(
      cond = $2,
      otherwise = Some(otherwise),
      loc = mk_loc($sloc),
      guard_loc = Some(mk_loc($loc($1))),
      else_loc = Some(mk_loc($loc($3))),
      else_lbrace_loc = Some(else_lbrace_loc),
      else_rbrace_loc = Some(else_rbrace_loc),
      else_semi_locs~,
      else_trailing_semi_loc~,
      semi_loc = None,
    )
  }
  ;

%inline assignment_expr -> Expr
  : left_value "=" expr {
    let loc = mk_loc($sloc)
    match $1 {
      Var(var_) => Assign(var_~, expr=$3, augmented_by=None, loc~)
      Field(record, accessor) => Mutate(record~, accessor~, field=$3, augmented_by=None, loc~)
      Array(array, index) => ArraySet(array~, index~, value=$3, loc~)
    }
  }
  ;

%inline augmented_assignment_expr -> Expr
  : left_value assignop expr {
    let loc = mk_loc($sloc)
    match $1 {
      Var(var_) => Assign(var_~, expr=$3, augmented_by=Some($2), loc~)
      Field(record, accessor) => Mutate(record~, accessor~, field=$3, augmented_by=Some($2), loc~)
      Array(array, index) => ArrayAugmentedSet(op=$2, array~, index~, value=$3, loc~)
    }
  }
  ;

template_writing_expr -> Expr
  : left_value "<+" INTERP {
    let template = make_interp_expr(loc = mk_loc($loc($3)), $3)
    match $1 {
      Var(var_) => {
        let expr = @syntax.make_ident_expr(loc = var_.loc, var_)
        TemplateWriting(expr~, template~, loc = mk_loc($sloc))
      }
      Field(record, accessor) => {
        let expr = Expr::Field(record~, accessor~, loc = mk_loc($loc($1)))
        TemplateWriting(expr~, template~, loc = mk_loc($sloc))
      }
      Array(array, index) => {
        let expr = Expr::ArrayGet(array~, index~, loc = mk_loc($loc($1)))
        TemplateWriting(expr~, template~, loc = mk_loc($sloc))
      }
    }
  }
  | left_value "<+" STRING {
    let template = Expr::Constant(
      c = @syntax.Constant::String($3),
      loc = mk_loc($loc($3)),
      uplus_loc = None,
      uminus_loc = None,
    )
    match $1 {
      Var(var_) => {
        let expr = @syntax.make_ident_expr(loc = var_.loc, var_)
        TemplateWriting(expr~, template~, loc = mk_loc($sloc))
      }
      Field(record, accessor) => {
        let expr = Expr::Field(record~, accessor~, loc = mk_loc($loc($1)))
        TemplateWriting(expr~, template~, loc = mk_loc($sloc))
      }
      Array(array, index) => {
        let expr = Expr::ArrayGet(array~, index~, loc = mk_loc($loc($1)))
        TemplateWriting(expr~, template~, loc = mk_loc($sloc))
      }
    }
  }
  | left_value "<+" non_empty_list(multiline_string) {
    let template = Expr::MultilineString(elems = $3, loc = mk_loc($loc($3)))
    match $1 {
      Var(var_) => {
        let expr = @syntax.make_ident_expr(loc = var_.loc, var_)
        TemplateWriting(expr~, template~, loc = mk_loc($sloc))
      }
      Field(record, accessor) => {
        let expr = Expr::Field(record~, accessor~, loc = mk_loc($loc($1)))
        TemplateWriting(expr~, template~, loc = mk_loc($sloc))
      }
      Array(array, index) => {
        let expr = Expr::ArrayGet(array~, index~, loc = mk_loc($loc($1)))
        TemplateWriting(expr~, template~, loc = mk_loc($sloc))
      }
    }
  }
  ;

expr_statement_no_break_continue_return -> Expr
  : "raise" expr {
    Raise(
      err_value = $2,
      loc = mk_loc($sloc),
      raise_loc = Some(mk_loc($loc($1))),
    )
  }
  | "..." { Hole(loc = mk_loc($sloc), kind = Todo) }
  | augmented_assignment_expr { $1 }
  | assignment_expr { $1 }
  | template_writing_expr { $1 }
  | expr { $1 }
  ;

expr_statement -> Expr
  : "break" POST_LABEL option(expr) {
    let label = Label::{ name: $2, loc: mk_loc($loc($2)) }
    Break(
      arg = $3,
      label = Some(label),
      loc = mk_loc($sloc),
      break_loc = Some(mk_loc($loc($1))),
    )
  }
  | "break" option(expr) {
    Break(
      arg = $2,
      label = None,
      loc = mk_loc($sloc),
      break_loc = Some(mk_loc($loc($1))),
    )
  }
  | "continue" POST_LABEL list_commas_no_trailing(expr) {
    let label = Label::{ name: $2, loc: mk_loc($loc($2)) }
    Continue(
      args = $3,
      label = Some(label),
      loc = mk_loc($sloc),
      continue_loc = Some(mk_loc($loc($1))),
    )
  }
  | "continue" list_commas_no_trailing(expr) {
    Continue(
      args = $2,
      label = None,
      loc = mk_loc($sloc),
      continue_loc = Some(mk_loc($loc($1))),
    )
  }
  | "return" option(expr) {
    Return(
      return_value = $2,
      loc = mk_loc($sloc),
      return_loc = Some(mk_loc($loc($1))),
    )
  }
  | expr_statement_no_break_continue_return { $1 }
  ;

loop_label_colon -> Label?
  : POST_LABEL ":" { Some(Label::{ name : $1, loc : mk_loc($sloc) }) }
  |  { None}
  ;

while_expr -> Expr
  : loop_label_colon "while" infix_expr block_expr_info optional_nobreak_info {
    let (loop_body, loop_lbrace_loc, loop_rbrace_loc, _, _) = $4
    let (while_else, nobreak_loc, nobreak_lbrace_loc, nobreak_rbrace_loc) = $5
    While(
      loop_cond = $3,
      loop_body~,
      while_else~,
      label = $1,
      loc = mk_loc($sloc),
      while_loc = Some(mk_loc($loc($2))),
      loop_lbrace_loc = Some(loop_lbrace_loc),
      loop_rbrace_loc = Some(loop_rbrace_loc),
      nobreak_loc~,
      nobreak_lbrace_loc~,
      nobreak_rbrace_loc~,
    )
  }
  ;

single_pattern_case -> Case
  : pattern "=>" expr_statement {
    Case::{
      pattern : $1,
      guard_ : None,
      guard_keyword_loc : None,
      body : $3,
      fat_arrow_loc : Some(mk_loc($loc($2))),
    }
  }
  | pattern "if" infix_expr "=>" expr_statement {
    Case::{
      pattern : $1,
      guard_ : Some($3),
      guard_keyword_loc : Some(mk_loc($loc($2))),
      body : $5,
      fat_arrow_loc : Some(mk_loc($loc($4))),
    }
  }
  | "..." {
    Case::{
      pattern : Pattern::Any(loc = mk_loc($sloc)),
      guard_ : None,
      guard_keyword_loc : None,
      body : Hole(loc = mk_loc($sloc), kind = Todo),
      fat_arrow_loc : None,
    }
  }
  ;

single_pattern_cases -> List[Case]
  : list_semis(single_pattern_case) { $1 }
  ;

catch_keyword -> (Bool, Location, Location, Location?, Location)
  : "catch" "{" {
    (
      false,
      mk_loc($sloc),
      mk_loc($loc($1)),
      None,
      mk_loc($loc($2)),
    )
  }
  | "catch" "!" "{" {
    (
      true,
      mk_loc($sloc),
      mk_loc($loc($1)),
      Some(mk_loc($loc($2))),
      mk_loc($loc($3)),
    )
  }
  ;

%inline else_keyword -> (Location, Location, Location)
  : "noraise" "{" { (mk_loc($sloc), mk_loc($loc($1)), mk_loc($loc($2))) }
  ;

try_expr -> Expr
  : "try" pipe_expr catch_keyword single_pattern_cases "}" {
    let (catch_all, catch_loc, catch_keyword_loc, catch_bang_loc, catch_lbrace_loc) = $3
    Try(
      body = $2,
      catch_ = $4,
      catch_all~,
      try_else = None,
      has_try = true,
      try_loc = mk_loc($loc($1)),
      catch_loc~,
      else_loc = @basic.Location::{ start: @basic.Position::{ fname: "", lnum: 0, bol: 0, cnum: 0 }, end: @basic.Position::{ fname: "", lnum: 0, bol: 0, cnum: 0 } },
      loc = mk_loc($sloc),
      try_keyword_loc = Some(mk_loc($loc($1))),
      catch_keyword_loc = Some(catch_keyword_loc),
      catch_bang_loc~,
      catch_lbrace_loc = Some(catch_lbrace_loc),
      catch_rbrace_loc = Some(mk_loc($loc($5))),
      noraise_loc = None,
      else_lbrace_loc = None,
      else_rbrace_loc = None,
    )
  }
  | "try" pipe_expr catch_keyword single_pattern_cases "}" else_keyword single_pattern_cases "}" {
    let (catch_all, catch_loc, catch_keyword_loc, catch_bang_loc, catch_lbrace_loc) = $3
    let (else_loc, noraise_loc, else_lbrace_loc) = $6
    Try(
      body = $2,
      catch_ = $4,
      catch_all~,
      try_else = Some($7),
      has_try = true,
      try_loc = mk_loc($loc($1)),
      catch_loc~,
      else_loc~,
      loc = mk_loc($sloc),
      try_keyword_loc = Some(mk_loc($loc($1))),
      catch_keyword_loc = Some(catch_keyword_loc),
      catch_bang_loc~,
      catch_lbrace_loc = Some(catch_lbrace_loc),
      catch_rbrace_loc = Some(mk_loc($loc($5))),
      noraise_loc = Some(noraise_loc),
      else_lbrace_loc = Some(else_lbrace_loc),
      else_rbrace_loc = Some(mk_loc($loc($8))),
    )
  }
  | "try?" pipe_expr {
    let try_token_loc = mk_loc($loc($1))
    TryOperator(
      body = $2,
      kind = Question,
      try_loc = try_token_loc,
      loc = mk_loc($sloc),
      question_loc = Some(try_token_loc.last_char()),
      bang_loc = None,
    )
  }
  | "try!" pipe_expr {
    let try_token_loc = mk_loc($loc($1))
    TryOperator(
      body = $2,
      kind = Exclamation,
      try_loc = try_token_loc,
      loc = mk_loc($sloc),
      question_loc = None,
      bang_loc = Some(try_token_loc.last_char()),
    )
  }
  ;

if_expr -> Expr
  : "if" infix_expr block_expr_info "else" block_expr_info {
    let (ifso, if_lbrace_loc, if_rbrace_loc, _, _) = $3
    let (ifnot, else_lbrace_loc, else_rbrace_loc, _, _) = $5
    If(
      cond = $2,
      ifso~,
      ifnot = Some(ifnot),
      loc = mk_loc($sloc),
      if_loc = Some(mk_loc($loc($1))),
      else_loc = Some(mk_loc($loc($4))),
      if_lbrace_loc = Some(if_lbrace_loc),
      if_rbrace_loc = Some(if_rbrace_loc),
      else_lbrace_loc = Some(else_lbrace_loc),
      else_rbrace_loc = Some(else_rbrace_loc),
    )
  }
  | "if" infix_expr block_expr_info "else" if_expr {
    let (ifso, if_lbrace_loc, if_rbrace_loc, _, _) = $3
    If(
      cond = $2,
      ifso~,
      ifnot = Some($5),
      loc = mk_loc($sloc),
      if_loc = Some(mk_loc($loc($1))),
      else_loc = Some(mk_loc($loc($4))),
      if_lbrace_loc = Some(if_lbrace_loc),
      if_rbrace_loc = Some(if_rbrace_loc),
      else_lbrace_loc = None,
      else_rbrace_loc = None,
    )
  }
  | "if" infix_expr block_expr_info {
    let (ifso, if_lbrace_loc, if_rbrace_loc, _, _) = $3
    If(
      cond = $2,
      ifso~,
      ifnot = None,
      loc = mk_loc($sloc),
      if_loc = Some(mk_loc($loc($1))),
      else_loc = None,
      if_lbrace_loc = Some(if_lbrace_loc),
      if_rbrace_loc = Some(if_rbrace_loc),
      else_lbrace_loc = None,
      else_rbrace_loc = None,
    )
  }
  ;

match_header -> (Expr, Location, Location)
  : "match" infix_expr "{" { ($2, mk_loc($loc($1)), mk_loc($loc($3))) }
  ;

match_expr -> Expr
  : match_header non_empty_list_semis(single_pattern_case) "}" {
    let (expr, match_keyword_loc, lbrace_loc) = $1
    Match(
      expr~,
      cases = $2,
      match_loc = mk_loc($loc($1)),
      loc = mk_loc($sloc),
      match_keyword_loc = Some(match_keyword_loc),
      lbrace_loc = Some(lbrace_loc),
      rbrace_loc = Some(mk_loc($loc($3))),
    )
  }
  | match_header "}" {
    let (expr, match_keyword_loc, lbrace_loc) = $1
    Match(
      expr~,
      cases = @list.empty(),
      match_loc = mk_loc($loc($1)),
      loc = mk_loc($sloc),
      match_keyword_loc = Some(match_keyword_loc),
      lbrace_loc = Some(lbrace_loc),
      rbrace_loc = Some(mk_loc($loc($2))),
    )
  }
  ;

%inline loop_header -> (Expr, Location, Location)
  : "loop" infix_expr "{" { ($2, mk_loc($loc($1)), mk_loc($loc($3))) }
  ;

lexmatch_expr -> Expr:
  | lexmatch_header list_semis(lex_case) "}" {
    let (expr, strategy, lexmatch_loc, with_loc, lbrace_loc) = $1
    LexMatch(
      strategy~,
      expr~,
      match_loc=mk_loc($loc($1)),
      cases=$2,
      loc=mk_loc($sloc),
      lexmatch_loc=Some(lexmatch_loc),
      with_loc~,
      lbrace_loc=Some(lbrace_loc),
      rbrace_loc=Some(mk_loc($loc($3))),
    )
  }

lexmatch_header -> (Expr, Label?, Location, Location?, Location):
  | "lexmatch" infix_expr "{" {
    ($2, None, mk_loc($loc($1)), None, mk_loc($loc($3)))
  }
  | "lexmatch" infix_expr "with" label "{" {
    ($2, Some($4), mk_loc($loc($1)), Some(mk_loc($loc($3))), mk_loc($loc($5)))
  }

lex_case -> LexCase :
  | lex_pattern "=>" expr_statement {
    LexCase::{
      pat : $1,
      pat_loc : mk_loc($loc($1)),
      guard_ : None,
      guard_keyword_loc : None,
      body : $3,
      fat_arrow_loc : Some(mk_loc($loc($2))),
    }
  }
  | lex_pattern "if" infix_expr "=>" expr_statement {
    LexCase::{
      pat : $1,
      pat_loc : mk_loc($loc($1)),
      guard_ : Some($3),
      guard_keyword_loc : Some(mk_loc($loc($2))),
      body : $5,
      fat_arrow_loc : Some(mk_loc($loc($4))),
    }
  }
  | "..." {
    let pat = @list.singleton(LexTopPattern::Wildcard(loc = mk_loc($sloc)))
    LexCase::{
      pat,
      pat_loc : mk_loc($sloc),
      guard_ : None,
      guard_keyword_loc : None,
      body : Hole(loc=mk_loc($sloc), kind=Todo),
      fat_arrow_loc : None,
    }
  }

lex_pattern -> @list.List[LexTopPattern]:
  | "(" separated_nonempty_list(",", lex_top_pattern) ")" { $2 }
  | "_" { @list.singleton(Wildcard(loc = mk_loc($sloc))) }
  | binder { @list.singleton(Binder($1)) }
  | lex_simple_atom_pattern { @list.singleton(Pattern($1)) }

lex_top_pattern -> LexTopPattern :
  | lex_as_pattern { Pattern($1) }
  | "_" { Wildcard(loc = mk_loc($sloc)) }
  | binder { Binder($1) }

lex_as_pattern -> LexPattern :
  | lex_pattern_sequence {
    match $1 {
      More(pat, tail=Empty) => pat
      _ => Sequence(pats=$1, loc=mk_loc($sloc))
    }
  }
  | lex_atom_pattern "as" binder {
    Alias(pat = $1, binder = $3, loc = mk_loc($sloc))
  }

lex_pattern_sequence -> @list.List[LexPattern] :
  | lex_atom_pattern { @list.singleton($1) }
  | lex_atom_pattern option(SEMI) lex_pattern_sequence { @list.cons($1, $3) }

lex_atom_pattern -> LexPattern:
  | lex_simple_atom_pattern { $1 }
  | "(" lex_as_pattern ")" { $2 }

lex_simple_atom_pattern -> LexPattern:
  | REGEX_LITERAL {
    Regex(lit=$1, offset=3, loc=mk_loc($sloc))
  }
  | REGEX_INTERP {
    RegexInterp(elems=make_interps($1), loc=mk_loc($sloc))
  }
  | STRING {
    Regex(lit = $1, offset = 1, loc = mk_loc($sloc))
  }
  | INTERP {
    RegexInterp(elems = make_interps($1), loc = mk_loc($sloc))
  }

loop_expr -> Expr
  : loop_label_colon loop_header list_semis(single_pattern_case) "}" {
    let (arg, loop_keyword_loc, lbrace_loc) = $2
    Loop(
      arg~,
      body = $3,
      label = $1,
      loop_loc = mk_loc($loc($2)),
      loc = mk_loc($sloc),
      loop_keyword_loc = Some(loop_keyword_loc),
      lbrace_loc = Some(lbrace_loc),
      rbrace_loc = Some(mk_loc($loc($4))),
    )
  }

for_binders -> List[(Binder, Expr)]
  : list_commas_no_trailing(separated_pair(binder, "=", expr)) { $1 }
  ;

for_binders_infix -> List[(Binder, Expr)]
  : list_commas_no_trailing(separated_pair(binder, "=", infix_expr)) { $1 }
  ;

list_comp_for_header -> (List[(Binder, Expr)], Expr?, List[(Binder, Expr)], Location)
  : for_binders_infix {
    ($1, None, @list.empty(), mk_loc($sloc))
  }
  | for_binders_infix SEMI option(infix_expr) {
    ($1, $3, @list.empty(), mk_loc($sloc))
  }
  | for_binders_infix SEMI option(infix_expr) SEMI for_binders_infix {
    ($1, $3, $5, mk_loc($sloc))
  }
  ;

optional_where_clause -> WhereClause?
  : "where" "{" list_commas_info(labeled_expr) "}" {
    let (fields, comma_locs, trailing_comma_loc) = $3
    Some({
      fields,
      loc : mk_loc($sloc),
      where_loc : Some(mk_loc($loc($1))),
      lbrace_loc : Some(mk_loc($loc($2))),
      rbrace_loc : Some(mk_loc($loc($4))),
      comma_locs,
      trailing_comma_loc,
    })
  }
  | { None }

for_expr -> Expr
  : loop_label_colon "for" for_binders SEMI option(infix_expr) SEMI list_commas_no_trailing(separated_pair(binder, "=", expr)) block_expr_info optional_nobreak_info optional_where_clause {
    let (body, body_lbrace_loc, body_rbrace_loc, _, _) = $8
    let (for_else, nobreak_loc, nobreak_lbrace_loc, nobreak_rbrace_loc) = $9
    For(
      binders = $3,
      condition = $5,
      continue_block = $7,
      body~,
      for_else~,
      label = $1,
      loc = mk_loc($sloc),
      where_clause = $10,
      for_loc = Some(mk_loc($loc($2))),
      body_lbrace_loc = Some(body_lbrace_loc),
      body_rbrace_loc = Some(body_rbrace_loc),
      nobreak_loc~,
      nobreak_lbrace_loc~,
      nobreak_rbrace_loc~,
      header_semi_locs = @list.from_array([mk_loc($loc($4)), mk_loc($loc($6))]),
    )
  }
  | loop_label_colon "for" for_binders block_expr_info optional_nobreak_info optional_where_clause {
    let (body, body_lbrace_loc, body_rbrace_loc, _, _) = $4
    let (for_else, nobreak_loc, nobreak_lbrace_loc, nobreak_rbrace_loc) = $5
    For(
      binders = $3,
      condition = None,
      continue_block = @list.empty(),
      body~,
      for_else~,
      label = $1,
      loc = mk_loc($sloc),
      where_clause = $6,
      for_loc = Some(mk_loc($loc($2))),
      body_lbrace_loc = Some(body_lbrace_loc),
      body_rbrace_loc = Some(body_rbrace_loc),
      nobreak_loc~,
      nobreak_lbrace_loc~,
      nobreak_rbrace_loc~,
      header_semi_locs = @list.empty(),
    )
  }
  ;

foreach_expr -> Expr
  : loop_label_colon "for" non_empty_list_commas_info(foreach_binder) "in" expr foreach_optional_loop_vars block_expr_info optional_nobreak_info optional_where_clause {
    let (binders, comma_locs, _) = $3
    let (init, continue_block) = $6
    let (body, body_lbrace_loc, body_rbrace_loc, _, _) = $7
    let (else_block, nobreak_loc, nobreak_lbrace_loc, nobreak_rbrace_loc) = $8
    ForEach(
      binders~,
      expr = $5,
      init~,
      continue_block~,
      body~,
      else_block~,
      where_clause = $9,
      label = $1,
      loc = mk_loc($sloc),
      for_loc = Some(mk_loc($loc($2))),
      in_loc = Some(mk_loc($loc($4))),
      body_lbrace_loc = Some(body_lbrace_loc),
      body_rbrace_loc = Some(body_rbrace_loc),
      nobreak_loc~,
      nobreak_lbrace_loc~,
      nobreak_rbrace_loc~,
      comma_locs~,
    )
  }
  ;

foreach_optional_loop_vars -> (List[(Binder, Expr)], List[(Binder, Expr)])
  : { (@list.empty(), @list.empty()) }
  | SEMI for_binders { ($2, @list.empty()) }
  | SEMI for_binders SEMI for_binders { ($2, $4) }
  ;

foreach_optional_loop_vars_infix -> (List[(Binder, Expr)], List[(Binder, Expr)])
  : { (@list.empty(), @list.empty()) }
  | SEMI for_binders_infix { ($2, @list.empty()) }
  | SEMI for_binders_infix SEMI for_binders_infix { ($2, $4) }
  ;

foreach_binder -> Binder?
  : binder { Some($1)}
  | "_" { None }
  ;

expr -> Expr
  : loop_expr { $1 }
  | for_expr { $1 }
  | foreach_expr { $1 }
  | while_expr { $1 }
  | try_expr { $1 }
  | if_expr { $1 }
  | match_expr { $1 }
  | lexmatch_expr { $1 }
  | simple_try_expr { $1 }
  | quantifier_expr { $1 }
  | arrow_fn_expr { Function(func = $1, loc = mk_loc($sloc)) }
  ;

simple_try_expr -> Expr
  : pipe_expr catch_keyword single_pattern_cases "}" {
    let (catch_all, catch_loc, catch_keyword_loc, catch_bang_loc, catch_lbrace_loc) = $2
    Try(
      body = $1,
      catch_ = $3,
      catch_all~,
      try_else = None,
      has_try = false,
      try_loc = mk_loc($loc($1)),
      catch_loc~,
      else_loc = Location::{ start: Position::{ fname: "", lnum: 0, bol: 0, cnum: 0 }, end: Position::{ fname: "", lnum: 0, bol: 0, cnum: 0 } },
      loc = mk_loc($sloc),
      try_keyword_loc = None,
      catch_keyword_loc = Some(catch_keyword_loc),
      catch_bang_loc~,
      catch_lbrace_loc = Some(catch_lbrace_loc),
      catch_rbrace_loc = Some(mk_loc($loc($4))),
      noraise_loc = None,
      else_lbrace_loc = None,
      else_rbrace_loc = None,
    )
  }
  | pipe_expr catch_keyword single_pattern_cases "}" else_keyword single_pattern_cases "}" {
    let (catch_all, catch_loc, catch_keyword_loc, catch_bang_loc, catch_lbrace_loc) = $2
    let (else_loc, noraise_loc, else_lbrace_loc) = $5
    Try(
      body = $1,
      catch_ = $3,
      catch_all~,
      try_else = Some($6),
      has_try = false,
      try_loc = mk_loc($loc($1)),
      catch_loc~,
      else_loc~,
      loc = mk_loc($sloc),
      try_keyword_loc = None,
      catch_keyword_loc = Some(catch_keyword_loc),
      catch_bang_loc~,
      catch_lbrace_loc = Some(catch_lbrace_loc),
      catch_rbrace_loc = Some(mk_loc($loc($4))),
      noraise_loc = Some(noraise_loc),
      else_lbrace_loc = Some(else_lbrace_loc),
      else_rbrace_loc = Some(mk_loc($loc($7))),
    )
  }
  | pipe_expr { $1 }
  ;

arrow_fn_with_explicit_braces -> Func
  : "(" arrow_fn_prefix "=>" "{" list_semis_rev(statement) "}" {
    let body = Statement::compact_rev($5, loc = mk_loc($loc($4)).merge(mk_loc($loc($6))))
    make_arrow_fn($2, body, params_loc = mk_loc($loc($1)).merge(mk_loc($loc($2))), loc = mk_loc($sloc))
  }
  | "(" ")" "=>" "{" list_semis_rev(statement) "}" {
    let body = Statement::compact_rev($5, loc = mk_loc($loc($4)).merge(mk_loc($loc($6))))
    make_arrow_fn(@list.empty(), body, params_loc = mk_loc($loc($1)).merge(mk_loc($loc($2))),loc = mk_loc($sloc))
  }
  | binder "=>" "{" list_semis_rev(statement) "}" {
    let body = Statement::compact_rev($4, loc = mk_loc($loc($3)).merge(mk_loc($loc($5))))
    make_arrow_fn(@list.singleton((Named($1), None)), body, params_loc = mk_loc($loc($1)), loc = mk_loc($sloc))
  }
  | "_" "=>" "{" list_semis_rev(statement) "}" {
    let body = Statement::compact_rev($4, loc = mk_loc($loc($3)).merge(mk_loc($loc($5))))
    make_arrow_fn(@list.singleton((Unnamed(mk_loc($loc($1))), None)), body, params_loc = mk_loc($loc($1)), loc = mk_loc($sloc))
  }
  ;

arrow_fn_expr -> Func
  : "(" arrow_fn_prefix "=>" expr_statement_no_break_continue_return {
    make_arrow_fn($2, $4, params_loc = mk_loc($loc($1)).merge(mk_loc($loc($2))), loc = mk_loc($sloc))
  }
  | "(" ")" "=>" expr_statement_no_break_continue_return {
    make_arrow_fn(@list.empty(), $4, params_loc = mk_loc($loc($1)).merge(mk_loc($loc($2))),loc = mk_loc($sloc))
  }
  | binder "=>" expr_statement_no_break_continue_return {
    make_arrow_fn(@list.singleton((Named($1), None)), $3, params_loc = mk_loc($loc($1)), loc = mk_loc($sloc))
  }
  | "_" "=>" expr_statement_no_break_continue_return {
    make_arrow_fn(@list.singleton((Unnamed(mk_loc($loc($1))), None)), $3, params_loc = mk_loc($loc($1)), loc = mk_loc($sloc))
  }
  ;

arrow_fn_prefix -> List[(ArrowFnParam, Type?)]
  : binder ioption(",") ")" { @list.singleton((Named($1), None)) }
  | "_" ioption(",") ")" { @list.singleton((Unnamed(mk_loc($loc($1))), None)) }
  | binder ":" type_ ioption(",") ")" { @list.singleton((Named($1), Some($3))) }
  | "_" ":" type_ ioption(",") ")" { @list.singleton((Unnamed(mk_loc($loc($1))), Some($3))) }
  | binder "," arrow_fn_prefix { $3.add((Named($1), None)) }
  | "_" "," arrow_fn_prefix { $3.add((Unnamed(mk_loc($loc($1))), None)) }
  | binder ":" type_ "," arrow_fn_prefix { $5.add((Named($1), Some($3))) }
  | "_" ":" type_ "," arrow_fn_prefix { $5.add((Unnamed(mk_loc($loc($1))), Some($3))) }
  ;

arrow_fn_prefix_no_constraint -> (List[ArrowFnParam], List[Location], Location?, Location)
  : binder ")" {
      (
        @list.singleton(Named($1)),
        @list.empty(),
        None,
        mk_loc($loc($2)),
      )
    }
  | binder "," ")" {
      (
        @list.singleton(Named($1)),
        @list.empty(),
        Some(mk_loc($loc($2))),
        mk_loc($loc($3)),
      )
    }
  | "_" ")" {
      (
        @list.singleton(Unnamed(mk_loc($loc($1)))),
        @list.empty(),
        None,
        mk_loc($loc($2)),
      )
    }
  | "_" "," ")" {
      (
        @list.singleton(Unnamed(mk_loc($loc($1)))),
        @list.empty(),
        Some(mk_loc($loc($2))),
        mk_loc($loc($3)),
      )
    }
  | binder "," arrow_fn_prefix_no_constraint {
      let (params, comma_locs, trailing_comma_loc, rparen_loc) = $3
      (
        params.add(Named($1)),
        comma_locs.add(mk_loc($loc($2))),
        trailing_comma_loc,
        rparen_loc,
      )
    }
  | "_" "," arrow_fn_prefix_no_constraint {
      let (params, comma_locs, trailing_comma_loc, rparen_loc) = $3
      (
        params.add(Unnamed(mk_loc($loc($1)))),
        comma_locs.add(mk_loc($loc($2))),
        trailing_comma_loc,
        rparen_loc,
      )
    }
  ;

backward_pipeline_rhs -> Expr
  : arrow_fn_with_explicit_braces { Function(func = $1, loc = mk_loc($sloc)) }
  | infix_expr { $1 }
  ;

pipe_expr -> Expr
  : pipe_expr "<|" backward_pipeline_rhs {
    RevPipe(lhs = $1, rhs = $3, loc = mk_loc($sloc))
  }
  | pipe_expr "|>" infix_expr {
    Pipe(lhs = $1, rhs = $3, loc = mk_loc($sloc))
  }
  | pipe_expr "|>" binder "=>" block_expr {
    let params_loc = mk_loc($loc($3))
    let fn_loc = mk_loc($loc($3)).merge(mk_loc($loc($5)))
    let func = make_arrow_fn(@list.singleton((Named($3), None)), $5, params_loc~, loc = fn_loc)
    let rhs = Expr::Function(func~, loc = fn_loc)
    Pipe(lhs = $1, rhs~, loc = mk_loc($sloc))
  }
  | infix_expr { $1 }
  ;

quantifier_expr -> Expr
  : "∀" binder ":" type_ "," quantifier_body_expr {
    Quantifier(kind = Forall, binder = $2, binder_ty = $4, body = $6, loc = mk_loc($sloc))
  }
  | "∃" binder ":" type_ "," quantifier_body_expr {
    Quantifier(kind = Exists, binder = $2, binder_ty = $4, body = $6, loc = mk_loc($sloc))
  }
  ;

quantifier_body_expr -> Expr
  : quantifier_expr { $1 }
  | infix_expr { $1 }
  ;

infix_expr -> Expr
  : infix_expr "→" infix_expr {
    Implies(lhs = $1, rhs = $3, loc = mk_loc($sloc))
  }
  | infix_expr infixop infix_expr {
    Infix(op = $2, lhs = $1, rhs = $3, loc = mk_loc($sloc))
  }
  | postfix_expr { $1 }
  ;

postfix_expr -> Expr
  : range_expr "as" type_name {
    As(expr = $1, trait_ = $3, loc = mk_loc($sloc))
  }
  | range_expr "is" range_pattern {
    Is(expr = $1, pat = $3, loc = mk_loc($sloc), is_loc = Some(mk_loc($loc($2))))
  }
  | range_expr "lexmatch?" lex_pattern %prec prec_LEXMATCH_QUESTION {
    let lexmatch_question_loc = mk_loc($loc($2))
    IsLexMatch(
      expr=$1,
      pat=$3,
      pat_loc=mk_loc($loc($3)),
      strategy = None,
      loc=mk_loc($sloc),
      lexmatch_loc=Some(lexmatch_question_loc.trim_last_char()),
      question_loc=Some(lexmatch_question_loc.last_char()),
      with_loc=None,
    )
  }
  | range_expr "lexmatch?" lex_pattern "with" label {
    let lexmatch_question_loc = mk_loc($loc($2))
    IsLexMatch(
      expr=$1,
      pat=$3,
      pat_loc=mk_loc($loc($3)),
      strategy = Some($5),
      loc=mk_loc($sloc),
      lexmatch_loc=Some(lexmatch_question_loc.trim_last_char()),
      question_loc=Some(lexmatch_question_loc.last_char()),
      with_loc=Some(mk_loc($loc($4))),
    )
  }
  | range_expr "=~" regex_match_rhs {
    let (pat, bindings) = $3
    RegexMatch(expr = $1, pat~, bindings~, loc = mk_loc($sloc))
  }
  | range_expr { $1 }
  ;

regex_match_rhs -> (RegexPattern, List[(Label, Binder?)])
  : regex_atom_pattern { ($1, @list.empty()) }
  | "(" regex_as_pattern "," list_commas(regex_match_binding) ")" { ($2, $4) }
  ;

regex_match_binding -> (Label, Binder?)
  : LIDENT "=" binder {
    let label = Label::{ name : $1, loc : mk_loc($loc($1)) }
    (label, Some($3))
  }
  | POST_LABEL {
    let label = Label::{ name : $1, loc : mk_loc($loc($1)) }
    (label, None)
  }
  ;

regex_as_pattern -> RegexPattern
  : regex_or_pattern { $1 }
  | regex_atom_pattern "as" binder {
    RegexPattern::Alias(pat = $1, binder = $3, loc = mk_loc($sloc))
  }
  ;

regex_or_pattern -> RegexPattern
  : regex_sequence_pattern { $1 }
  | regex_or_pattern "|" regex_sequence_pattern {
    RegexPattern::Alternation(pat1 = $1, pat2 = $3, loc = mk_loc($sloc))
  }
  ;

regex_sequence_pattern -> RegexPattern
  : regex_atom_pattern { $1 }
  | regex_sequence_pattern "+" regex_atom_pattern {
    RegexPattern::Sequence(pat1 = $1, pat2 = $3, loc = mk_loc($sloc))
  }
  ;

regex_atom_pattern -> RegexPattern
  : REGEX_LITERAL {
    RegexPattern::Literal(lit = $1, loc = mk_loc($loc($1)))
  }
  | qual_uident {
    RegexPattern::Reference(lid = $1, loc = mk_loc($sloc))
  }
  | "(" regex_as_pattern ")" { $2 }
  ;

range_expr -> Expr
  : prefix_expr "..<" prefix_expr {
    Infix(
      op = Var::{ name: Ident(name = "..<"), loc: mk_loc($loc($2)) },
      lhs = $1,
      rhs = $3,
      loc = mk_loc($sloc)
    )
  }
  | prefix_expr "..=" prefix_expr {
    Infix(
      op = Var::{ name: Ident(name = "..="), loc: mk_loc($loc($2)) },
      lhs = $1,
      rhs = $3,
      loc = mk_loc($sloc)
    )
  }
  | prefix_expr "..<=" prefix_expr {
    Infix(
      op = Var::{ name: Ident(name = "..<="), loc: mk_loc($loc($2)) },
      lhs = $1,
      rhs = $3,
      loc = mk_loc($sloc)
    )
  }
  | prefix_expr ">=.." prefix_expr {
    Infix(
      op = Var::{ name: Ident(name = ">=.."), loc: mk_loc($loc($2)) },
      lhs = $1,
      rhs = $3,
      loc = mk_loc($sloc)
    )
  }
  | prefix_expr ">.." prefix_expr {
    Infix(
      op = Var::{ name: Ident(name = ">.."), loc: mk_loc($loc($2)) },
      lhs = $1,
      rhs = $3,
      loc = mk_loc($sloc)
    )
  }
  | prefix_expr { $1 }
  ;

prefix_expr -> Expr
  : id(plus) prefix_expr { make_uplus(loc = mk_loc($sloc), $1, $2, op_loc = Some(mk_loc($loc($1)))) }
  | id(minus) prefix_expr {
    make_uminus(loc = mk_loc($sloc), $1, $2, op_loc = Some(mk_loc($loc($1))))
  }
  | "!" prefix_expr { make_unot(loc = mk_loc($sloc), $2) }
  | simple_expr { $1 }
  ;

%inline plus -> String
  : PLUS { "+" }
  ;

%inline minus -> String
  : MINUS { "-" }
  ;

left_value -> LeftValue
  : var { Var($1) }
  | simple_expr accessor { Field($1, $2) }
  | simple_expr "[" expr "]" { Array($1, $3) }
  ;

constr -> Constructor
  : UIDENT {
    Constructor::{
      name: ConstrName::{ name: $1, loc: mk_loc($loc($1)) },
      extra_info: NoExtraInfo,
      loc: mk_loc($sloc)
    }
  }
  | PACKAGE_NAME DOT_UIDENT {
    Constructor::{
      name: ConstrName::{ name: $2, loc: mk_loc($loc($2)) },
      extra_info: Package($1),
      loc: mk_loc($sloc)
    }
  }
  | type_name "::" UIDENT {
    Constructor::{
      name: ConstrName::{ name: $3, loc: mk_loc($loc($3)) },
      extra_info: TypeName($1),
      loc: mk_loc($sloc)
    }
  }
  ;

%inline apply_attr_info -> (ApplyAttr, Location?, Location?)
  :  { (NoAttr, None, None) }
  | "!" { (Exclamation, Some(mk_loc($loc($1))), None) }
  | "?" { (Question, None, Some(mk_loc($loc($1)))) }
  ;

non_empty_tuple_elems -> (List[Expr], List[Location], Location?, Location)
  : expr ")" {
      (
        @list.singleton($1),
        @list.empty(),
        None,
        mk_loc($loc($2)),
      )
    }
  | expr "," ")" {
      (
        @list.singleton($1),
        @list.empty(),
        Some(mk_loc($loc($2))),
        mk_loc($loc($3)),
      )
    }
  | expr "," non_empty_tuple_elems {
      let (exprs, comma_locs, trailing_comma_loc, rparen_loc) = $3
      (
        exprs.add($1),
        comma_locs.add(mk_loc($loc($2))),
        trailing_comma_loc,
        rparen_loc,
      )
    }
  ;

non_empty_tuple_elems_with_prefix -> (List[Expr], List[Location], Location?, Location)
  : binder "," non_empty_tuple_elems_with_prefix {
      let (exprs, comma_locs, trailing_comma_loc, rparen_loc) = $3
      (
        exprs.add(@syntax.binder_to_expr($1)),
        comma_locs.add(mk_loc($loc($2))),
        trailing_comma_loc,
        rparen_loc,
      )
    }
  | "_" "," non_empty_tuple_elems_with_prefix {
      let (exprs, comma_locs, trailing_comma_loc, rparen_loc) = $3
      (
        exprs.add(Expr::Hole(loc = mk_loc($loc($1)), kind = Incomplete)),
        comma_locs.add(mk_loc($loc($2))),
        trailing_comma_loc,
        rparen_loc,
      )
    }
  | non_empty_tuple_elems { $1 }
  ;

tuple_expr -> Expr
  : "(" arrow_fn_prefix_no_constraint {
    let (params, comma_locs, trailing_comma_loc, rparen_loc) = $2
    let es = params.map(@syntax.arrow_fn_param_to_expr)
    match es {
      @list.More(expr, tail=Empty) => {
        match expr {
          Constraint(..) => expr
          _ =>
            Group(
              expr~,
              group = Paren,
              loc = mk_loc($sloc),
              lparen_loc = Some(mk_loc($loc($1))),
              rparen_loc = Some(rparen_loc),
              lbrace_loc = None,
              rbrace_loc = None,
            )
        }
      }
      _ =>
        @syntax.make_tuple_expr(
          loc = mk_loc($sloc),
          es,
          lparen_loc = Some(mk_loc($loc($1))),
          rparen_loc = Some(rparen_loc),
          comma_locs~,
          trailing_comma_loc~,
        )
    }
  }
  | "(" non_empty_tuple_elems_with_prefix {
    let (exprs, comma_locs, trailing_comma_loc, rparen_loc) = $2
    match exprs {
      More(expr, tail=Empty) =>
        Group(
          expr~,
          group = Paren,
          loc = mk_loc($sloc),
          lparen_loc = Some(mk_loc($loc($1))),
          rparen_loc = Some(rparen_loc),
          lbrace_loc = None,
          rbrace_loc = None,
        )
      exprs =>
        @syntax.make_tuple_expr(
          loc = mk_loc($sloc),
          exprs,
          lparen_loc = Some(mk_loc($loc($1))),
          rparen_loc = Some(rparen_loc),
          comma_locs~,
          trailing_comma_loc~,
        )
    }
  }
  | "(" binder ":" type_ ")" { Constraint(expr = @syntax.binder_to_expr($2), ty = $4, loc = mk_loc($sloc)) }
  | "(" "_" ":" type_ ")" { Constraint(expr = Hole(loc = mk_loc($loc($2)), kind = Incomplete), ty = $4, loc = mk_loc($sloc)) }
  | "(" expr ":" type_ ")" { Constraint(expr = $2, ty = $4, loc = mk_loc($sloc)) }
  | "(" ")" { Unit(loc = mk_loc($sloc), faked = false) }
  ;

anony_fn -> Func
  : is_async "fn" optional_bang parameters func_return_type block_expr_info {
    let (return_type, error_type) = $5
    let (body, body_lbrace_loc, body_rbrace_loc, body_semi_locs, body_trailing_semi_loc) = $6
    Func::{
      parameters : $4,
      params_loc : mk_loc($loc($4)),
      body,
      return_type,
      error_type,
      kind : Lambda,
      has_error : $3,
      is_async : $1,
      loc : mk_loc($sloc),
      fn_loc : Some(mk_loc($loc($2))),
      body_lbrace_loc : Some(body_lbrace_loc),
      body_rbrace_loc : Some(body_rbrace_loc),
      body_semi_locs,
      body_trailing_semi_loc,
    }
  }
  ;

simple_expr -> Expr
  : "{" record_defn "}" {
    let (fs, trailing, comma_locs, trailing_comma_loc) = $2
    @syntax.make_record_expr(
      loc = mk_loc($sloc),
      trailing~,
      None,
      fs,
      lbrace_loc = Some(mk_loc($loc($1))),
      rbrace_loc = Some(mk_loc($loc($3))),
      comma_locs~,
      trailing_comma_loc~,
    )
  }
  | type_name COLONCOLON "{" "}" {
    @syntax.make_record_expr(
      loc = mk_loc($sloc),
      trailing = TrailingMark::None,
      Some($1),
      @list.empty(),
      lbrace_loc = Some(mk_loc($loc($3))),
      rbrace_loc = Some(mk_loc($loc($4))),
    )
  }
  | type_name COLONCOLON "{" record_defn "}" {
    let (fs, trailing_mark, comma_locs, trailing_comma_loc) = $4
    @syntax.make_record_expr(
      loc = mk_loc($sloc),
      trailing = trailing_mark,
      Some($1),
      fs,
      lbrace_loc = Some(mk_loc($loc($3))),
      rbrace_loc = Some(mk_loc($loc($5))),
      comma_locs~,
      trailing_comma_loc~,
    )
  }
  | ioption(terminated(type_name, COLONCOLON)) "{" ".." expr "}" {
    RecordUpdate(
      type_name = $1,
      record = $4,
      fields = @list.empty(),
      loc = mk_loc($sloc),
      lbrace_loc = Some(mk_loc($loc($2))),
      rbrace_loc = Some(mk_loc($loc($5))),
      comma_locs = @list.empty(),
      trailing_comma_loc = None,
      dotdot_loc = Some(mk_loc($loc($3))),
    )
  }
  | ioption(terminated(type_name, COLONCOLON)) "{" ".." expr "," list_commas_info(record_defn_single) "}" {
    let (fields, comma_locs, trailing_comma_loc) = $6
    RecordUpdate(
      type_name = $1,
      record = $4,
      fields~,
      loc = mk_loc($sloc),
      lbrace_loc = Some(mk_loc($loc($2))),
      rbrace_loc = Some(mk_loc($loc($7))),
      comma_locs = comma_locs.add(mk_loc($loc($5))),
      trailing_comma_loc~,
      dotdot_loc = Some(mk_loc($loc($3))),
    )
  }
  | "{" semi_expr_semi_opt "}" {
    let (expr, trailing_semi_loc) = $2
    match expr {
      Ident(id = { name: Ident(name~), loc }, ..) => {
        let label = Label::{ name, loc }
        let field = @syntax.make_field_def(loc = mk_loc($sloc), label, expr, true)
        let trailing_mark = if trailing_semi_loc is Some(_) {
          TrailingMark::Semi
        } else {
          TrailingMark::None
        }
        @syntax.make_record_expr(
          loc = mk_loc($sloc),
          trailing = trailing_mark,
          None,
          @list.singleton(field),
          lbrace_loc = Some(mk_loc($loc($1))),
          rbrace_loc = Some(mk_loc($loc($3))),
        )
      }
      Sequence(
        exprs = More(
          Ident(id = { name: Ident(name~), loc }, ..),
          tail = Empty,
        ),
        last_expr = Unit(..),
        ..
      ) if trailing_semi_loc is Some(_) => {
        let label = Label::{ name, loc }
        let ident = @syntax.make_ident_expr(
          loc~,
          Var::{ name: Ident(name = name), loc },
        )
        let field = @syntax.make_field_def(loc = mk_loc($sloc), label, ident, true)
        @syntax.make_record_expr(
          loc = mk_loc($sloc),
          trailing = TrailingMark::Semi,
          None,
          @list.singleton(field),
          lbrace_loc = Some(mk_loc($loc($1))),
          rbrace_loc = Some(mk_loc($loc($3))),
        )
      }
      _ =>
        Group(
          expr~,
          group = Brace,
          loc = mk_loc($sloc),
          lparen_loc = None,
          rparen_loc = None,
          lbrace_loc = Some(mk_loc($loc($1))),
          rbrace_loc = Some(mk_loc($loc($3))),
        )
    }
  }
  | "{" list_commas_info(map_expr_elem) "}" {
    let (elems, comma_locs, trailing_comma_loc) = $2
    Map(
      elems~,
      loc = mk_loc($sloc),
      lbrace_loc = Some(mk_loc($loc($1))),
      rbrace_loc = Some(mk_loc($loc($3))),
      comma_locs~,
      trailing_comma_loc~,
    )
  }
  | anony_fn { Function(func = $1, loc = mk_loc($sloc)) }
  | atomic_expr { $1 }
  | "_" %prec prec_lower_than_arrow_fn { Hole(loc = mk_loc($sloc), kind = Incomplete) }
  | qual_ident_simple_expr { @syntax.make_ident_expr(loc = mk_loc($sloc), Var::{ name: $1, loc: mk_loc($sloc) }) }
  | constr { Constr(constr = $1, loc = mk_loc($sloc)) }
  | LIDENT "?" "(" list_commas_info(argument) ")" {
    let (args, comma_locs, trailing_comma_loc) = $4
    let func = @syntax.make_ident_expr(
      loc = mk_loc($loc($1)),
      Var::{ name: Ident(name = $1), loc: mk_loc($loc($1)) }
    )
    Apply(
      func~,
      args~,
      attr = Question,
      loc = mk_loc($sloc),
      bang_loc = None,
      question_loc = Some(mk_loc($loc($2))),
      lparen_loc = Some(mk_loc($loc($3))),
      rparen_loc = Some(mk_loc($loc($5))),
      comma_locs~,
      trailing_comma_loc~,
    )
  }
  | simple_expr apply_attr_info "(" list_commas_info(argument) ")" {
    let (attr, bang_loc, question_loc) = $2
    let (args, comma_locs, trailing_comma_loc) = $4
    Apply(
      func = $1,
      args~,
      attr~,
      loc = mk_loc($sloc),
      bang_loc~,
      question_loc~,
      lparen_loc = Some(mk_loc($loc($3))),
      rparen_loc = Some(mk_loc($loc($5))),
      comma_locs~,
      trailing_comma_loc~,
    )
  }
  | simple_expr "[" expr "]" {
    ArrayGet(array = $1, index = $3, loc = mk_loc($sloc))
  }
  | simple_expr "[" option(expr) ":" option(expr) "]" {
    ArrayGetSlice(
      array = $1,
      start_index = $3,
      end_index = $5,
      index_loc = mk_loc(($loc($2).0, $loc($6).1)),
      loc = mk_loc($sloc)
    )
  }
  | simple_expr DOT_LIDENT apply_attr_info "(" list_commas_info(argument) ")" {
    let (attr, bang_loc, question_loc) = $3
    let (args, comma_locs, trailing_comma_loc) = $5
    let method_name = Label::{ name: $2, loc: mk_loc($loc($2)).trim_first_char() }
    DotApply(
      self = $1,
      method_name~,
      args~,
      return_self = false,
      attr~,
      loc = mk_loc($sloc),
      bang_loc~,
      question_loc~,
      lparen_loc = Some(mk_loc($loc($4))),
      rparen_loc = Some(mk_loc($loc($6))),
      comma_locs~,
      trailing_comma_loc~,
    )
  }
  | simple_expr ".." LIDENT apply_attr_info "(" list_commas_info(argument) ")" {
    let (attr, bang_loc, question_loc) = $4
    let (args, comma_locs, trailing_comma_loc) = $6
    let method_name = Label::{ name: $3, loc: mk_loc($loc($3)) }
    DotApply(
      self = $1,
      method_name~,
      args~,
      return_self = true,
      attr~,
      loc = mk_loc($sloc),
      bang_loc~,
      question_loc~,
      lparen_loc = Some(mk_loc($loc($5))),
      rparen_loc = Some(mk_loc($loc($7))),
      comma_locs~,
      trailing_comma_loc~,
    )
  }
  | simple_expr accessor %prec prec_field {
    Field(record = $1, accessor = $2, loc = mk_loc($sloc))
  }
  | type_name "::" LIDENT {
    let method_name = Label::{ name: $3, loc: mk_loc($loc($3)) }
    Method(
      type_name = $1,
      method_name~,
      loc = mk_loc($sloc),
      coloncolon_loc = Some(mk_loc($loc($2))),
    )
  }
  | "[" list_commas_info(spreadable_elem) "]" {
    let (elems, comma_locs, trailing_comma_loc) = $2
    @syntax.make_array_expr(
      loc = mk_loc($sloc),
      elems,
      lbracket_loc = Some(mk_loc($loc($1))),
      rbracket_loc = Some(mk_loc($loc($3))),
      comma_locs~,
      trailing_comma_loc~,
    )
  }
  | "[" "for" non_empty_list_commas(foreach_binder) "in" infix_expr foreach_optional_loop_vars_infix option(preceded("if", infix_expr)) "=>" expr "]" {
    let (init, continue_block) = $6
    ListComprehension(
      kind = Foreach(binders = $3, expr = $5, init~, continue_block~),
      guard_ = $7,
      body = $9,
      loc = mk_loc($sloc)
    )
  }
  | "[" "for" list_comp_for_header option(preceded("if", infix_expr)) "=>" expr "]" {
    let (binders, condition, continue_block, for_loc) = $3
    ListComprehension(
      kind = For(binders~, condition~, continue_block~, for_loc~),
      guard_ = $4,
      body = $6,
      loc = mk_loc($sloc)
    )
  }
  | tuple_expr { $1 }
  ;

%inline label -> Label
  : LIDENT { Label::{ name: $1, loc: mk_loc($sloc) } }
  ;

%inline accessor -> Accessor
  : DOT_LIDENT {
    if $1 == "_" {
      Newtype(loc = mk_loc($loc($1)))
    } else {
      Label(Label::{ name: $1, loc: mk_loc($sloc).trim_first_char() })
    }
  }
  | DOT_INT { Index(tuple_index = $1, loc = mk_loc($sloc)) }
  ;

%inline binder -> Binder
  : LIDENT { Binder::{ name: $1, loc: mk_loc($sloc) } }
  ;

tvar_binder -> TypeVarBinder
  : UIDENT {
    TypeVarBinder::{
      name: $1,
      constraints: @list.empty(),
      name_loc: mk_loc($loc($1)),
      colon_loc: None,
      plus_locs: @list.empty(),
    }
  }
  | UIDENT COLON tvar_constraints_info {
    let (constraints, plus_locs) = $3
    TypeVarBinder::{
      name: $1,
      constraints: constraints,
      name_loc: mk_loc($loc($1)),
      colon_loc: Some(mk_loc($loc($2))),
      plus_locs: plus_locs,
    }
  }
  ;

tvar_constraints_info -> (List[TypeVarConstraint], List[Location])
  : tvar_constraint {
      (@list.singleton($1), @list.empty())
    }
  | tvar_constraint PLUS tvar_constraints_info {
      let (constraints, plus_locs) = $3
      (
        constraints.add($1),
        plus_locs.add(mk_loc($loc($2))),
      )
    }
  ;

type_decl_binder -> TypeDeclBinder
  : UIDENT { TypeDeclBinder::{ name: Some($1), loc: mk_loc($sloc) } }
  | "_" { TypeDeclBinder::{ name: None, loc: mk_loc($sloc) } }
  ;

tvar_constraint -> TypeVarConstraint
  : qual_ident_ty { TypeVarConstraint::{ trait_: $1, loc: mk_loc($sloc) } }
  ;

%inline var -> Var
  : qual_ident { Var::{ name: $1, loc: mk_loc($sloc) } }
  ;

type_name -> TypeName
  : qual_ident_ty { TypeName::{ name: $1, is_object: false, loc: mk_loc($sloc) } }
  | "&" qual_ident_ty { TypeName::{ name: $2, is_object: true, loc: mk_loc($sloc) } }
  ;

multiline_string -> MultilineStringElem
  : MULTILINE_STRING { String($1) }
  | MULTILINE_INTERP {
    Interp(make_interps($1))
  }
  ;

atomic_expr -> Expr
  : simple_constant { make_constant_expr(loc = mk_loc($sloc), $1) }
  | non_empty_list(multiline_string) {
    MultilineString(elems = $1, loc = mk_loc($sloc))
  }
  | INTERP { make_interp_expr(loc = mk_loc($sloc), $1) }
  ;

simple_constant -> Constant
  : TRUE { Bool(true) }
  | FALSE { Bool(false) }
  | BYTE { Byte($1) }
  | BYTES { Bytes($1) }
  | CHAR { Char($1) }
  | INT { make_int($1) }
  | DOUBLE { make_double($1) }
  | FLOAT { make_float($1) }
  | STRING { String($1) }
  | REGEX_LITERAL { Regex($1) }
  ;

map_syntax_key -> Constant
  : simple_constant { $1 }
  | MINUS INT { make_int("-" + $2) }
  | MINUS DOUBLE { make_double("-" + $2) }
  | MINUS FLOAT { make_float("-" + $2) }
  ;

%inline loced_string -> (StringLiteral, Location)
  : STRING { ($1, mk_loc($sloc)) }
  ;

%inline assignop -> Var
  : "+=" { Var::{ name: Ident(name = "+"), loc: mk_loc($sloc) } }
  | AUGMENTED_ASSIGNMENT { Var::{ name: Ident(name = $1), loc: mk_loc($sloc) } }
  ;

%inline infixop -> Var
  : INFIX4 { Var::{ name: Ident(name = $1), loc: mk_loc($sloc) } }
  | INFIX3 { Var::{ name: Ident(name = $1), loc: mk_loc($sloc) } }
  | INFIX2 { Var::{ name: Ident(name = $1), loc: mk_loc($sloc) } }
  | INFIX1 { Var::{ name: Ident(name = $1), loc: mk_loc($sloc) } }
  | PLUS { Var::{ name: Ident(name = "+"), loc: mk_loc($sloc) } }
  | MINUS { Var::{ name: Ident(name = "-"), loc: mk_loc($sloc) } }
  | AMPER { Var::{ name: Ident(name = "&"), loc: mk_loc($sloc) } }
  | CARET { Var::{ name: Ident(name = "^"), loc: mk_loc($sloc) } }
  | BAR { Var::{ name: Ident(name = "|"), loc: mk_loc($sloc) } }
  | AMPERAMPER { Var::{ name: Ident(name = "&&"), loc: mk_loc($sloc) } }
  | BARBAR { Var::{ name: Ident(name = "||"), loc: mk_loc($sloc) } }
  ;

optional_question -> Location?
  : "?" { Some(mk_loc($sloc)) }
  |  { None }
  ;

argument -> Argument
  : label optional_question "=" expr {
    let arg_kind : ArgumentKind = match $2 {
      Some(question_loc) => LabelledOption(label = $1, question_loc~)
      None => Labelled($1)
    }
    Argument::{ value: $4, kind: arg_kind, equal_loc: Some(mk_loc($loc($3))) }
  }
  | expr { Argument::{ value: $1, kind: Positional, equal_loc: None } }
  | POST_LABEL {
    let label = Label::{ name: $1, loc: mk_loc($loc($1)) }
    let arg_value = @syntax.make_ident_expr(loc = mk_loc($loc($1)), Var::{ name: Ident(name = $1), loc: mk_loc($loc($1)) })
    Argument::{ value: arg_value, kind: LabelledPun(label), equal_loc: None }
  }
  | LIDENT "?" {
    let loc = mk_loc($loc($1))
    let label = Label::{ name: $1, loc }
    let arg_value = @syntax.make_ident_expr(loc~, Var::{ name: Ident(name = $1), loc })
    Argument::{
      value: arg_value,
      kind: LabelledOptionPun(label~, question_loc = mk_loc($loc($2))),
      equal_loc: None,
    }
  }
  ;

spreadable_elem -> SpreadableElem
  : expr { Regular($1) }
  | ".." expr { Spread(expr = $2, loc = mk_loc($sloc)) }
  ;

map_expr_elem -> MapExprElem
  : map_syntax_key ":" expr {
    MapExprElem::{
      key: $1,
      expr: $3,
      key_loc: mk_loc($loc($1)),
      loc: mk_loc($sloc),
      colon_loc: Some(mk_loc($loc($2))),
    }
  }
  ;

pattern -> Pattern
  : pattern "as" binder { @syntax.make_alias_pattern(loc = mk_loc($sloc), $1, $3) }
  | or_pattern { $1 }
  ;

or_pattern -> Pattern
  : range_pattern "|" or_pattern { Or(pat1 = $1, pat2 = $3, loc = mk_loc($sloc)) }
  | range_pattern { $1 }
  ;

range_pattern -> Pattern
  : simple_pattern "..<" simple_pattern {
    Range(lhs = $1, rhs = $3, kind=Exclusive, loc = mk_loc($sloc), op_loc = Some(mk_loc($loc($2))))
  }
  | simple_pattern "..=" simple_pattern {
    Range(lhs = $1, rhs = $3, kind=Inclusive, loc = mk_loc($sloc), op_loc = Some(mk_loc($loc($2))))
  }
  | simple_pattern { $1 }
  ;

simple_pattern -> Pattern
  : TRUE { @syntax.make_constant_pattern(loc = mk_loc($sloc), Bool(true)) }
  | FALSE { @syntax.make_constant_pattern(loc = mk_loc($sloc), Bool(false)) }
  | CHAR { @syntax.make_constant_pattern(loc = mk_loc($sloc), Char($1)) }
  | INT { @syntax.make_constant_pattern(loc = mk_loc($sloc), @syntax.make_int($1)) }
  | BYTE { @syntax.make_constant_pattern(loc = mk_loc($sloc), Byte($1)) }
  | DOUBLE { @syntax.make_constant_pattern(loc = mk_loc($sloc), @syntax.make_double($1)) }
  | FLOAT { @syntax.make_constant_pattern(loc = mk_loc($sloc), @syntax.make_float($1)) }
  | "-" INT {
    Pattern::Constant(
      c = @syntax.make_int("-" + $2),
      loc = mk_loc($sloc),
      uminus_loc = Some(mk_loc($loc($1))),
    )
  }
  | "-" DOUBLE {
    Pattern::Constant(
      c = @syntax.make_double("-" + $2),
      loc = mk_loc($sloc),
      uminus_loc = Some(mk_loc($loc($1))),
    )
  }
  | "-" FLOAT {
    Pattern::Constant(
      c = @syntax.make_float("-" + $2),
      loc = mk_loc($sloc),
      uminus_loc = Some(mk_loc($loc($1))),
    )
  }
  | STRING { @syntax.make_constant_pattern(loc = mk_loc($sloc), String($1)) }
  | BYTES { @syntax.make_constant_pattern(loc = mk_loc($sloc), Bytes($1)) }
  | UNDERSCORE { Any(loc = mk_loc($sloc)) }
  | binder { Var($1) }
  | constr option(constr_pat_arguments_delimited) {
    let (args, is_open, lparen_loc, rparen_loc, comma_locs, trailing_comma_loc, dotdot_loc) = match $2 {
      None => (None, false, None, None, @list.empty(), None, None)
      Some((args, is_open, lparen_loc, rparen_loc, comma_locs, trailing_comma_loc, dotdot_loc)) =>
        (
          Some(args),
          is_open,
          Some(lparen_loc),
          Some(rparen_loc),
          comma_locs,
          trailing_comma_loc,
          dotdot_loc,
        )
    }
    @syntax.make_constr_pattern(
      loc = mk_loc($sloc),
      $1,
      args,
      is_open,
      lparen_loc~,
      rparen_loc~,
      comma_locs~,
      trailing_comma_loc~,
      dotdot_loc~,
    )
  }
  // bits constr pattern `i32(args)`
  // To disambiguate with pattern variable, the args list must be present.
  | binder delimited("(", constr_pat_arguments_no_open, ")") {
    Pattern::SpecialConstr(binder = $1, args = $2, loc = mk_loc($sloc))
  }
  | "(" pattern ")" { $2 }
  | "(" pattern "," non_empty_list_commas_info(pattern) ")" {
    let (pats, comma_locs, trailing_comma_loc) = $4
    @syntax.make_tuple_pattern(
      loc = mk_loc($sloc),
      pats.add($2),
      lparen_loc = Some(mk_loc($loc($1))),
      rparen_loc = Some(mk_loc($loc($5))),
      comma_locs = comma_locs.add(mk_loc($loc($3))),
      trailing_comma_loc~,
    )
  }
  | "(" pattern annot ")" { Constraint(pat = $2, ty = $3, loc = mk_loc($sloc)) }
  | "[" array_sub_patterns "]" {
    let (pats, comma_locs, trailing_comma_loc, dotdot_loc) = $2
    Array(
      pats~,
      loc = mk_loc($sloc),
      lbracket_loc = Some(mk_loc($loc($1))),
      rbracket_loc = Some(mk_loc($loc($3))),
      comma_locs~,
      trailing_comma_loc~,
      dotdot_loc~,
    )
  }
  | "{" "}" {
    Record(
      fields = @list.empty(),
      is_closed = true,
      loc = mk_loc($sloc),
      lbrace_loc = Some(mk_loc($loc($1))),
      rbrace_loc = Some(mk_loc($loc($2))),
      comma_locs = @list.empty(),
      trailing_comma_loc = None,
      dotdot_loc = None,
    )
  }
  | "{" non_empty_fields_pat "}" {
    let (fields, is_closed, comma_locs, trailing_comma_loc, dotdot_loc) = $2
    Record(
      fields~,
      is_closed~,
      loc = mk_loc($sloc),
      lbrace_loc = Some(mk_loc($loc($1))),
      rbrace_loc = Some(mk_loc($loc($3))),
      comma_locs~,
      trailing_comma_loc~,
      dotdot_loc~,
    )
  }
  | "{" non_empty_map_elems_pat "}" {
    let (elems, is_closed, comma_locs, trailing_comma_loc, dotdot_loc) = $2
    Map(
      elems~,
      is_closed~,
      loc = mk_loc($sloc),
      lbrace_loc = Some(mk_loc($loc($1))),
      rbrace_loc = Some(mk_loc($loc($3))),
      comma_locs~,
      trailing_comma_loc~,
      dotdot_loc~,
    )
  }
  ;

array_sub_pattern -> ArrayPattern
  : pattern { Pattern($1) }
  | ".." STRING {
    StringSpread(
      str = $2,
      loc = mk_loc($loc($2)),
      dotdot_loc = Some(mk_loc($loc($1))),
    )
  }
  | ".." BYTES {
    BytesSpread(
      bytes = $2,
      loc = mk_loc($loc($2)),
      dotdot_loc = Some(mk_loc($loc($1))),
    )
  }
  | ".." UIDENT {
    let binder = Binder::{ name: $2, loc: mk_loc($loc($2)) }
    ConstSpread(
      binder~,
      pkg = None,
      loc = mk_loc($sloc),
      dotdot_loc = Some(mk_loc($loc($1))),
    )
  }
  | ".." PACKAGE_NAME DOT_UIDENT {
    let binder = Binder::{ name: $3, loc: mk_loc($loc($3)) }
    ConstSpread(
      binder~,
      pkg = Some($2),
      loc = mk_loc($sloc),
      dotdot_loc = Some(mk_loc($loc($1))),
    )
  }
  ;

dotdot_binder -> (DotDotBinder, Location)
  : ".." binder { (Binder($2), mk_loc($loc($1))) }
  | ".." "_" { (Underscore, mk_loc($loc($1))) }
  | ".." "as" binder { (BinderAs($3), mk_loc($loc($1))) }
  | ".." { (NoBinder, mk_loc($loc($1))) }
  ;

array_sub_patterns -> (ArrayPatterns, List[Location], Location?, Location?)
  : { (Closed(@list.empty()), @list.empty(), None, None) }
  | array_sub_pattern {
      (
        Closed(@list.singleton($1)),
        @list.empty(),
        None,
        None,
      )
    }
  | array_sub_pattern "," {
      (
        Closed(@list.singleton($1)),
        @list.empty(),
        Some(mk_loc($loc($2))),
        None,
      )
    }
  | array_sub_pattern "," array_sub_patterns {
      let (pats, comma_locs, trailing_comma_loc, dotdot_loc) = $3
      (
        match pats {
          Closed(ps) => Closed(ps.add($1))
          Open(ps1, ps2, b) => Open(ps1.add($1), ps2, b)
        },
        comma_locs.add(mk_loc($loc($2))),
        trailing_comma_loc,
        dotdot_loc,
      )
    }
  | dotdot_binder "," non_empty_list_commas_info(array_sub_pattern) {
      let (binder, dotdot_loc) = $1
      let (pats, comma_locs, trailing_comma_loc) = $3
      (
        Open(@list.empty(), pats, binder),
        comma_locs.add(mk_loc($loc($2))),
        trailing_comma_loc,
        Some(dotdot_loc),
      )
    }
  | dotdot_binder {
      let (binder, dotdot_loc) = $1
      (
        Open(@list.empty(), @list.empty(), binder),
        @list.empty(),
        None,
        Some(dotdot_loc),
      )
    }
  | dotdot_binder "," {
      let (binder, dotdot_loc) = $1
      (
        Open(@list.empty(), @list.empty(), binder),
        @list.empty(),
        Some(mk_loc($loc($2))),
        Some(dotdot_loc),
      )
    }
  ;

error_annotation -> ErrorType
  : "raise" { DefaultErrorType(loc = mk_loc($sloc)) }
  | "raise" error_type { ErrorType(ty = $2) }
  | "noraise" { Noraise(loc = mk_loc($sloc)) }
  | "raise" "?" {
    let fake_error = Type::Name(
      constr_id = ConstrId::{ id: Ident(name = "Error"), loc: mk_loc($sloc) },
      tys = @list.empty(),
      loc = mk_loc($sloc),
      lbracket_loc = None,
      rbracket_loc = None,
      comma_locs = @list.empty(),
      trailing_comma_loc = None,
    )
    MaybeError(ty = fake_error, question_loc = Some(mk_loc($loc($2))))
  }
  ;

return_type -> (Type, ErrorType)
  : type_ { ($1, NoErrorType) }
  | simple_type error_annotation { ($1, $2) }
  ;

func_return_type_info -> (Type?, ErrorType, Location?)
  : "->" return_type {
    match $2 {
      (ty, err) => (Some(ty), err, Some(mk_loc($loc($1))))
    }
  }
  | error_annotation { (None, $1, None) }
  |  { (None, NoErrorType, None) }
  ;

func_return_type -> (Type?, ErrorType)
  : func_return_type_info { ($1.0, $1.1) }
  ;

error_type -> Type
  : qual_ident_ty {
    Name(
      constr_id = ConstrId::{ id: $1, loc: mk_loc($sloc) },
      tys = @list.empty(),
      loc = mk_loc($sloc),
      lbracket_loc = None,
      rbracket_loc = None,
      comma_locs = @list.empty(),
      trailing_comma_loc = None,
    )
  }
  | "_" { Any(loc = mk_loc($sloc)) }
  ;

simple_type -> Type
  : simple_type "?" { @syntax.make_option_type(loc = mk_loc($sloc), constr_loc = mk_loc($loc($2)), $1) }
  | "(" type_ "," non_empty_list_commas_info(type_) ")" {
    let (tys, comma_locs, trailing_comma_loc) = $4
    @syntax.make_tuple_type(
      loc = mk_loc($sloc),
      tys.add($2),
      lparen_loc = Some(mk_loc($loc($1))),
      rparen_loc = Some(mk_loc($loc($5))),
      comma_locs = comma_locs.add(mk_loc($loc($3))),
      trailing_comma_loc~,
    )
  }
  | "(" type_ ")" { $2 }
  | qual_ident_ty_inline optional_type_arguments %prec prec_lower_than_as {
    let (tys, lbracket_loc, rbracket_loc, comma_locs, trailing_comma_loc) = $2
    Name(
      constr_id = ConstrId::{ id: $1, loc: mk_loc($loc($1)) },
      tys~,
      loc = mk_loc($sloc),
      lbracket_loc~,
      rbracket_loc~,
      comma_locs~,
      trailing_comma_loc~,
    )
  }
  | "&" qual_ident_ty {
    Object(
      constr_id = ConstrId::{ id: $2, loc: mk_loc($loc($2)) },
      amp_loc = Some(mk_loc($loc($1))),
    )
  }
  | "_" { Any(loc = mk_loc($sloc)) }
  ;

type_ -> Type
  : simple_type { $1 }
  | is_async "(" type_ "," ioption(non_empty_list_commas_info(type_)) ")" "->" return_type {
    let (ty_res, ty_err) = $8
    let (ts, comma_locs, trailing_comma_loc) = match $5 {
      None => (@list.empty(), @list.empty(), None)
      Some((ts, comma_locs, trailing_comma_loc)) => (ts, comma_locs, trailing_comma_loc)
    }
    Arrow(
      args = ts.add($3),
      res = ty_res,
      err = ty_err,
      is_async = $1,
      loc = mk_loc($sloc),
      lparen_loc = Some(mk_loc($loc($2))),
      rparen_loc = Some(mk_loc($loc($6))),
      comma_locs = comma_locs.add(mk_loc($loc($4))),
      trailing_comma_loc~,
      thin_arrow_loc = Some(mk_loc($loc($7))),
    )
  }
  | is_async "(" ")" "->" return_type {
    let (ty_res, ty_err) = $5
    Arrow(
      args = @list.empty(),
      res = ty_res,
      err = ty_err,
      is_async = $1,
      loc = mk_loc($sloc),
      lparen_loc = Some(mk_loc($loc($2))),
      rparen_loc = Some(mk_loc($loc($3))),
      comma_locs = @list.empty(),
      trailing_comma_loc = None,
      thin_arrow_loc = Some(mk_loc($loc($4))),
    )
  }
  | is_async "(" type_ ")" "->" return_type {
    let (ty_res, ty_err) = $6
    Arrow(
      args = @list.singleton($3),
      res = ty_res,
      err = ty_err,
      is_async = $1,
      loc = mk_loc($sloc),
      lparen_loc = Some(mk_loc($loc($2))),
      rparen_loc = Some(mk_loc($loc($4))),
      comma_locs = @list.empty(),
      trailing_comma_loc = None,
      thin_arrow_loc = Some(mk_loc($loc($5))),
    )
  }
  ;

record_decl_field -> FieldDecl
  : attributes visibility option("mut") LIDENT ":" type_ {
    FieldDecl::{
      name: FieldName::{ label: $4, loc: mk_loc($loc($4)) },
      ty: $6,
      mut_: $3 is Some(_),
      vis: $2,
      loc: mk_loc($sloc),
      attrs: $1,
      doc: DocString::empty()
    }
  }
  ;

record_constr_decl -> FunDecl
  : attributes is_async "fn" optional_type_parameters_info binder trait_method_params_info func_return_type_info {
    let (quantifiers, type_params_lbracket_loc, type_params_rbracket_loc, type_param_comma_locs, type_param_trailing_comma_loc) = $4
    let (decl_params, params_lparen_loc, params_rparen_loc, param_comma_locs, trailing_param_comma_loc) = $6
    let (return_type, error_type, thin_arrow_loc) = $7
    FunDecl::{
      type_name : None,
      name : $5,
      has_error: None,
      is_async : $2,
      quantifiers,
      decl_params: Some(decl_params),
      params_loc: mk_loc($loc($6)),
      return_type,
      error_type,
      vis: Default,
      doc: DocString::empty(),
      attrs: $1,
      loc : mk_loc($loc),
      declare_loc: None,
      extern_loc: None,
      fn_loc: Some(mk_loc($loc($3))),
      type_params_lbracket_loc,
      type_params_rbracket_loc,
      type_param_comma_locs,
      type_param_trailing_comma_loc,
      params_lparen_loc: Some(params_lparen_loc),
      params_rparen_loc: Some(params_rparen_loc),
      param_comma_locs,
      trailing_param_comma_loc,
      thin_arrow_loc,
    }
  }

record_decl_body -> (List[FieldDecl], FunDecl?)
  : record_constr_decl option(SEMI) {
    (@list.empty(), Some($1))
  }
  | {
    (@list.empty(), None)
  }
  | non_empty_list_semi_rev_aux(record_decl_field) SEMI record_constr_decl option(SEMI) {
    ($1.rev(), Some($3))
  }
  | non_empty_list_semi_rev_aux(record_decl_field) option(SEMI) {
    ($1.rev(), None)
  }

%inline constr_param_mut_info -> (Bool, Location?)
  : "mut" { (true, Some(mk_loc($loc($1)))) }
  | { (false, None) }
  ;

constructor_param -> ConstrParam
  : constr_param_mut_info type_ {
    let (mut_, mut_loc) = $1
    ConstrParam::{
      loc: mk_loc($sloc),
      ty: $2,
      mut_,
      label: None,
      mut_loc: mut_loc,
      colon_loc: None,
    }
  }
  | constr_param_mut_info POST_LABEL ":" type_ {
    let (mut_, mut_loc) = $1
    let label = Label::{ name: $2, loc: mk_loc($loc($2)).trim_last_char() }
    ConstrParam::{
      loc: mk_loc($sloc),
      ty: $4,
      mut_,
      label: Some(label),
      mut_loc: mut_loc,
      colon_loc: Some(mk_loc($loc($3))),
    }
  }
  ;

enum_constructor -> ConstrDecl
  : attributes UIDENT option(delimited("(", non_empty_list_commas(constructor_param), ")")) option(eq_int_tag) {
    ConstrDecl::{
      name: ConstrName::{ name: $2, loc: mk_loc($loc($2)) },
      args: $3,
      tag: $4,
      loc: mk_loc($sloc),
      attrs: $1,
      doc: DocString::empty()
    }
  }
  ;

%inline eq_int_tag -> (String, Location)
  : "=" INT { ($2, mk_loc($loc($2))) }
  ;

record_defn -> (List[FieldDef], TrailingMark, List[Location], Location?)
  : label_pun "," list_commas_info(record_defn_single) {
    let (fs, comma_locs, trailing_comma_loc) = $3
    let trailing_mark = if fs.is_empty() || trailing_comma_loc is Some(_) {
      TrailingMark::Comma
    } else {
      TrailingMark::None
    }
    (
      fs.add($1),
      trailing_mark,
      comma_locs.add(mk_loc($loc($2))),
      trailing_comma_loc,
    )
  }
  | label_pun {
    (@list.singleton($1), TrailingMark::None, @list.empty(), None)
  }
  | labeled_expr {
    (@list.singleton($1), TrailingMark::None, @list.empty(), None)
  }
  | labeled_expr "," {
    (
      @list.singleton($1),
      TrailingMark::Comma,
      @list.empty(),
      Some(mk_loc($loc($2))),
    )
  }
  | labeled_expr "," non_empty_list_commas_info(record_defn_single) {
    let (fs, comma_locs, trailing_comma_loc) = $3
    let trailing_mark = if trailing_comma_loc is Some(_) {
      TrailingMark::Comma
    } else {
      TrailingMark::None
    }
    (
      fs.add($1),
      trailing_mark,
      comma_locs.add(mk_loc($loc($2))),
      trailing_comma_loc,
    )
  }
  ;

record_defn_single -> FieldDef
  : labeled_expr { $1 }
 | label_pun { $1 }
  ;

%inline labeled_expr -> FieldDef
  : label ":" expr {
    @syntax.make_field_def(
      loc = mk_loc($sloc),
      $1,
      $3,
      false,
      colon_loc = Some(mk_loc($loc($2))),
    )
  }
  ;

%inline label_pun -> FieldDef
  : label { @syntax.make_field_def(loc = mk_loc($sloc), $1, @syntax.label_to_expr(loc = mk_loc($sloc), $1), true) }
  ;

non_empty_fields_pat -> (List[FieldPat], Bool, List[Location], Location?, Location?)
  : fields_pat_single {
      (
        @list.singleton($1),
        true,
        @list.empty(),
        None,
        None,
      )
    }
  | fields_pat_single "," {
      (
        @list.singleton($1),
        true,
        @list.empty(),
        Some(mk_loc($loc($2))),
        None,
      )
    }
  | fields_pat_single "," non_empty_fields_pat {
    let (fields, is_closed, comma_locs, trailing_comma_loc, dotdot_loc) = $3
    (
      fields.add($1),
      is_closed,
      comma_locs.add(mk_loc($loc($2))),
      trailing_comma_loc,
      dotdot_loc,
    )
  }
  | ".." {
      (
        @list.empty(),
        false,
        @list.empty(),
        None,
        Some(mk_loc($loc($1))),
      )
    }
  | ".." "," {
      (
        @list.empty(),
        false,
        @list.empty(),
        Some(mk_loc($loc($2))),
        Some(mk_loc($loc($1))),
      )
    }
  ;

fields_pat_single -> FieldPat
  : fpat_labeled_pattern { $1 }
 | fpat_label_pun { $1 }
  ;

%inline fpat_labeled_pattern -> FieldPat
  : label ":" pattern {
    @syntax.make_field_pat(
      loc = mk_loc($sloc),
      $1,
      $3,
      false,
      colon_loc = Some(mk_loc($loc($2))),
    )
  }
  ;

%inline fpat_label_pun -> FieldPat
  : label { @syntax.make_field_pat(loc = mk_loc($sloc), $1, @syntax.label_to_pat(loc = mk_loc($sloc), $1), true) }
  ;

non_empty_map_elems_pat -> (List[MapPatElem], Bool, List[Location], Location?, Location?)
  : map_elem_pat {
      (
        @list.singleton($1),
        true,
        @list.empty(),
        None,
        None,
      )
    }
  | map_elem_pat "," {
      (
        @list.singleton($1),
        true,
        @list.empty(),
        Some(mk_loc($loc($2))),
        None,
      )
    }
  | map_elem_pat "," non_empty_map_elems_pat {
    let (elems, is_closed, comma_locs, trailing_comma_loc, dotdot_loc) = $3
    (
      elems.add($1),
      is_closed,
      comma_locs.add(mk_loc($loc($2))),
      trailing_comma_loc,
      dotdot_loc,
    )
  }
  | ".." {
      (
        @list.empty(),
        false,
        @list.empty(),
        None,
        Some(mk_loc($loc($1))),
      )
    }
  | ".." "," {
      (
        @list.empty(),
        false,
        @list.empty(),
        Some(mk_loc($loc($2))),
        Some(mk_loc($loc($1))),
      )
    }
  ;

%inline map_elem_pat -> MapPatElem
  : map_syntax_key ":" pattern {
    MapPatElem::{
      key: $1,
      pat: $3,
      match_absent: false,
      key_loc: mk_loc($loc($1)),
      loc: mk_loc($sloc),
      question_loc: None,
      colon_loc: Some(mk_loc($loc($2))),
    }
  }
  | map_syntax_key "?" ":" pattern {
    MapPatElem::{
      key: $1,
      pat: $4,
      match_absent: true,
      key_loc: mk_loc($loc($1)),
      loc: mk_loc($sloc),
      question_loc: Some(mk_loc($loc($2))),
      colon_loc: Some(mk_loc($loc($3))),
    }
  }
  ;

constr_pat_arguments -> (List[ConstrPatArg], Bool, List[Location], Location?, Location?)
  : constr_pat_argument {
      (
        @list.singleton($1),
        false,
        @list.empty(),
        None,
        None,
      )
    }
  | constr_pat_argument "," {
      (
        @list.singleton($1),
        false,
        @list.empty(),
        Some(mk_loc($loc($2))),
        None,
      )
    }
  | ".." {
      (
        @list.empty(),
        true,
        @list.empty(),
        None,
        Some(mk_loc($loc($1))),
      )
    }
  | ".." "," {
      (
        @list.empty(),
        true,
        @list.empty(),
        Some(mk_loc($loc($2))),
        Some(mk_loc($loc($1))),
      )
    }
  | constr_pat_argument "," constr_pat_arguments {
    let (args, is_open, comma_locs, trailing_comma_loc, dotdot_loc) = $3
    (
      args.add($1),
      is_open,
      comma_locs.add(mk_loc($loc($2))),
      trailing_comma_loc,
      dotdot_loc,
    )
  }
  ;

constr_pat_arguments_delimited -> (List[ConstrPatArg], Bool, Location, Location, List[Location], Location?, Location?)
  : "(" constr_pat_arguments ")" {
      let (args, is_open, comma_locs, trailing_comma_loc, dotdot_loc) = $2
      (
        args,
        is_open,
        mk_loc($loc($1)),
        mk_loc($loc($3)),
        comma_locs,
        trailing_comma_loc,
        dotdot_loc,
      )
    }
  ;

constr_pat_arguments_no_open -> List[ConstrPatArg]
  : constr_pat_argument option(",") { @list.singleton($1) }
  | constr_pat_argument "," constr_pat_arguments_no_open { $3.add($1) }
  ;

constr_pat_argument -> ConstrPatArg
  : label "=" pattern {
    ConstrPatArg::{
      pat: $3,
      kind: Labelled($1),
      equal_loc: Some(mk_loc($loc($2))),
    }
  }
  | POST_LABEL {
    let loc = mk_loc($loc($1))
    let label = Label::{ name: $1, loc }
    let pat = @syntax.label_to_pat(loc = loc.trim_last_char(), label)
    ConstrPatArg::{
      pat,
      kind: LabelledPun(label),
      equal_loc: None,
    }
  }
  | pattern {
    ConstrPatArg::{
      pat: $1,
      kind: Positional,
      equal_loc: None,
    }
  }
  ;
