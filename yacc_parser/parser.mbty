%derive<Debug> Token
%derive<Eq> TokenKind
%derive<Hash> TokenKind
%derive<Compare> TokenKind
%position<Position>
%derive<Debug> ParseError

%start structure
%start expression

%token<CharLiteral> CHAR
%token<String> INT
%token<CharLiteral> BYTE
%token<StringLiteral> BYTES
%token<String> FLOAT
%token<String> DOUBLE
%token<StringLiteral> STRING
%token<String> MULTILINE_STRING
%token<InterpLiteral> MULTILINE_INTERP
%token<InterpLiteral> INTERP
%token<String> REGEX_LITERAL
%token<InterpLiteral> REGEX_INTERP
%token<(String, String?, String)> ATTRIBUTE
%token<String> LIDENT
%token<String> UIDENT
%token<String> POST_LABEL
%token<Comment> COMMENT
%token NEWLINE
%token<String> INFIX1
%token<String> INFIX2
%token<String> INFIX3
%token<String> INFIX4
%token<String> AUGMENTED_ASSIGNMENT
%token PLUS_EQUAL "+="
%token EOF
%token FALSE
%token TRUE
%token PUB "pub"
%token PRIV "priv"
%token READONLY "readonly"
%token IMPORT "import"
%token EXTERN "extern"
%token BREAK "break"
%token CONTINUE "continue"
%token STRUCT "struct"
%token ENUM "enum"
%token TRAIT "trait"
%token DERIVE "derive"
%token IMPL "impl"
%token WITH "with"
%token RAISE "raise"
%token THROW "throw"
%token TRY "try"
%token CATCH "catch"
%token ASYNC "async"
%token TYPEALIAS "typealias"
%token TRAITALIAS "traitalias"
%token FNALIAS "fnalias"
%token EQUAL "="
%token EQ_TILDE "=~"
%token LPAREN "("
%token RPAREN ")"
%token COMMA ","
%token MINUS "-"
%token QUESTION "?"
%token EXCLAMATION "!"
%token<String> DOT_LIDENT
%token<String> DOT_UIDENT
%token<Int> DOT_INT
%token DOT_LPAREN ".("
%token COLONCOLON "::"
%token COLON ":"
%token<Bool> SEMI
%token LBRACKET "["
%token PLUS "+"
%token RBRACKET "]"
%token UNDERSCORE "_"
%token BAR "|"
%token LBRACE "{"
%token RBRACE "}"
%token AMPERAMPER "&&"
%token AMPER "&"
%token CARET "^"
%token BARBAR "||"
%token<String> PACKAGE_NAME
%token AS "as"
%token PIPE "|>"
%token PIPE_LEFT "<|"
%token LT_PLUS "<+"
%token ELSE "else"
%token FN "fn"
%token IF "if"
%token LET "let"
%token PROOF_ASSERT "proof_assert"
%token PROOF_LET "proof_let"
%token CONST "const"
%token MATCH "match"
%token USING "using"
%token MUTABLE "mut"
%token TYPE "type"
%token FAT_ARROW "=>"
%token THIN_ARROW "->"
%token WHILE "while"
%token RETURN "return"
%token DOTDOT ".."
%token RANGE_INCLUSIVE "..="
%token RANGE_LT_INCLUSIVE  "..<="
%token RANGE_EXCLUSIVE "..<"
%token RANGE_INCLUSIVE_REV ">=.."
%token RANGE_EXCLUSIVE_REV ">.."
%token ELLIPSIS "..."
%token TEST "test"
%token LOOP "loop"
%token GUARD "guard"
%token DEFER "defer"
%token FOR "for"
%token IN "in"
%token IS "is"
%token SUBERROR "suberror"
%token AND "and"
%token FORALL "∀"
%token EXISTS "∃"
%token IMPLIES "→"
%token LETREC "letrec"
%token ENUMVIEW "enumview"
%token EXTENUM "extenum"
%token DECLARE         "declare"
%token NORAISE "noraise"
%token NOBREAK         "nobreak"
%token WHERE           "where"
%token TRY_QUESTION    "try?"
%token TRY_EXCLAMATION "try!"
%token LEXMATCH        "lexmatch"
%token LEXMATCH_QUESTION "lexmatch?"

// Note: this token is only used by `.mbti` parser
%token PACKAGE         "package"


%right IMPLIES
%right BARBAR
%right AMPERAMPER
%left BAR
%left CARET
%left AMPER

// x.f(...) should be [Pexpr_dot_apply], not [Pexpr_apply(Pexpr_field, ...)]
// these two precedences are used to resolve this.
%nonassoc prec_field
%nonassoc LPAREN
%left INFIX1
%left INFIX2
%left PLUS MINUS
%left INFIX3
%left INFIX4
%nonassoc prec_lower_than_as
%nonassoc "as"
%nonassoc prec_apply_non_ident_fn
%nonassoc "!"
%nonassoc "?"

// the precedence of "," and ")" are used to compare with prec_apply_non_ident_fn
// to make sure when parsing (a, b) => ...
// the comma and rparen are always shifted
%nonassoc prec_lower_than_arrow_fn
%nonassoc ","
%nonassoc ")"
%nonassoc ":"

// to resolve ambiguities with the "with" keyword.
// E.g. `lexmatch a lexmatch? "" with longest {}`
%nonassoc prec_LEXMATCH_QUESTION
%nonassoc WITH

%%


non_empty_list_rev[T](X : T) -> List[T]
  : X { @list.singleton($1) }
  | non_empty_list_rev(X) X { $1.add($2) }
  ;

non_empty_list[T](X : T) -> List[T]
  : X { @list.singleton($1) }
  | X non_empty_list(X) { $2.add($1) }
  ;

non_empty_list_commas_rev[T](X : T) -> List[T]
  : X { @list.singleton($1) }
  | non_empty_list_commas_rev(X) "," X { $1.add($3) }
  ;

non_empty_list_commas_no_trailing[T](X : T) -> List[T]
  : non_empty_list_commas_rev(X) { $1.rev() }
  ;

non_empty_list_commas[T](X : T) -> List[T]
  : non_empty_list_commas_rev(X) option(",") { $1.rev() }
  ;

non_empty_list_commas_with_tail[T](X : T) -> List[T]
  : non_empty_list_commas_rev(X) "," { $1.rev() }
  ;

list_commas[T](X : T) -> List[T]
  : { @list.empty() }
  | non_empty_list_commas(X) { $1 }
  ;

list_commas_no_trailing[T](X : T) -> List[T]
  : { @list.empty() }
  | non_empty_list_commas_no_trailing(X) { $1 }
  ;

non_empty_list_commas_with_trailing_info[T](X : T) -> (List[T], Bool)
  : non_empty_list_commas_rev(X) option(",") {
    ($1.rev(), $2 is Some(_))
  }
  ;

list_commas_with_trailing_info[T](X : T) -> (List[T], Bool)
  : { (@list.empty(), false) }
  | non_empty_list_commas_with_trailing_info(X) { $1 }
  ;

non_empty_list_commas_with_locs_rev[T](X : T) -> (List[T], List[Location])
  : X { (@list.singleton($1), @list.empty()) }
  | non_empty_list_commas_with_locs_rev(X) "," X {
    let (xs, locs) = $1
    (xs.add($3), locs.add(mk_loc($loc($2))))
  }
  ;

non_empty_list_commas_with_locs[T](X : T) -> (List[T], List[Location])
  : non_empty_list_commas_with_locs_rev(X) {
    let (xs, locs) = $1
    (xs.rev(), locs.rev())
  }
  ;

non_empty_list_commas_with_trailing_locs[T](X : T) -> (List[T], List[Location], Bool)
  : non_empty_list_commas_with_locs_rev(X) {
    let (xs, locs) = $1
    (xs.rev(), locs.rev(), false)
  }
  | non_empty_list_commas_with_locs_rev(X) "," {
    let (xs, locs) = $1
    (xs.rev(), locs.add(mk_loc($loc($2))).rev(), true)
  }
  ;

list_commas_with_locs[T](X : T) -> (List[T], List[Location])
  : { (@list.empty(), @list.empty()) }
  | non_empty_list_commas_with_locs(X) { $1 }
  ;

list_commas_with_trailing_locs[T](X : T) -> (List[T], List[Location], Bool)
  : { (@list.empty(), @list.empty(), false) }
  | non_empty_list_commas_with_trailing_locs(X) { $1 }
  ;

non_empty_list_semi_rev_aux[T](X : T) -> List[T]
  : X { @list.singleton($1) }
  | non_empty_list_semi_rev_aux(X) SEMI X { $1.add($3) }
  ;

non_empty_list_semis_rev[T](X : T) -> List[T]
  : non_empty_list_semi_rev_aux(X) option(SEMI) { $1 }
  ;

none_empty_list_semis_rev_with_trailing_info[T](X : T) -> (List[T], Bool)
  : non_empty_list_semi_rev_aux(X) option(SEMI) { ($1, $2 is Some(_)) }
  ;

non_empty_list_semis[T](X : T) -> List[T]
  : X option(SEMI) { @list.singleton($1) }
  | X SEMI non_empty_list_semis(X) { $3.add($1) }
  ;

list_semis_rev[T](X : T) -> List[T]
  : { @list.empty() }
  | non_empty_list_semis_rev(X) { $1 }
  ;

list_semis[T](X : T) -> List[T]
  : { @list.empty() }
  | non_empty_list_semis(X) { $1 }
  ;

non_empty_list_semi_rev_aux_with_locs[T](X : T) -> (List[T], List[Location])
  : X { (@list.singleton($1), @list.empty()) }
  | non_empty_list_semi_rev_aux_with_locs(X) SEMI X {
    let (xs, locs) = $1
    let locs = if $2 { locs.add(mk_loc($loc($2))) } else { locs }
    (xs.add($3), locs)
  }
  ;

none_empty_list_semis_rev_with_trailing_locs[T](X : T) -> (List[T], List[Location], Bool)
  : non_empty_list_semi_rev_aux_with_locs(X) {
    let (xs, locs) = $1
    (xs, locs, false)
  }
  | non_empty_list_semi_rev_aux_with_locs(X) SEMI {
    let (xs, locs) = $1
    let locs = if $2 { locs.add(mk_loc($loc($2))) } else { locs }
    (xs, locs, true)
  }
  ;

non_empty_list_semis_with_trailing_locs[T](X : T) -> (List[T], List[Location], Bool)
  : none_empty_list_semis_rev_with_trailing_locs(X) {
    let (xs, locs, trailing) = $1
    (xs.rev(), locs.rev(), trailing)
  }
  ;

non_empty_list_pluses_with_locs[T](X : T) -> (List[T], List[Location])
  : X { (@list.singleton($1), @list.empty()) }
  | X PLUS non_empty_list_pluses_with_locs(X) {
    let (xs, plus_locs) = $3
    (xs.add($1), plus_locs.add(mk_loc($loc($2))))
  }
  ;

list_semis_with_trailing_locs[T](X : T) -> (List[T], List[Location], Bool)
  : { (@list.empty(), @list.empty(), false) }
  | non_empty_list_semis_with_trailing_locs(X) { $1 }
  ;

%inline optional_mut_loc -> Location?
  : "mut" { Some(mk_loc($loc($1))) }
  | { None }
  ;

%inline optional_comma_loc -> Location?
  : "," { Some(mk_loc($loc($1))) }
  | { None }
  ;

%inline id[T](X : T) -> T
  : X { $1 }
  ;

%inline annot -> Type
  : ":" type_ { $2 }
  ;

%inline opt_annot -> Type?
  : ioption(annot) { $1 }
  ;

%inline opt_annot_with_loc -> (Type?, Location?)
  : ":" type_ { (Some($2), Some(mk_loc($loc($1)))) }
  | { (None, None) }
  ;

parameter -> Parameter
  : "_" opt_annot_with_loc {
      let (ty, colon_loc) = $2
      DiscardPositional(ty~, colon_loc~, loc = mk_loc($loc($1)))
    }
  | binder opt_annot_with_loc {
      let (ty, colon_loc) = $2
      Positional(binder = $1, ty~, colon_loc~)
    }
  | POST_LABEL opt_annot_with_loc {
      let (ty, colon_loc) = $2
      let binder = Binder::{ name: $1, loc: mk_loc($loc($1)).trim_last_char() }
      Labelled(
        binder~,
        ty~,
        post_label_loc = Some(mk_loc($loc($1))),
        colon_loc~,
      )
    }
  | POST_LABEL opt_annot_with_loc "=" expr {
      let (ty, colon_loc) = $2
      let binder = Binder::{ name: $1, loc: mk_loc($loc($1)).trim_last_char() }
      Optional(
        binder~,
        ty~,
        default = $4,
        post_label_loc = Some(mk_loc($loc($1))),
        question_loc = None,
        colon_loc~,
        equal_loc = mk_loc($loc($3)),
      )
    }
  | LIDENT "?" opt_annot_with_loc "=" expr {
      let (ty, colon_loc) = $3
      let binder = Binder::{ name: $1, loc: mk_loc($loc($1)) }
      Optional(
        binder~,
        ty~,
        default = $5,
        post_label_loc = None,
        question_loc = Some(mk_loc($loc($2))),
        colon_loc~,
        equal_loc = mk_loc($loc($4)),
      )
    }
  | LIDENT "?" opt_annot_with_loc {
      let (ty, colon_loc) = $3
      let binder = Binder::{ name: $1, loc: mk_loc($loc($1)) }
      QuestionOptional(
        binder~,
        ty~,
        question_loc = mk_loc($loc($2)),
        colon_loc~,
      )
    }
  ;

parameters -> List[Parameter]
  : parameters_with_locs { $1.0 }
  ;

parameters_with_locs -> (List[Parameter], Location, Location, List[Location])
  : "(" list_commas_with_trailing_locs(parameter) ")" {
    let (params, comma_locs, _) = $2
    (params, mk_loc($loc($1)), mk_loc($loc($3)), comma_locs)
  }
  ;

type_parameters -> List[TypeVarBinder]
  : type_parameters_with_locs { $1.0 }
  ;

type_parameters_with_locs -> (List[TypeVarBinder], Location, Location, List[Location])
  : "[" non_empty_list_commas_with_trailing_locs(tvar_binder) "]" {
    let (params, comma_locs, _) = $2
    (params, mk_loc($loc($1)), mk_loc($loc($3)), comma_locs)
  }
  ;

%inline is_async -> Location?
  : "async" { Some(mk_loc($loc($1))) }
  | { None }
  ;

optional_type_parameters -> List[TypeVarBinder]
  : optional_type_parameters_with_locs {
    $1.0
  }
  ;

optional_type_parameters_with_locs -> (List[TypeVarBinder], Location?, Location?, List[Location])
  : option(type_parameters_with_locs) {
    match $1 {
      None => (@list.empty(), None, None, @list.empty())
      Some((params, lbracket_loc, rbracket_loc, comma_locs)) =>
        (params, Some(lbracket_loc), Some(rbracket_loc), comma_locs)
    }
  }
  ;

optional_type_parameters_no_constraints -> List[TypeDeclBinder]
  : optional_type_parameters_no_constraints_with_locs { $1.0 }
  ;

optional_type_parameters_no_constraints_with_locs -> (List[TypeDeclBinder], Location?, Location?, List[Location])
  : "[" non_empty_list_commas_with_locs(id(type_decl_binder)) "]" {
    let (params, comma_locs) = $2
    (params, Some(mk_loc($loc($1))), Some(mk_loc($loc($3))), comma_locs)
  }
  | { (@list.empty(), None, None, @list.empty()) }
  ;

%inline optional_type_arguments -> (List[Type], Location?, Location?, List[Location])
  : "[" non_empty_list_commas_with_locs(type_) "]" {
    let (params, comma_locs) = $2
    (params, Some(mk_loc($loc($1))), Some(mk_loc($loc($3))), comma_locs)
  }
  | { (@list.empty(), None, None, @list.empty()) }
  ;

luident -> String
  : LIDENT { $1 }
  | UIDENT { $1 }
  ;

fun_binder -> (TypeName?, Binder, Location?)
  : type_name "::" luident {
    let binder = Binder::{ name: $3, loc: mk_loc($loc($3)) }
    (Some($1), binder, Some(mk_loc($loc($2))))
  }
  | binder { (None, $1, None) }
  ;

fun_header -> FunDecl
  : attributes visibility is_async fun_header_generic option(parameters_with_locs) func_return_type_with_loc {
    let ((type_name, f, coloncolon_loc), quants, fn_loc, type_params_lbracket_loc, type_params_rbracket_loc, type_param_comma_locs) = $4
    let (return_type, error_type, return_arrow_loc) = $6
    let (decl_params, params_lparen_loc, params_rparen_loc, param_comma_locs) = match $5 {
      None => (None, None, None, @list.empty())
      Some((params, lparen_loc, rparen_loc, comma_locs)) =>
        (Some(params), Some(lparen_loc), Some(rparen_loc), comma_locs)
    }
    FunDecl::{
      type_name,
      name: f,
      is_async : $3,
      declare_loc: None,
      extern_loc: None,
      fn_loc,
      coloncolon_loc,
      quantifiers: quants,
      decl_params,
      params_loc: mk_loc($loc($5)),
      type_params_lbracket_loc,
      type_params_rbracket_loc,
      type_param_comma_locs,
      params_lparen_loc,
      params_rparen_loc,
      param_comma_locs,
      return_type,
      return_arrow_loc,
      error_type,
      vis: $2,
      doc: DocString::empty(),
      attrs: $1,
      loc : mk_loc($loc)
    }
  }
  ;

declare_fun_header -> FunDecl
  : attributes "declare" visibility is_async fun_header_generic option(parameters_with_locs) func_return_type_with_loc {
    let ((type_name, f, coloncolon_loc), quants, fn_loc, type_params_lbracket_loc, type_params_rbracket_loc, type_param_comma_locs) = $5
    let (return_type, error_type, return_arrow_loc) = $7
    let (decl_params, params_lparen_loc, params_rparen_loc, param_comma_locs) = match $6 {
      None => (None, None, None, @list.empty())
      Some((params, lparen_loc, rparen_loc, comma_locs)) =>
        (Some(params), Some(lparen_loc), Some(rparen_loc), comma_locs)
    }
    FunDecl::{
      type_name,
      name: f,
      is_async : $4,
      declare_loc: Some(mk_loc($loc($2))),
      extern_loc: None,
      fn_loc,
      coloncolon_loc,
      quantifiers: quants,
      decl_params,
      params_loc: mk_loc($loc($6)),
      type_params_lbracket_loc,
      type_params_rbracket_loc,
      type_param_comma_locs,
      params_lparen_loc,
      params_rparen_loc,
      param_comma_locs,
      return_type,
      return_arrow_loc,
      error_type,
      vis: $3,
      doc: DocString::empty(),
      attrs: $1,
      loc : mk_loc($loc)
    }
  }

fun_header_generic -> ((TypeName?, Binder, Location?), List[TypeVarBinder], Location, Location?, Location?, List[Location])
  : "fn" optional_type_parameters_with_locs fun_binder {
    let (quants, lbracket_loc, rbracket_loc, comma_locs) = $2
    ($3, quants, mk_loc($loc($1)), lbracket_loc, rbracket_loc, comma_locs)
  }
  ;

extern_fun_header -> (StringLiteral, Location, FunDecl)
  : attributes visibility "extern" STRING "fn" optional_type_parameters_with_locs fun_binder option(parameters_with_locs) func_return_type_with_loc {
    let (type_name, f, coloncolon_loc) = $7
    let (quants, type_params_lbracket_loc, type_params_rbracket_loc, type_param_comma_locs) = $6
    let (return_type, error_type, return_arrow_loc) = $9
    let (decl_params, params_lparen_loc, params_rparen_loc, param_comma_locs) = match $8 {
      None => (None, None, None, @list.empty())
      Some((params, lparen_loc, rparen_loc, comma_locs)) =>
        (Some(params), Some(lparen_loc), Some(rparen_loc), comma_locs)
    }
    let fn_decl = FunDecl::{
      type_name,
      name: f,
      is_async : None,
      declare_loc: None,
      extern_loc: Some(mk_loc($loc($3))),
      fn_loc: mk_loc($loc($5)),
      coloncolon_loc,
      quantifiers: quants,
      decl_params,
      params_loc: mk_loc($loc($8)),
      type_params_lbracket_loc,
      type_params_rbracket_loc,
      type_param_comma_locs,
      params_lparen_loc,
      params_rparen_loc,
      param_comma_locs,
      return_type,
      return_arrow_loc,
      error_type,
      vis: $2,
      doc: DocString::empty(),
      attrs: $1,
      loc : mk_loc($loc)
    }
    ($4, mk_loc($loc($4)), fn_decl)
  }
  ;

block_expr -> Expr
  : block_expr_with_locs { $1.0 }
  ;

block_expr_with_locs -> (Expr, Location, Location)
  : "{" option(non_empty_statements_rev_with_trailing_semis) "}" {
    let statements = match $2 {
      Some((statements, _)) => statements
      None => @list.empty()
    }
    (
      Statement::compact_rev(statements, loc = mk_loc($sloc)),
      mk_loc($loc($1)),
      mk_loc($loc($3)),
    )
  }
  ;

impl_body -> DeclBody
  : block_expr_with_locs {
    let (expr, lbrace_loc, rbrace_loc) = $1
    DeclBody(expr~, lbrace_loc = Some(lbrace_loc), rbrace_loc = Some(rbrace_loc))
  }
  | "=" STRING {
    let code_loc = mk_loc($loc($2))
    DeclStubs(
      Embedded(
        language = None,
        code = CodeString($2, loc = code_loc),
        language_loc = None,
        code_loc~,
      ),
      equal_loc = mk_loc($loc($1)),
    )
  }
  ;

multiline_strings_with_locs -> (List[String], List[Location])
  : MULTILINE_STRING {
    (@list.singleton($1), @list.singleton(mk_loc($loc($1))))
  }
  | MULTILINE_STRING multiline_strings_with_locs {
    let (strings, locs) = $2
    (strings.add($1), locs.add(mk_loc($loc($1))))
  }
  ;

expression -> Expr
  : expr EOF { $1 }
  ;

val_header -> (List[Attribute], Bool, Bool, Location?, Visibility, Binder, Type?, Location, Location?)
  : attributes is_declare_with_loc visibility "let" binder opt_annot_with_loc {
    let (is_declare, declare_loc) = $2
    let (ty, annot_colon_loc) = $6
    ($1, false, is_declare, declare_loc, $3, $5, ty, mk_loc($loc($4)), annot_colon_loc)
  }
  | attributes is_declare_with_loc visibility "const" UIDENT opt_annot_with_loc {
    let (is_declare, declare_loc) = $2
    let (ty, annot_colon_loc) = $6
    ($1, true, is_declare, declare_loc, $3, Binder::{ name : $5, loc : mk_loc($loc($5)) }, ty, mk_loc($loc($4)), annot_colon_loc)
  }
  ;

structure -> List[Impl]
  : list_semis(structure_item) EOF { $1 }
  ;

structure_item -> Impl
  : type_header deriving_directive_list_with_locs {
    let (attrs, type_vis, is_declare, declare_loc, keyword_loc, tycon, tycon_loc, params, params_lbracket_loc, params_rbracket_loc, param_comma_locs) = $1
    let (deriving, derive_loc, derive_lparen_loc, derive_rparen_loc, derive_comma_locs) = $2
    TopTypeDef(
      TypeDecl::{
        tycon,
        tycon_loc,
        params,
        components: Abstract,
        type_vis,
        doc : DocString::empty(),
        deriving,
        declare_loc,
