%inline attributes -> List[Attribute]
  :  { @list.empty() }
  | non_empty_list(attribute) { $1 }
  ;

%inline attribute -> Attribute
  : ATTRIBUTE { Attribute::new(loc=mk_loc($sloc), $1) }
  ;

%inline visibility -> Visibility
  :  { Default }
  | "priv" { Priv(loc = mk_loc($sloc)) }
  | "pub" pub_attr { Pub(loc = mk_loc($sloc), attr = $2) }
  ;

pub_attr -> String?
  :  { None }
  | "(" "readonly" ")" { Some("readonly") }
  | "(" LIDENT ")" { Some($2) }
  ;

%inline is_declare -> Bool
  : "declare" { true }
  | { false }
  ;

%inline is_declare_with_loc -> (Bool, Location?)
  : "declare" { (true, Some(mk_loc($loc($1)))) }
  | { (false, None) }
  ;

type_header -> (List[Attribute], Visibility, Bool, Location?, Location, String, Location, List[TypeDeclBinder], Location?, Location?, List[Location])
  : attributes is_declare_with_loc visibility "type" UIDENT optional_type_parameters_no_constraints_with_locs {
    let (is_declare, declare_loc) = $2
    let (params, lbracket_loc, rbracket_loc, comma_locs) = $6
    ($1, $3, is_declare, declare_loc, mk_loc($loc($4)), $5, mk_loc($loc($5)), params, lbracket_loc, rbracket_loc, comma_locs)
  }
  ;

suberror_header -> (List[Attribute], Visibility, Bool, Location?, Location, String, Location)
  : attributes is_declare_with_loc visibility "suberror" UIDENT {
    let (is_declare, declare_loc) = $2
    ($1, $3, is_declare, declare_loc, mk_loc($loc($4)), $5, mk_loc($loc($5)))
  }
  ;

struct_header -> (List[Attribute], Visibility, Location, String, Location, List[TypeDeclBinder], Location?, Location?, List[Location])
  : attributes visibility "struct" UIDENT optional_type_parameters_no_constraints_with_locs {
    let (params, lbracket_loc, rbracket_loc, comma_locs) = $5
    ($1, $2, mk_loc($loc($3)), $4, mk_loc($loc($4)), params, lbracket_loc, rbracket_loc, comma_locs)
  }
  ;

enum_header -> (List[Attribute], Visibility, Location, String, Location, List[TypeDeclBinder], Location?, Location?, List[Location])
  : attributes visibility "enum" UIDENT optional_type_parameters_no_constraints_with_locs {
    let (params, lbracket_loc, rbracket_loc, comma_locs) = $5
    ($1, $2, mk_loc($loc($3)), $4, mk_loc($loc($4)), params, lbracket_loc, rbracket_loc, comma_locs)
  }
  ;

extenum_extension_target -> (String, Location, List[TypeDeclBinder], Location?, Location?, List[Location], TypeName)
  : UIDENT optional_type_parameters_no_constraints_with_locs {
    let loc = mk_loc($loc($1))
    let (params, lbracket_loc, rbracket_loc, comma_locs) = $2
    let target = TypeName::{ name: Ident(name = $1), is_object: false, object_amp_loc: None, loc }
    ($1, loc, params, lbracket_loc, rbracket_loc, comma_locs, target)
  }
  | PACKAGE_NAME DOT_UIDENT optional_type_parameters_no_constraints_with_locs {
    let tycon_loc = mk_loc($loc($2))
    let (params, lbracket_loc, rbracket_loc, comma_locs) = $3
    let target = TypeName::{
      name: Dot(pkg = $1, id = $2, pkg_loc = mk_loc($loc($1)), dot_id_loc = mk_loc($loc($2))),
      is_object: false,
      object_amp_loc: None,
      loc: mk_loc($sloc),
    }
    ($2, tycon_loc, params, lbracket_loc, rbracket_loc, comma_locs, target)
  }
  ;

batch_type_alias_targets -> (Bool, Label?, List[AliasTarget])
  : PACKAGE_NAME batch_type_alias_target(DOT_UIDENT) {
    let pkg = Label::{ name: $1, loc: mk_loc($loc($1)) }
    (false, Some(pkg), @list.singleton($2))
  }
  | PACKAGE_NAME ".(" non_empty_list_commas(batch_type_alias_target(UIDENT)) ")" {
    let pkg = Label::{ name: $1, loc: mk_loc($loc($1)) }
    (true, Some(pkg), $3)
  }
  | batch_type_alias_target(UIDENT) { (false, None, @list.singleton($1)) }
  ;

batch_type_alias_target(UIDENT_MAYBE_DOT) -> AliasTarget
  : UIDENT_MAYBE_DOT {
    let binder = Binder::{ name: $1, loc: mk_loc($loc($1)) }
    AliasTarget::{ binder, target: None, as_loc: None }
  }
  | UIDENT_MAYBE_DOT "as" UIDENT {
    let target = Label::{ name: $1, loc: mk_loc($loc($1)) }
    let binder = Binder::{ name: $3, loc: mk_loc($loc($3)) }
    AliasTarget::{ binder, target: Some(target), as_loc: Some(mk_loc($loc($2))) }
  }
  ;

func_alias_targets -> (Label?, Label?, Bool, List[AliasTarget])
  : ioption(func_alias_type_name(LIDENT, UIDENT)) func_alias_target(LIDENT) {
    (None, $1, false, @list.singleton($2))
  }
  | PACKAGE_NAME func_alias_target(DOT_LIDENT) {
    let pkg = Label::{ name: $1, loc: mk_loc($loc($1)) }
    (Some(pkg), None, false, @list.singleton($2))
  }
  | PACKAGE_NAME func_alias_type_name(DOT_LIDENT, DOT_UIDENT) func_alias_target(LIDENT) {
    let pkg = Label::{ name: $1, loc: mk_loc($loc($1)) }
    (Some(pkg), Some($2), false, @list.singleton($3))
  }
  | option(func_alias_type_name(LIDENT, UIDENT)) "(" non_empty_list_commas(func_alias_target(LIDENT)) ")" {
    (None, $1, true, $3)
  }
  | PACKAGE_NAME ".(" non_empty_list_commas(func_alias_target(LIDENT)) ")" {
    let pkg = Label::{ name: $1, loc: mk_loc($loc($1)) }
    (Some(pkg), None, true, $3)
  }
  | PACKAGE_NAME func_alias_type_name(DOT_LIDENT, DOT_UIDENT) "(" non_empty_list_commas(func_alias_target(LIDENT)) ")" {
    let pkg = Label::{ name: $1, loc: mk_loc($loc($1)) }
    (Some(pkg), Some($2), true, $4)
  }
  ;

func_alias_type_name(LIDENT_MAYBE_DOT, UIDENT_MAYBE_DOT) -> Label
  : LIDENT_MAYBE_DOT "::" { Label::{ name: $1, loc: mk_loc($loc($1)) } }
  | UIDENT_MAYBE_DOT "::" { Label::{ name: $1, loc: mk_loc($loc($1)) } }
  ;

func_alias_target(LIDENT_MAYBE_DOT) -> AliasTarget
  : LIDENT_MAYBE_DOT func_alias_target_as {
    match $2 {
      None => {
        let binder = Binder::{ name: $1, loc: mk_loc($loc($1)) }
        AliasTarget::{ binder, target: None, as_loc: None }
      }
      Some((as_loc, binder)) => {
        let target = Label::{ name: $1, loc: mk_loc($loc($1)) }
        AliasTarget::{ binder, target: Some(target), as_loc: Some(as_loc) }
      }
    }
  }
  ;

func_alias_target_as -> (Location, Binder)?
  : { None }
  | "as" binder { Some((mk_loc($loc($1)), $2)) }
  ;

using_binder -> (AliasTarget, UsingKind):
  | LIDENT
  | UIDENT {
    let binder = Binder::{
      name : $1,
      loc : mk_loc($loc)
    }
    ({ binder, target : None, as_loc : None }, UsingKind::Value)
  }
  | LIDENT "as" LIDENT
  | UIDENT "as" UIDENT {
    let binder = Binder::{
      name : $3,
      loc : mk_loc($loc($3))
    }
    let target = Label::{
      name : $1,
      loc : mk_loc($loc($1))
    }
    ({ binder, target : Some(target), as_loc : Some(mk_loc($loc($2))) }, UsingKind::Value)
  }
  | "type" UIDENT {
    let binder = Binder::{
      name : $2,
      loc : mk_loc($loc($2))
    }
    ({ binder, target : None, as_loc : None }, UsingKind::Type(loc = mk_loc($loc($1))))
  }
  | "type" UIDENT "as" UIDENT {
    let binder = Binder::{
      name : $4,
      loc : mk_loc($loc($4))
    }
    let target = Label::{
      name : $2,
      loc : mk_loc($loc($2))
    }
    ({ binder, target : Some(target), as_loc : Some(mk_loc($loc($3))) }, UsingKind::Type(loc = mk_loc($loc($1))))
  }
  | "trait" UIDENT {
    let binder = Binder::{
      name : $2,
      loc : mk_loc($loc($2))
    }
    ({ binder, target : None, as_loc : None }, UsingKind::Trait(loc = mk_loc($loc($1))))
  }
  | "trait" UIDENT "as" UIDENT {
    let binder = Binder::{
      name : $4,
      loc : mk_loc($loc($4))
    }
    let target = Label::{
      name : $2,
      loc : mk_loc($loc($2))
    }
    ({ binder, target : Some(target), as_loc : Some(mk_loc($loc($3))) }, UsingKind::Trait(loc = mk_loc($loc($1))))
  }

deriving_directive -> DerivingDirective
  : type_name {
    DerivingDirective::{
      type_name: $1,
      args: @list.empty(),
      args_lparen_loc: None,
      args_rparen_loc: None,
      arg_comma_locs: @list.empty(),
      loc: mk_loc($sloc),
    }
  }
  | type_name "(" list_commas_with_trailing_locs(argument) ")" {
    let (args, comma_locs, _) = $3
    DerivingDirective::{
      type_name: $1,
      args,
      args_lparen_loc: Some(mk_loc($loc($2))),
      args_rparen_loc: Some(mk_loc($loc($4))),
      arg_comma_locs: comma_locs,
      loc: mk_loc($sloc),
    }
  }
  ;

deriving_directive_list -> List[DerivingDirective]
  : deriving_directive_list_with_locs { $1.0 }
  ;

deriving_directive_list_with_locs -> (List[DerivingDirective], Location?, Location?, Location?, List[Location])
  : { (@list.empty(), None, None, None, @list.empty()) }
  | "derive" "(" list_commas_with_trailing_locs(deriving_directive) ")" {
    let (deriving, comma_locs, _) = $3
    (
      deriving,
      Some(mk_loc($loc($1))),
      Some(mk_loc($loc($2))),
      Some(mk_loc($loc($4))),
      comma_locs,
    )
  }
  ;

optional_fn_loc -> Location?
  : { None }
  | "fn" { Some(mk_loc($loc($1))) }
  ;

trait_super_constraints_with_locs -> (List[TypeVarConstraint], List[Location])
  : non_empty_list_pluses_with_locs(tvar_constraint) { $1 }
  ;

optional_trait_supers_with_locs -> (List[TypeVarConstraint], Location?, List[Location])
  : { (@list.empty(), None, @list.empty()) }
  | ":" trait_super_constraints_with_locs {
    let (supers, plus_locs) = $2
    (supers, Some(mk_loc($loc($1))), plus_locs)
  }
  ;

trait_method_fn_header -> (List[TypeVarBinder], Location?, Location?, Location?, List[Location])
  : { (@list.empty(), None, None, None, @list.empty()) }
  | "fn" optional_type_parameters_with_locs {
    let (quantifiers, lbracket_loc, rbracket_loc, comma_locs) = $2
    (quantifiers, Some(mk_loc($loc($1))), lbracket_loc, rbracket_loc, comma_locs)
  }
  ;

trait_method_parameters_with_locs -> (List[Parameter], Location, Location, List[Location])
  : "(" list_commas_with_trailing_locs(trait_method_param) ")" {
    let (params, comma_locs, _) = $2
    (params, mk_loc($loc($1)), mk_loc($loc($3)), comma_locs)
  }
  ;

trait_method_default -> (Location, Location)?
  : { None }
  | "=" wildcard { Some((mk_loc($loc($1)), $2)) }
  ;

trait_method_decl -> TraitMethodDecl
  : attributes is_async trait_method_fn_header binder trait_method_parameters_with_locs func_return_type_with_loc trait_method_default {
    let (quantifiers, fn_loc, type_params_lbracket_loc, type_params_rbracket_loc, type_param_comma_locs) = $3
    let (params, params_lparen_loc, params_rparen_loc, param_comma_locs) = $5
    let (return_type, error_type, return_arrow_loc) = $6
    let (default_equal_loc, has_default) = match $7 {
      None => (None, None)
      Some((equal_loc, wildcard_loc)) => (Some(equal_loc), Some(wildcard_loc))
    }
    TraitMethodDecl::{
      name: $4,
      is_async: $2,
      fn_loc,
      quantifiers,
      type_params_lbracket_loc,
      type_params_rbracket_loc,
      type_param_comma_locs,
      params,
      params_lparen_loc,
      params_rparen_loc,
      param_comma_locs,
      return_type,
      return_arrow_loc,
      error_type,
      has_default,
      default_equal_loc,
      attrs: $1,
      loc: mk_loc($sloc)
    }
  }
  ;

wildcard -> Location
  : "_" { mk_loc($sloc) }
  ;

trait_method_param -> Parameter
  : type_ {
    DiscardPositional(ty = Some($1), colon_loc = None, loc = mk_loc($sloc))
  }
  | binder ":" type_ {
    Positional(binder = $1, ty = Some($3), colon_loc = Some(mk_loc($loc($2))))
  }
  | binder "?" ":" type_ {
    QuestionOptional(
      binder = $1,
      ty = Some($4),
      question_loc = mk_loc($loc($2)),
      colon_loc = Some(mk_loc($loc($3))),
    )
  }
  | POST_LABEL ":" type_ {
    let binder = Binder::{ name: $1, loc: mk_loc($loc($1)).trim_last_char() }
    Labelled(
      binder~,
      ty = Some($3),
      post_label_loc = Some(mk_loc($loc($1))),
      colon_loc = Some(mk_loc($loc($2))),
    )
  }
  ;

qual_ident -> LongIdent
  : LIDENT { Ident(name = $1) }
  | PACKAGE_NAME DOT_LIDENT {
    Dot(pkg = $1, id = $2, pkg_loc = mk_loc($loc($1)), dot_id_loc = mk_loc($loc($2)))
  }
  ;

qual_ident_simple_expr -> LongIdent
  : LIDENT %prec prec_apply_non_ident_fn { Ident(name = $1) }
  | PACKAGE_NAME DOT_LIDENT {
    Dot(pkg = $1, id = $2, pkg_loc = mk_loc($loc($1)), dot_id_loc = mk_loc($loc($2)))
  }
  ;

%inline qual_ident_ty_inline -> LongIdent
  : UIDENT { LongIdent::Ident(name = $1) }
  | PACKAGE_NAME DOT_LIDENT {
    LongIdent::Dot(pkg = $1, id = $2, pkg_loc = mk_loc($loc($1)), dot_id_loc = mk_loc($loc($2)))
  }
  | PACKAGE_NAME DOT_UIDENT {
    LongIdent::Dot(pkg = $1, id = $2, pkg_loc = mk_loc($loc($1)), dot_id_loc = mk_loc($loc($2)))
  }
  ;

qual_ident_ty -> LongIdent
  : qual_ident_ty_inline { $1 }
  ;

%inline qual_uident -> LongIdent
  : UIDENT { Ident(name = $1) }
  | PACKAGE_NAME DOT_UIDENT {
    Dot(pkg = $1, id = $2, pkg_loc = mk_loc($loc($1)), dot_id_loc = mk_loc($loc($2)))
  }
  ;

non_empty_statements_rev_with_semis -> List[Statement]
  : statement { @list.singleton($1) }
  | non_empty_statements_rev_with_semis SEMI statement {
    let semi_loc = if $2 { Some(mk_loc($loc($2))) } else { None }
    Statement::with_head_semi_loc_rev($1, semi_loc).add($3)
  }
  ;

non_empty_statements_rev_with_trailing_semis -> (List[Statement], Bool)
  : non_empty_statements_rev_with_semis { ($1, false) }
  | non_empty_statements_rev_with_semis SEMI {
    let semi_loc = if $2 { Some(mk_loc($loc($2))) } else { None }
    (Statement::with_head_semi_loc_rev($1, semi_loc), true)
  }
  ;

%inline semi_expr_semi_opt -> (Expr, Bool, List[Location])
  : non_empty_statements_rev_with_trailing_semis {
    let (ls, trailing) = $1
    (Statement::compact_rev(ls, loc = mk_loc($sloc)), trailing, Statement::semi_locs_rev(ls))
  }
  ;

letand_func -> Func
  : arrow_fn_expr { $1 }
  | anony_fn { $1 }
  ;

and_func -> (Binder, Type?, Func, Location, Location?, Location)
  : "and" binder opt_annot_with_loc "=" letand_func {
    let (ty, annot_colon_loc) = $3
    ($2, ty, $5, mk_loc($loc($1)), annot_colon_loc, mk_loc($loc($4)))
  }
  ;

statement -> Statement
  : "let" pattern opt_annot_with_loc "=" expr {
    let (ty, annot_colon_loc) = $3
    let pat = match ty {
      None => $2
      Some(ty) => {
        let colon_loc = match annot_colon_loc {
          Some(loc) => loc
          None => @syntax.no_location
        }
        Pattern::Constraint(
          pat = $2,
          ty~,
          lparen_loc = None,
          colon_loc~,
          rparen_loc = None,
          loc = $2.loc().merge(ty.loc()),
        )
      }
    }
    StmtLet(
      pat~,
      expr = $5,
      let_loc = mk_loc($loc($1)),
      annot_colon_loc~,
      equal_loc = mk_loc($loc($4)),
      semi_loc = None,
      loc = mk_loc($sloc),
    )
  }
  | "letrec" binder opt_annot_with_loc "=" letand_func list(and_func) {
    let (ty, annot_colon_loc) = $3
    let bindings = [($2, ty, $5)]
    let and_locs = []
    let equal_locs = [mk_loc($loc($4))]
    let annot_colon_locs = []
    match annot_colon_loc {
      Some(loc) => annot_colon_locs.push(loc)
      None => ()
    }
    for item in $6 {
      let (binder, ty, func, and_loc, annot_colon_loc, equal_loc) = item
      bindings.push((binder, ty, func))
      and_locs.push(and_loc)
      equal_locs.push(equal_loc)
      match annot_colon_loc {
        Some(loc) => annot_colon_locs.push(loc)
        None => ()
      }
    }
    StmtLetand(
      bindings = @list.from_array(bindings),
      letrec_loc = mk_loc($loc($1)),
      and_locs = @list.from_array(and_locs),
      equal_locs = @list.from_array(equal_locs),
      annot_colon_locs = @list.from_array(annot_colon_locs),
      semi_loc = None,
      loc = mk_loc($sloc),
    )
  }
  | "let" "mut" binder opt_annot_with_loc "=" expr {
    let (ty_opt, annot_colon_loc) = $4
    StmtLetmut(
      binder = $3,
      ty_opt~,
      expr = $6,
      let_loc = mk_loc($loc($1)),
      mut_loc = mk_loc($loc($2)),
      annot_colon_loc~,
      equal_loc = mk_loc($loc($5)),
      semi_loc = None,
      loc = mk_loc($sloc),
    )
  }
  | is_async "fn" binder parameters_with_locs func_return_type_with_loc block_expr_with_locs {
    let (parameters, lparen_loc, rparen_loc, comma_locs) = $4
    let (return_type, error_type, return_arrow_loc) = $5
    let (body, body_lbrace_loc, body_rbrace_loc) = $6
    let func = Func::{
      parameters,
      params_loc : lparen_loc.merge(rparen_loc),
      body,
      return_type,
      error_type,
      kind : Lambda,
      is_async : $1,
      fn_loc : Some(mk_loc($loc($2))),
      lparen_loc : Some(lparen_loc),
      rparen_loc : Some(rparen_loc),
      comma_locs,
      return_arrow_loc,
      fat_arrow_loc : None,
      body_lbrace_loc : Some(body_lbrace_loc),
      body_rbrace_loc : Some(body_rbrace_loc),
      loc : mk_loc($sloc)
    }
    StmtFunc(binder = $3, func~, semi_loc = None, loc = mk_loc($sloc))
  }
  | guard_statement { $1 }
  | "defer" pipe_expr {
    StmtDefer(
      expr = $2,
      defer_loc = mk_loc($loc($1)),
      semi_loc = None,
      loc = mk_loc($sloc),
    )
  }
  | "proof_assert" expr {
    StmtExpr(
      expr = ProofAssert(
        expr = $2,
        proof_assert_loc = mk_loc($loc($1)),
        loc = mk_loc($sloc),
      ),
      semi_loc = None,
    )
  }
  | "proof_let" binder "=" expr {
    StmtExpr(
      expr = ProofLet(
        binder = $2,
        expr = $4,
        proof_let_loc = mk_loc($loc($1)),
        equal_loc = mk_loc($loc($3)),
        loc = mk_loc($sloc),
      ),
      semi_loc = None,
    )
  }
  | expr_statement { StmtExpr(expr = $1, semi_loc = None) }
  ;

guard_statement -> Statement
  : "guard" infix_expr {
    StmtGuard(
      cond = $2,
      otherwise = None,
      guard_loc = mk_loc($loc($1)),
      else_loc = None,
      else_lbrace_loc = None,
      else_rbrace_loc = None,
      semi_loc = None,
      loc = mk_loc($sloc),
    )
  }
  | "guard" infix_expr "else" block_expr_with_locs {
    let (otherwise, else_lbrace_loc, else_rbrace_loc) = $4
    StmtGuard(
      cond = $2,
      otherwise = Some(otherwise),
      guard_loc = mk_loc($loc($1)),
      else_loc = Some(mk_loc($loc($3))),
      else_lbrace_loc = Some(else_lbrace_loc),
      else_rbrace_loc = Some(else_rbrace_loc),
      semi_loc = None,
      loc = mk_loc($sloc),
    )
  }
  ;

%inline assignment_expr -> Expr
  : left_value "=" expr {
    let loc = mk_loc($sloc)
    let equal_loc = mk_loc($loc($2))
    match $1 {
      Var(var_) =>
        Assign(
          var_~,
          expr=$3,
          augmented_by=None,
          equal_loc=Some(equal_loc),
          augmented_assign_loc=None,
          loc~,
        )
      Field(record, accessor) =>
        Mutate(
          record~,
          accessor~,
          field=$3,
          augmented_by=None,
          equal_loc=Some(equal_loc),
          augmented_assign_loc=None,
          loc~,
        )
      Array(array, index, lbracket_loc, rbracket_loc) =>
        ArraySet(
          array~,
          index~,
          value=$3,
          lbracket_loc~,
          rbracket_loc~,
          equal_loc~,
          loc~,
        )
    }
  }
  ;

%inline augmented_assignment_expr -> Expr
  : left_value assignop expr {
    let loc = mk_loc($sloc)
    match $1 {
      Var(var_) =>
        Assign(
          var_~,
          expr=$3,
          augmented_by=Some($2),
          equal_loc=None,
          augmented_assign_loc=Some($2.loc),
          loc~,
        )
      Field(record, accessor) =>
        Mutate(
          record~,
          accessor~,
          field=$3,
          augmented_by=Some($2),
          equal_loc=None,
          augmented_assign_loc=Some($2.loc),
          loc~,
        )
      Array(array, index, lbracket_loc, rbracket_loc) =>
        ArrayAugmentedSet(
          op=$2,
          array~,
          index~,
          value=$3,
          lbracket_loc~,
          rbracket_loc~,
          augmented_assign_loc=$2.loc,
          loc~,
        )
    }
  }
  ;

template_rhs -> Expr
  : INTERP {
    make_interp_expr(loc = mk_loc($sloc), $1)
  }
  | STRING {
    Expr::Constant(c = @syntax.Constant::String($1), loc = mk_loc($sloc))
  }
  | non_empty_list(multiline_string) {
    Expr::MultilineString(elems = $1, loc = mk_loc($sloc))
  }
  ;

expr_statement_no_break_continue_return -> Expr
  : "raise" expr {
    Raise(err_value = $2, raise_loc = mk_loc($loc($1)), loc = mk_loc($sloc))
  }
  | "..." { Hole(loc = mk_loc($sloc), kind = Todo) }
  | augmented_assignment_expr { $1 }
  | assignment_expr { $1 }
  | expr { $1 }
  ;

expr_statement -> Expr
  : "break" POST_LABEL option(expr) {
    let label = Label::{ name: $2, loc: mk_loc($loc($2)) }
    Break(
      arg = $3,
      label = Some(label),
      break_loc = mk_loc($loc($1)),
      post_label_loc = Some(mk_loc($loc($2))),
      loc = mk_loc($sloc),
    )
  }
  | "break" option(expr) {
    Break(
      arg = $2,
      label = None,
      break_loc = mk_loc($loc($1)),
      post_label_loc = None,
      loc = mk_loc($sloc),
    )
  }
  | "continue" POST_LABEL list_commas_with_locs(expr) {
    let label = Label::{ name: $2, loc: mk_loc($loc($2)) }
    let (args, comma_locs) = $3
    Continue(
      args~,
      label = Some(label),
      continue_loc = mk_loc($loc($1)),
      post_label_loc = Some(mk_loc($loc($2))),
      comma_locs~,
      loc = mk_loc($sloc),
    )
  }
  | "continue" list_commas_with_locs(expr) {
    let (args, comma_locs) = $2
    Continue(
      args~,
      label = None,
      continue_loc = mk_loc($loc($1)),
      post_label_loc = None,
      comma_locs~,
      loc = mk_loc($sloc),
    )
  }
  | "return" option(expr) {
    Return(return_value = $2, return_loc = mk_loc($loc($1)), loc = mk_loc($sloc))
  }
  | expr_statement_no_break_continue_return { $1 }
  ;

loop_label_colon -> Label?
  : POST_LABEL ":" { Some(Label::{ name : $1, loc : mk_loc($sloc) }) }
  |  { None}
  ;

loop_label_colon_with_loc -> (Label?, Location?)
  : POST_LABEL ":" {
    let loc = mk_loc($sloc)
    (Some(Label::{ name : $1, loc }), Some(loc))
  }
  |  { (None, None) }
  ;

while_expr -> Expr
  : loop_label_colon_with_loc "while" infix_expr block_expr_with_locs optional_nobreak_with_locs {
    let (label, label_colon_loc) = $1
    let (loop_body, body_lbrace_loc, body_rbrace_loc) = $4
    let (while_else, nobreak_loc, nobreak_lbrace_loc, nobreak_rbrace_loc) = $5
    While(
      loop_cond = $3,
      loop_body~,
      while_else~,
      label~,
      label_colon_loc~,
      while_loc = mk_loc($loc($2)),
      body_lbrace_loc~,
      body_rbrace_loc~,
      nobreak_loc~,
      nobreak_lbrace_loc~,
      nobreak_rbrace_loc~,
      loc = mk_loc($sloc)
    )
  }
  ;

case_guard -> (Location, Expr)
  : "if" infix_expr { (mk_loc($loc($1)), $2) }
  ;

single_pattern_case -> Case
  : pattern option(case_guard) "=>" expr_statement {
    let (if_loc, guard_) = match $2 {
      None => (None, None)
      Some((loc, guard_expr)) => (Some(loc), Some(guard_expr))
    }
    Case::{
      pattern : $1,
      guard_ : guard_,
      body : $4,
      if_loc : if_loc,
      fat_arrow_loc : Some(mk_loc($loc($3))),
      ellipsis_loc : None,
    }
  }
  | "..." {
    Case::{
      pattern : Pattern::Any(loc = mk_loc($sloc)),
      guard_ : None,
      body : Hole(loc = mk_loc($sloc), kind = Todo),
      if_loc : None,
      fat_arrow_loc : None,
      ellipsis_loc : Some(mk_loc($loc($1))),
    }
  }
  ;

single_pattern_cases -> List[Case]
  : list_semis(single_pattern_case) { $1 }
  ;

single_pattern_cases_with_locs -> (List[Case], List[Location])
  : list_semis_with_trailing_locs(single_pattern_case) {
    let (cases, semi_locs, _) = $1
    (cases, semi_locs)
  }
  ;

catch_keyword -> (Location, Location)
  : "catch" "{" { (mk_loc($sloc), mk_loc($loc($2))) }
  ;

%inline else_keyword -> (Location, Location)
  : "noraise" "{" { (mk_loc($sloc), mk_loc($loc($2))) }
  ;

try_expr -> Expr
  : "try" pipe_expr catch_keyword single_pattern_cases_with_locs "}" {
    let (catch_loc, catch_lbrace_loc) = $3
    let (catch_, catch_semi_locs) = $4
    Try(
      body = $2,
      catch_~,
      try_else = None,
      has_try = true,
      try_loc = mk_loc($loc($1)),
      catch_loc~,
      else_loc = @basic.Location::{ start: @basic.Position::{ fname: "", lnum: 0, bol: 0, cnum: 0 }, end: @basic.Position::{ fname: "", lnum: 0, bol: 0, cnum: 0 } },
      catch_lbrace_loc~,
      catch_rbrace_loc = mk_loc($loc($5)),
      catch_semi_locs~,
      noraise_lbrace_loc = None,
      noraise_rbrace_loc = None,
      noraise_semi_locs = @list.empty(),
      loc = mk_loc($sloc)
    )
  }
  | "try" pipe_expr catch_keyword single_pattern_cases_with_locs "}" else_keyword single_pattern_cases_with_locs "}" {
    let (catch_loc, catch_lbrace_loc) = $3
    let (catch_, catch_semi_locs) = $4
    let (else_loc, noraise_lbrace_loc) = $6
    let (try_else, noraise_semi_locs) = $7
    Try(
      body = $2,
      catch_~,
      try_else = Some(try_else),
      has_try = true,
      try_loc = mk_loc($loc($1)),
      catch_loc~,
      else_loc~,
      catch_lbrace_loc~,
      catch_rbrace_loc = mk_loc($loc($5)),
      catch_semi_locs~,
      noraise_lbrace_loc = Some(noraise_lbrace_loc),
      noraise_rbrace_loc = Some(mk_loc($loc($8))),
      noraise_semi_locs~,
      loc = mk_loc($sloc)
    )
  }
  | "try?" pipe_expr {
    TryOperator(body = $2, kind = Question, try_loc = mk_loc($loc($1)), loc = mk_loc($sloc))
  }
  | "try!" pipe_expr {
    TryOperator(body = $2, kind = Exclamation, try_loc = mk_loc($loc($1)), loc = mk_loc($sloc))
  }
  ;

if_expr -> Expr
  : "if" infix_expr block_expr_with_locs "else" block_expr_with_locs {
    let (ifso, then_lbrace_loc, then_rbrace_loc) = $3
    let (ifnot, else_lbrace_loc, else_rbrace_loc) = $5
    If(
      cond = $2,
      ifso~,
      ifnot = Some(ifnot),
      if_loc = mk_loc($loc($1)),
      then_lbrace_loc~,
      then_rbrace_loc~,
      else_loc = Some(mk_loc($loc($4))),
      else_lbrace_loc = Some(else_lbrace_loc),
      else_rbrace_loc = Some(else_rbrace_loc),
      loc = mk_loc($sloc),
    )
  }
  | "if" infix_expr block_expr_with_locs "else" if_expr {
    let (ifso, then_lbrace_loc, then_rbrace_loc) = $3
    If(
      cond = $2,
      ifso~,
      ifnot = Some($5),
      if_loc = mk_loc($loc($1)),
      then_lbrace_loc~,
      then_rbrace_loc~,
      else_loc = Some(mk_loc($loc($4))),
      else_lbrace_loc = None,
      else_rbrace_loc = None,
      loc = mk_loc($sloc),
    )
  }
  | "if" infix_expr block_expr_with_locs {
    let (ifso, then_lbrace_loc, then_rbrace_loc) = $3
    If(
      cond = $2,
      ifso~,
      ifnot = None,
      if_loc = mk_loc($loc($1)),
      then_lbrace_loc~,
      then_rbrace_loc~,
      else_loc = None,
      else_lbrace_loc = None,
      else_rbrace_loc = None,
      loc = mk_loc($sloc),
    )
  }
  ;

match_header -> (Expr, Location)
  : "match" infix_expr "{" { ($2, mk_loc($loc($3))) }
  ;

match_expr -> Expr
  : match_header non_empty_list_semis_with_trailing_locs(single_pattern_case) "}" {
    let (expr, lbrace_loc) = $1
    let (cases, semi_locs, _) = $2
    Match(
      expr~,
      cases~,
      match_loc = mk_loc($loc($1)),
      lbrace_loc~,
      rbrace_loc = mk_loc($loc($3)),
      semi_locs~,
      loc = mk_loc($sloc)
    )
  }
  | match_header "}" {
    let (expr, lbrace_loc) = $1
    Match(
      expr~,
      cases = @list.empty(),
      match_loc = mk_loc($loc($1)),
      lbrace_loc~,
      rbrace_loc = mk_loc($loc($2)),
      semi_locs = @list.empty(),
      loc = mk_loc($sloc)
    )
  }
  ;

lexmatch_expr -> Expr:
  | lexmatch_header list_semis_with_trailing_locs(lex_case) "}" {
    let (expr, strategy, with_loc, lbrace_loc) = $1
    let (cases, semi_locs, _) = $2
    LexMatch(
      strategy~,
      expr~,
      match_loc=mk_loc($loc($1)),
      with_loc~,
      lbrace_loc~,
      rbrace_loc=mk_loc($loc($3)),
      semi_locs~,
      cases~,
      loc=mk_loc($sloc)
    )
  }

lexmatch_header -> (Expr, Label?, Location?, Location):
  | "lexmatch" infix_expr "{" {
    ($2, None, None, mk_loc($loc($3)))
  }
  | "lexmatch" infix_expr "with" label "{" {
    ($2, Some($4), Some(mk_loc($loc($3))), mk_loc($loc($5)))
  }

lex_case -> LexCase :
  | lex_pattern "=>" expr_statement {
    LexCase::{
      pat : $1,
      pat_loc : mk_loc($loc($1)),
      guard_ : None,
      body : $3,
      if_loc : None,
      fat_arrow_loc : Some(mk_loc($loc($2))),
      ellipsis_loc : None,
    }
  }
  | lex_pattern "if" infix_expr "=>" expr_statement {
    LexCase::{
      pat : $1,
      pat_loc : mk_loc($loc($1)),
      guard_ : Some($3),
      body : $5,
      if_loc : Some(mk_loc($loc($2))),
      fat_arrow_loc : Some(mk_loc($loc($4))),
      ellipsis_loc : None,
    }
  }
  | "..." {
    let pat = @list.singleton(LexTopPattern::Wildcard(loc = mk_loc($sloc)))
    LexCase::{
      pat,
      pat_loc : mk_loc($sloc),
      guard_ : None,
      body : Hole(loc=mk_loc($sloc), kind=Todo),
      if_loc : None,
      fat_arrow_loc : None,
      ellipsis_loc : Some(mk_loc($loc($1))),
    }
  }

lex_pattern -> @list.List[LexTopPattern]:
  | "(" separated_nonempty_list(",", lex_top_pattern) ")" { $2 }
  | "_" { @list.singleton(Wildcard(loc = mk_loc($sloc))) }
  | binder { @list.singleton(Binder($1)) }
  | lex_simple_atom_pattern { @list.singleton(Pattern($1)) }

lex_top_pattern -> LexTopPattern :
  | lex_as_pattern { Pattern($1) }
  | "_" { Wildcard(loc = mk_loc($sloc)) }
  | binder { Binder($1) }

lex_as_pattern -> LexPattern :
  | lex_pattern_sequence {
    let (pats, semi_locs) = $1
    match pats {
      More(pat, tail=Empty) => pat
      _ => Sequence(pats~, semi_locs~, loc=mk_loc($sloc))
    }
  }
  | lex_atom_pattern "as" binder {
    Alias(pat = $1, binder = $3, as_loc = mk_loc($loc($2)), loc = mk_loc($sloc))
  }

lex_pattern_sequence -> (List[LexPattern], List[Location]) :
  | lex_atom_pattern { (@list.singleton($1), @list.empty()) }
  | lex_atom_pattern option(SEMI) lex_pattern_sequence {
    let (pats, semi_locs) = $3
    let semi_locs = match $2 {
      Some(true) => semi_locs.add(mk_loc($loc($2)))
      _ => semi_locs
    }
    (pats.add($1), semi_locs)
  }

lex_atom_pattern -> LexPattern:
  | lex_simple_atom_pattern { $1 }
  | "(" lex_as_pattern ")" { $2 }

lex_simple_atom_pattern -> LexPattern:
  | REGEX_LITERAL {
    Regex(lit=$1, offset=3, loc=mk_loc($sloc))
  }
  | REGEX_INTERP {
    RegexInterp(elems=make_interps($1), loc=mk_loc($sloc))
  }
  | STRING {
    Regex(lit = $1, offset = 1, loc = mk_loc($sloc))
  }
  | INTERP {
    RegexInterp(elems = make_interps($1), loc = mk_loc($sloc))
  }
  | qual_uident {
    ConstantRef(lid = $1, loc = mk_loc($sloc))
  }

for_binders -> List[(Binder, Expr)]
  : list_commas_no_trailing(separated_pair(binder, "=", expr)) { $1 }
  ;

for_binder_with_equal_loc -> (Binder, Location, Expr)
  : binder "=" expr { ($1, mk_loc($loc($2)), $3) }
  ;

for_binders_with_locs -> (List[(Binder, Expr)], List[Location], List[Location])
  : list_commas_with_locs(for_binder_with_equal_loc) {
    let (bindings_with_locs, comma_locs) = $1
    let bindings = []
    let equal_locs = []
    bindings_with_locs.each(binding => {
      let (binder, equal_loc, expr) = binding
      bindings.push((binder, expr))
      equal_locs.push(equal_loc)
    })
    (@list.from_array(bindings), comma_locs, @list.from_array(equal_locs))
  }
  ;

for_binders_infix -> List[(Binder, Expr)]
  : list_commas_no_trailing(separated_pair(binder, "=", infix_expr)) { $1 }
  ;

for_binder_infix_with_equal_loc -> (Binder, Location, Expr)
  : binder "=" infix_expr { ($1, mk_loc($loc($2)), $3) }
  ;

for_binders_infix_with_locs -> (List[(Binder, Expr)], List[Location], List[Location])
  : list_commas_with_locs(for_binder_infix_with_equal_loc) {
    let (bindings_with_locs, comma_locs) = $1
    let bindings = []
    let equal_locs = []
    bindings_with_locs.each(binding => {
      let (binder, equal_loc, expr) = binding
      bindings.push((binder, expr))
      equal_locs.push(equal_loc)
    })
    (@list.from_array(bindings), comma_locs, @list.from_array(equal_locs))
  }
  ;

list_comp_for_header -> (
  List[(Binder, Expr)],
  Expr?,
  List[(Binder, Expr)],
  List[Location],
  List[Location],
  List[Location],
  List[Location],
  List[Location]
)
  : for_binders_infix_with_locs {
    let (binders, binder_comma_locs, binder_equal_locs) = $1
    (
      binders,
      None,
      @list.empty(),
      binder_comma_locs,
      @list.empty(),
      binder_equal_locs,
      @list.empty(),
      @list.empty(),
    )
  }
  | for_binders_infix_with_locs SEMI option(infix_expr) {
    let (binders, binder_comma_locs, binder_equal_locs) = $1
    (
      binders,
      $3,
      @list.empty(),
      binder_comma_locs,
      @list.singleton(mk_loc($loc($2))),
      binder_equal_locs,
      @list.empty(),
      @list.empty(),
    )
  }
  | for_binders_infix_with_locs SEMI option(infix_expr) SEMI for_binders_infix_with_locs {
    let (binders, binder_comma_locs, binder_equal_locs) = $1
    let (continue_block, continue_comma_locs, continue_equal_locs) = $5
    (
      binders,
      $3,
      continue_block,
      binder_comma_locs,
      @list.from_array([mk_loc($loc($2)), mk_loc($loc($4))]),
      binder_equal_locs,
      continue_comma_locs,
      continue_equal_locs,
    )
  }
  ;

optional_nobreak -> Expr?
  : "nobreak" block_expr { Some($2) }
  |  { None }
  ;

optional_nobreak_with_locs -> (Expr?, Location?, Location?, Location?)
  : "nobreak" block_expr_with_locs {
    let (expr, lbrace_loc, rbrace_loc) = $2
    (Some(expr), Some(mk_loc($loc($1))), Some(lbrace_loc), Some(rbrace_loc))
  }
  |  { (None, None, None, None) }
  ;

optional_where_clause -> WhereClause?
  : "where" "{" list_commas_with_trailing_locs(labeled_expr) "}" {
    let (fields, comma_locs, _) = $3
    Some({
      fields,
      where_loc : mk_loc($loc($1)),
      lbrace_loc : mk_loc($loc($2)),
      rbrace_loc : mk_loc($loc($4)),
      comma_locs,
      loc : mk_loc($sloc),
    })
  }
  | { None }

for_expr -> Expr
  : loop_label_colon_with_loc "for" for_binders_with_locs SEMI option(infix_expr) SEMI for_binders_with_locs block_expr_with_locs optional_nobreak_with_locs optional_where_clause {
    let (label, label_colon_loc) = $1
    let (binders, binder_comma_locs, binder_equal_locs) = $3
    let (continue_block, continue_comma_locs, continue_equal_locs) = $7
    let (body, body_lbrace_loc, body_rbrace_loc) = $8
    let (for_else, nobreak_loc, nobreak_lbrace_loc, nobreak_rbrace_loc) = $9
    For(
      binders~,
      condition = $5,
      continue_block~,
      body~,
      for_else~,
      loc = mk_loc($sloc),
      where_clause = $10,
      label~,
      label_colon_loc~,
      for_loc = mk_loc($loc($2)),
      binder_comma_locs~,
      binder_equal_locs~,
      semi_locs = @list.from_array([mk_loc($loc($4)), mk_loc($loc($6))]),
      continue_comma_locs~,
      continue_equal_locs~,
      body_lbrace_loc~,
      body_rbrace_loc~,
      nobreak_loc~,
      nobreak_lbrace_loc~,
      nobreak_rbrace_loc~,
    )
  }
  | loop_label_colon_with_loc "for" for_binders_with_locs SEMI infix_expr block_expr_with_locs optional_nobreak_with_locs optional_where_clause {
    let (label, label_colon_loc) = $1
    let (binders, binder_comma_locs, binder_equal_locs) = $3
    let (body, body_lbrace_loc, body_rbrace_loc) = $6
    let (for_else, nobreak_loc, nobreak_lbrace_loc, nobreak_rbrace_loc) = $7
    For(
      binders~,
      condition = Some($5),
      continue_block = @list.empty(),
      body~,
      for_else~,
      loc = mk_loc($sloc),
      where_clause = $8,
      label~,
      label_colon_loc~,
      for_loc = mk_loc($loc($2)),
      binder_comma_locs~,
      binder_equal_locs~,
      semi_locs = @list.singleton(mk_loc($loc($4))),
      continue_comma_locs = @list.empty(),
      continue_equal_locs = @list.empty(),
      body_lbrace_loc~,
      body_rbrace_loc~,
      nobreak_loc~,
      nobreak_lbrace_loc~,
      nobreak_rbrace_loc~,
    )
  }
  | loop_label_colon_with_loc "for" for_binders_with_locs block_expr_with_locs optional_nobreak_with_locs optional_where_clause {
    let (label, label_colon_loc) = $1
    let (binders, binder_comma_locs, binder_equal_locs) = $3
    let (body, body_lbrace_loc, body_rbrace_loc) = $4
    let (for_else, nobreak_loc, nobreak_lbrace_loc, nobreak_rbrace_loc) = $5
    For(
      binders~,
      condition = None,
      continue_block = @list.empty(),
      body~,
      for_else~,
      loc = mk_loc($sloc),
      where_clause = $6,
      label~,
      label_colon_loc~,
      for_loc = mk_loc($loc($2)),
      binder_comma_locs~,
      binder_equal_locs~,
      semi_locs = @list.empty(),
      continue_comma_locs = @list.empty(),
      continue_equal_locs = @list.empty(),
      body_lbrace_loc~,
      body_rbrace_loc~,
      nobreak_loc~,
      nobreak_lbrace_loc~,
      nobreak_rbrace_loc~,
    )
  }
  ;

foreach_expr -> Expr
  : loop_label_colon_with_loc "for" non_empty_list_commas_with_locs(foreach_binder) "in" expr foreach_optional_loop_vars_with_locs block_expr_with_locs optional_nobreak_with_locs optional_where_clause {
    let (label, label_colon_loc) = $1
    let (binders, binder_comma_locs) = $3
    let (
      init,
      continue_block,
      semi_locs,
      init_comma_locs,
      init_equal_locs,
      continue_comma_locs,
      continue_equal_locs,
    ) = $6
    let (body, body_lbrace_loc, body_rbrace_loc) = $7
    let (else_block, nobreak_loc, nobreak_lbrace_loc, nobreak_rbrace_loc) = $8
    ForEach(
      binders~,
      expr = $5,
      init~,
      continue_block~,
      body~,
      else_block~,
      where_clause = $9,
      label~,
      label_colon_loc~,
      for_loc = mk_loc($loc($2)),
      binder_comma_locs~,
      in_loc = mk_loc($loc($4)),
      semi_locs~,
      init_comma_locs~,
      init_equal_locs~,
      continue_comma_locs~,
      continue_equal_locs~,
      body_lbrace_loc~,
      body_rbrace_loc~,
      nobreak_loc~,
      nobreak_lbrace_loc~,
      nobreak_rbrace_loc~,
      loc = mk_loc($sloc)
    )
  }
  ;

foreach_optional_loop_vars -> (List[(Binder, Expr)], List[(Binder, Expr)])
  : { (@list.empty(), @list.empty()) }
  | SEMI for_binders { ($2, @list.empty()) }
  | SEMI for_binders SEMI for_binders { ($2, $4) }
  ;

foreach_optional_loop_vars_infix -> (List[(Binder, Expr)], List[(Binder, Expr)])
  : { (@list.empty(), @list.empty()) }
  | SEMI for_binders_infix { ($2, @list.empty()) }
  | SEMI for_binders_infix SEMI for_binders_infix { ($2, $4) }
  ;

foreach_optional_loop_vars_with_locs -> (
  List[(Binder, Expr)],
  List[(Binder, Expr)],
  List[Location],
  List[Location],
  List[Location],
  List[Location],
  List[Location]
)
  : { (
    @list.empty(),
    @list.empty(),
    @list.empty(),
    @list.empty(),
    @list.empty(),
    @list.empty(),
    @list.empty(),
  ) }
  | SEMI for_binders_with_locs {
    let (init, init_comma_locs, init_equal_locs) = $2
    (
      init,
      @list.empty(),
      @list.singleton(mk_loc($loc($1))),
      init_comma_locs,
      init_equal_locs,
      @list.empty(),
      @list.empty(),
    )
  }
  | SEMI for_binders_with_locs SEMI for_binders_with_locs {
    let (init, init_comma_locs, init_equal_locs) = $2
    let (continue_block, continue_comma_locs, continue_equal_locs) = $4
    (
      init,
      continue_block,
      @list.from_array([mk_loc($loc($1)), mk_loc($loc($3))]),
      init_comma_locs,
      init_equal_locs,
      continue_comma_locs,
      continue_equal_locs,
    )
  }
  ;

foreach_optional_loop_vars_infix_with_locs -> (
  List[(Binder, Expr)],
  List[(Binder, Expr)],
  List[Location],
  List[Location],
  List[Location],
  List[Location],
  List[Location]
)
  : { (
    @list.empty(),
    @list.empty(),
    @list.empty(),
    @list.empty(),
    @list.empty(),
    @list.empty(),
    @list.empty(),
  ) }
  | SEMI for_binders_infix_with_locs {
    let (init, init_comma_locs, init_equal_locs) = $2
    (
      init,
      @list.empty(),
      @list.singleton(mk_loc($loc($1))),
      init_comma_locs,
      init_equal_locs,
      @list.empty(),
      @list.empty(),
    )
  }
  | SEMI for_binders_infix_with_locs SEMI for_binders_infix_with_locs {
    let (init, init_comma_locs, init_equal_locs) = $2
    let (continue_block, continue_comma_locs, continue_equal_locs) = $4
    (
      init,
      continue_block,
      @list.from_array([mk_loc($loc($1)), mk_loc($loc($3))]),
      init_comma_locs,
      init_equal_locs,
      continue_comma_locs,
      continue_equal_locs,
    )
  }
  ;

list_comp_guard -> (Expr?, Location?)
  : "if" infix_expr { (Some($2), Some(mk_loc($loc($1)))) }
  |  { (None, None) }
  ;

foreach_binder -> Binder?
  : binder { Some($1)}
  | "_" { None }
  ;

expr -> Expr
  : for_expr { $1 }
  | foreach_expr { $1 }
  | while_expr { $1 }
  | try_expr { $1 }
  | if_expr { $1 }
  | match_expr { $1 }
  | lexmatch_expr { $1 }
  | simple_try_expr { $1 }
  | quantifier_expr { $1 }
  | arrow_fn_expr { Function(func = $1, loc = mk_loc($sloc)) }
  ;

simple_try_expr -> Expr
  : pipe_expr catch_keyword single_pattern_cases_with_locs "}" {
    let (catch_loc, catch_lbrace_loc) = $2
    let (catch_, catch_semi_locs) = $3
    Try(
      body = $1,
      catch_~,
      try_else = None,
      has_try = false,
      try_loc = mk_loc($loc($1)),
      catch_loc~,
      else_loc = Location::{ start: Position::{ fname: "", lnum: 0, bol: 0, cnum: 0 }, end: Position::{ fname: "", lnum: 0, bol: 0, cnum: 0 } },
      catch_lbrace_loc~,
      catch_rbrace_loc = mk_loc($loc($4)),
      catch_semi_locs~,
      noraise_lbrace_loc = None,
      noraise_rbrace_loc = None,
      noraise_semi_locs = @list.empty(),
      loc = mk_loc($sloc)
    )
  }
  | pipe_expr catch_keyword single_pattern_cases_with_locs "}" else_keyword single_pattern_cases_with_locs "}" {
    let (catch_loc, catch_lbrace_loc) = $2
    let (catch_, catch_semi_locs) = $3
    let (else_loc, noraise_lbrace_loc) = $5
    let (try_else, noraise_semi_locs) = $6
    Try(
      body = $1,
      catch_~,
      try_else = Some(try_else),
      has_try = false,
      try_loc = mk_loc($loc($1)),
      catch_loc~,
      else_loc~,
      catch_lbrace_loc~,
      catch_rbrace_loc = mk_loc($loc($4)),
      catch_semi_locs~,
      noraise_lbrace_loc = Some(noraise_lbrace_loc),
      noraise_rbrace_loc = Some(mk_loc($loc($7))),
      noraise_semi_locs~,
      loc = mk_loc($sloc)
    )
  }
  | pipe_expr { $1 }
  ;

arrow_fn_with_explicit_braces -> Func
  : "(" arrow_fn_prefix "=>" "{" list_semis_rev(statement) "}" {
    let body = Statement::compact_rev($5, loc = mk_loc($loc($4)).merge(mk_loc($loc($6))))
    make_arrow_fn(
      $2,
      body,
      params_loc = mk_loc($loc($1)).merge(mk_loc($loc($2))),
      fat_arrow_loc = Some(mk_loc($loc($3))),
      body_lbrace_loc = Some(mk_loc($loc($4))),
      body_rbrace_loc = Some(mk_loc($loc($6))),
      loc = mk_loc($sloc),
    )
  }
  | "(" ")" "=>" "{" list_semis_rev(statement) "}" {
    let body = Statement::compact_rev($5, loc = mk_loc($loc($4)).merge(mk_loc($loc($6))))
    make_arrow_fn(
      @list.empty(),
      body,
      params_loc = mk_loc($loc($1)).merge(mk_loc($loc($2))),
      lparen_loc = Some(mk_loc($loc($1))),
      rparen_loc = Some(mk_loc($loc($2))),
      fat_arrow_loc = Some(mk_loc($loc($3))),
      body_lbrace_loc = Some(mk_loc($loc($4))),
      body_rbrace_loc = Some(mk_loc($loc($6))),
      loc = mk_loc($sloc),
    )
  }
  | binder "=>" "{" list_semis_rev(statement) "}" {
    let body = Statement::compact_rev($4, loc = mk_loc($loc($3)).merge(mk_loc($loc($5))))
    make_arrow_fn(
      @list.singleton((Named($1), None)),
      body,
      params_loc = mk_loc($loc($1)),
      fat_arrow_loc = Some(mk_loc($loc($2))),
      body_lbrace_loc = Some(mk_loc($loc($3))),
      body_rbrace_loc = Some(mk_loc($loc($5))),
      loc = mk_loc($sloc),
    )
  }
  | "_" "=>" "{" list_semis_rev(statement) "}" {
    let body = Statement::compact_rev($4, loc = mk_loc($loc($3)).merge(mk_loc($loc($5))))
    make_arrow_fn(
      @list.singleton((Unnamed(mk_loc($loc($1))), None)),
      body,
      params_loc = mk_loc($loc($1)),
      fat_arrow_loc = Some(mk_loc($loc($2))),
      body_lbrace_loc = Some(mk_loc($loc($3))),
      body_rbrace_loc = Some(mk_loc($loc($5))),
      loc = mk_loc($sloc),
    )
  }
  ;

arrow_fn_expr -> Func
  : "(" arrow_fn_prefix "=>" expr_statement_no_break_continue_return {
    make_arrow_fn(
      $2,
      $4,
      params_loc = mk_loc($loc($1)).merge(mk_loc($loc($2))),
      fat_arrow_loc = Some(mk_loc($loc($3))),
      loc = mk_loc($sloc),
    )
  }
  | "(" ")" "=>" expr_statement_no_break_continue_return {
    make_arrow_fn(
      @list.empty(),
      $4,
      params_loc = mk_loc($loc($1)).merge(mk_loc($loc($2))),
      lparen_loc = Some(mk_loc($loc($1))),
      rparen_loc = Some(mk_loc($loc($2))),
      fat_arrow_loc = Some(mk_loc($loc($3))),
      loc = mk_loc($sloc),
    )
  }
  | binder "=>" expr_statement_no_break_continue_return {
    make_arrow_fn(
      @list.singleton((Named($1), None)),
      $3,
      params_loc = mk_loc($loc($1)),
      fat_arrow_loc = Some(mk_loc($loc($2))),
      loc = mk_loc($sloc),
    )
  }
  | "_" "=>" expr_statement_no_break_continue_return {
    make_arrow_fn(
      @list.singleton((Unnamed(mk_loc($loc($1))), None)),
      $3,
      params_loc = mk_loc($loc($1)),
      fat_arrow_loc = Some(mk_loc($loc($2))),
      loc = mk_loc($sloc),
    )
  }
  ;

arrow_fn_prefix -> List[(ArrowFnParam, Type?)]
  : binder ioption(",") ")" { @list.singleton((Named($1), None)) }
  | "_" ioption(",") ")" { @list.singleton((Unnamed(mk_loc($loc($1))), None)) }
  | binder ":" type_ ioption(",") ")" { @list.singleton((Named($1), Some($3))) }
  | "_" ":" type_ ioption(",") ")" { @list.singleton((Unnamed(mk_loc($loc($1))), Some($3))) }
  | binder "," arrow_fn_prefix { $3.add((Named($1), None)) }
  | "_" "," arrow_fn_prefix { $3.add((Unnamed(mk_loc($loc($1))), None)) }
  | binder ":" type_ "," arrow_fn_prefix { $5.add((Named($1), Some($3))) }
  | "_" ":" type_ "," arrow_fn_prefix { $5.add((Unnamed(mk_loc($loc($1))), Some($3))) }
  ;

arrow_fn_prefix_no_constraint -> (List[ArrowFnParam], List[Location], Location)
  : binder ")" { (@list.singleton(Named($1)), @list.empty(), mk_loc($loc($2))) }
  | binder "," ")" {
    (@list.singleton(Named($1)), @list.singleton(mk_loc($loc($2))), mk_loc($loc($3)))
  }
  | "_" ")" {
    (@list.singleton(Unnamed(mk_loc($loc($1)))), @list.empty(), mk_loc($loc($2)))
  }
  | "_" "," ")" {
    (
      @list.singleton(Unnamed(mk_loc($loc($1)))),
      @list.singleton(mk_loc($loc($2))),
      mk_loc($loc($3)),
    )
  }
  | binder "," arrow_fn_prefix_no_constraint {
    let (params, comma_locs, rparen_loc) = $3
    (params.add(Named($1)), comma_locs.add(mk_loc($loc($2))), rparen_loc)
  }
  | "_" "," arrow_fn_prefix_no_constraint {
    let (params, comma_locs, rparen_loc) = $3
    (
      params.add(Unnamed(mk_loc($loc($1)))),
      comma_locs.add(mk_loc($loc($2))),
      rparen_loc,
    )
  }
  ;

backward_pipeline_rhs -> Expr
  : arrow_fn_with_explicit_braces { Function(func = $1, loc = mk_loc($sloc)) }
  | infix_expr { $1 }
  ;

pipe_expr -> Expr
  : pipe_expr "<|" backward_pipeline_rhs {
    RevPipe(
      lhs = $1,
      rhs = $3,
      rev_pipe_loc = mk_loc($loc($2)),
      loc = mk_loc($sloc),
    )
  }
  | pipe_expr "|>" infix_expr {
    Pipe(
      lhs = $1,
      rhs = $3,
      pipe_loc = mk_loc($loc($2)),
      loc = mk_loc($sloc),
    )
  }
  | pipe_expr "|>" binder "=>" block_expr {
    let params_loc = mk_loc($loc($3))
    let fn_loc = mk_loc($loc($3)).merge(mk_loc($loc($5)))
    let func = make_arrow_fn(@list.singleton((Named($3), None)), $5, params_loc~, loc = fn_loc)
    let rhs = Expr::Function(func~, loc = fn_loc)
    Pipe(
      lhs = $1,
      rhs~,
      pipe_loc = mk_loc($loc($2)),
      loc = mk_loc($sloc),
    )
  }
  | infix_expr { $1 }
  ;

quantifier_expr -> Expr
  : "∀" binder ":" type_ "," quantifier_body_expr {
    Quantifier(
      kind = Forall,
      binder = $2,
      binder_ty = $4,
      body = $6,
      quantifier_loc = mk_loc($loc($1)),
      colon_loc = mk_loc($loc($3)),
      comma_loc = mk_loc($loc($5)),
      loc = mk_loc($sloc),
    )
  }
  | "∃" binder ":" type_ "," quantifier_body_expr {
    Quantifier(
      kind = Exists,
      binder = $2,
      binder_ty = $4,
      body = $6,
      quantifier_loc = mk_loc($loc($1)),
      colon_loc = mk_loc($loc($3)),
      comma_loc = mk_loc($loc($5)),
      loc = mk_loc($sloc),
    )
  }
  ;

quantifier_body_expr -> Expr
  : quantifier_expr { $1 }
  | infix_expr { $1 }
  ;

infix_expr -> Expr
  : infix_expr "→" infix_expr {
    Implies(
      lhs = $1,
      rhs = $3,
      implies_loc = mk_loc($loc($2)),
      loc = mk_loc($sloc),
    )
  }
  | infix_expr infixop infix_expr {
    Infix(op = $2, lhs = $1, rhs = $3, loc = mk_loc($sloc))
  }
  | postfix_expr { $1 }
  ;

postfix_expr -> Expr
  : range_expr "as" type_name {
    As(expr = $1, trait_ = $3, as_loc = mk_loc($loc($2)), loc = mk_loc($sloc))
  }
  | range_expr "is" range_pattern {
    Is(expr = $1, pat = $3, is_loc = mk_loc($loc($2)), loc = mk_loc($sloc))
  }
  | range_expr "lexmatch?" lex_pattern %prec prec_LEXMATCH_QUESTION {
    IsLexMatch(
      expr=$1,
      pat=$3,
      pat_loc=mk_loc($loc($3)),
      strategy = None,
      lexmatch_question_loc = mk_loc($loc($2)),
      with_loc = None,
      loc=mk_loc($sloc),
    )
  }
  | range_expr "lexmatch?" lex_pattern "with" label {
    IsLexMatch(
      expr=$1,
      pat=$3,
      pat_loc=mk_loc($loc($3)),
      strategy = Some($5),
      lexmatch_question_loc = mk_loc($loc($2)),
      with_loc = Some(mk_loc($loc($4))),
      loc=mk_loc($sloc),
    )
  }
  | range_expr "=~" regex_match_rhs {
    let (
      pat,
      bindings,
      rhs_lparen_loc,
      rhs_rparen_loc,
      binding_comma_locs,
      binding_equal_locs,
    ) = $3
    RegexMatch(
      expr = $1,
      pat~,
      bindings~,
      eq_tilde_loc = mk_loc($loc($2)),
      rhs_lparen_loc~,
      rhs_rparen_loc~,
      binding_comma_locs~,
      binding_equal_locs~,
      loc = mk_loc($sloc),
    )
  }
  | range_expr "<+" template_rhs {
    TemplateWriting(expr = $1, template = $3, lt_plus_loc = mk_loc($loc($2)), loc = mk_loc($sloc))
  }
  | range_expr { $1 }
  ;

regex_match_rhs -> (RegexPattern, List[(Label, Binder?)], Location?, Location?, List[Location], List[Location])
  : regex_atom_pattern {
    ($1, @list.empty(), None, None, @list.empty(), @list.empty())
  }
  | "(" regex_as_pattern "," list_commas_with_trailing_locs(regex_match_binding) ")" {
    let (bindings_with_locs, comma_locs, _) = $4
    let bindings = []
    let binding_equal_locs = []
    bindings_with_locs.each(binding => {
      let (label, equal_loc, binder) = binding
      bindings.push((label, binder))
      match equal_loc {
        Some(loc) => binding_equal_locs.push(loc)
        None => ()
      }
    })
    (
      $2,
      @list.from_array(bindings),
      Some(mk_loc($loc($1))),
      Some(mk_loc($loc($5))),
      comma_locs.add(mk_loc($loc($3))),
      @list.from_array(binding_equal_locs),
    )
  }
  ;

regex_match_binding -> (Label, Location?, Binder?)
  : LIDENT "=" binder {
    let label = Label::{ name : $1, loc : mk_loc($loc($1)) }
    (label, Some(mk_loc($loc($2))), Some($3))
  }
  | POST_LABEL {
    let label = Label::{ name : $1, loc : mk_loc($loc($1)) }
    (label, None, None)
  }
  ;

regex_as_pattern -> RegexPattern
  : regex_or_pattern { $1 }
  | regex_atom_pattern "as" binder {
    RegexPattern::Alias(
      pat = $1,
      binder = $3,
      as_loc = mk_loc($loc($2)),
      loc = mk_loc($sloc),
    )
  }
  ;

regex_or_pattern -> RegexPattern
  : regex_sequence_pattern { $1 }
  | regex_or_pattern "|" regex_sequence_pattern {
    RegexPattern::Alternation(
      pat1 = $1,
      pat2 = $3,
      bar_loc = mk_loc($loc($2)),
      loc = mk_loc($sloc),
    )
  }
  ;

regex_sequence_pattern -> RegexPattern
  : regex_atom_pattern { $1 }
  | regex_sequence_pattern "+" regex_atom_pattern {
    RegexPattern::Sequence(
      pat1 = $1,
      pat2 = $3,
      plus_loc = mk_loc($loc($2)),
      loc = mk_loc($sloc),
    )
  }
  ;

regex_atom_pattern -> RegexPattern
  : REGEX_LITERAL {
    RegexPattern::Literal(lit = $1, loc = mk_loc($loc($1)))
  }
  | qual_uident {
    RegexPattern::Reference(lid = $1, loc = mk_loc($sloc))
  }
  | "(" regex_as_pattern ")" { $2 }
  ;

range_expr -> Expr
  : prefix_expr "..<" prefix_expr {
    Infix(
      op = Var::{ name: Ident(name = "..<"), loc: mk_loc($loc($2)) },
      lhs = $1,
      rhs = $3,
      loc = mk_loc($sloc)
    )
  }
  | prefix_expr "..=" prefix_expr {
    Infix(
      op = Var::{ name: Ident(name = "..="), loc: mk_loc($loc($2)) },
      lhs = $1,
      rhs = $3,
      loc = mk_loc($sloc)
    )
  }
  | prefix_expr "..<=" prefix_expr {
    Infix(
      op = Var::{ name: Ident(name = "..<="), loc: mk_loc($loc($2)) },
      lhs = $1,
      rhs = $3,
      loc = mk_loc($sloc)
    )
  }
  | prefix_expr ">=.." prefix_expr {
    Infix(
      op = Var::{ name: Ident(name = ">=.."), loc: mk_loc($loc($2)) },
      lhs = $1,
      rhs = $3,
      loc = mk_loc($sloc)
    )
  }
  | prefix_expr ">.." prefix_expr {
    Infix(
      op = Var::{ name: Ident(name = ">.."), loc: mk_loc($loc($2)) },
      lhs = $1,
      rhs = $3,
      loc = mk_loc($sloc)
    )
  }
  | prefix_expr { $1 }
  ;

prefix_expr -> Expr
  : id(plus) prefix_expr { make_uplus(loc = mk_loc($sloc), $1, $2) }
  | id(minus) prefix_expr { make_uminus(loc = mk_loc($sloc), $1, $2) }
  | "!" prefix_expr { make_unot(loc = mk_loc($sloc), $2) }
  | simple_expr { $1 }
  ;

%inline plus -> String
  : PLUS { "+" }
  ;

%inline minus -> String
  : MINUS { "-" }
  ;

left_value -> LeftValue
  : var { Var($1) }
  | simple_expr accessor { Field($1, $2) }
  | simple_expr "[" expr "]" {
    Array($1, $3, mk_loc($loc($2)), mk_loc($loc($4)))
  }
  ;

constr -> Constructor
  : UIDENT {
    Constructor::{
      name: ConstrName::{ name: $1, loc: mk_loc($loc($1)) },
      extra_info: NoExtraInfo,
      loc: mk_loc($sloc)
    }
  }
  | PACKAGE_NAME DOT_UIDENT {
    Constructor::{
      name: ConstrName::{ name: $2, loc: mk_loc($loc($2)) },
      extra_info: Package(
        pkg = $1,
        pkg_loc = mk_loc($loc($1)),
        dot_constr_loc = mk_loc($loc($2)),
      ),
      loc: mk_loc($sloc)
    }
  }
  | type_name "::" UIDENT {
    Constructor::{
      name: ConstrName::{ name: $3, loc: mk_loc($loc($3)) },
      extra_info: TypeName(type_name = $1, coloncolon_loc = mk_loc($loc($2))),
      loc: mk_loc($sloc)
    }
  }
  | type_name "::" PACKAGE_NAME DOT_UIDENT {
    Constructor::{
      name: ConstrName::{ name: $4, loc: mk_loc($loc($4)) },
      extra_info: TypeNameWithConstrPackage(
        type_name = $1,
        pkg = $3,
        coloncolon_loc = mk_loc($loc($2)),
        pkg_loc = mk_loc($loc($3)),
        dot_constr_loc = mk_loc($loc($4)),
      ),
      loc: mk_loc($sloc)
    }
  }
  ;

non_empty_tuple_elems -> (List[Expr], List[Location], Location)
  : expr ")" { (@list.singleton($1), @list.empty(), mk_loc($loc($2))) }
  | expr "," ")" {
    (@list.singleton($1), @list.singleton(mk_loc($loc($2))), mk_loc($loc($3)))
  }
  | expr "," non_empty_tuple_elems {
    let (exprs, comma_locs, rparen_loc) = $3
    (exprs.add($1), comma_locs.add(mk_loc($loc($2))), rparen_loc)
  }
  ;

non_empty_tuple_elems_with_prefix -> (List[Expr], List[Location], Location)
  : binder "," non_empty_tuple_elems_with_prefix {
    let (exprs, comma_locs, rparen_loc) = $3
    (exprs.add(@syntax.binder_to_expr($1)), comma_locs.add(mk_loc($loc($2))), rparen_loc)
  }
  | "_" "," non_empty_tuple_elems_with_prefix {
    let (exprs, comma_locs, rparen_loc) = $3
    (
      exprs.add(Expr::Hole(loc = mk_loc($loc($1)), kind = Incomplete)),
      comma_locs.add(mk_loc($loc($2))),
      rparen_loc,
    )
  }
  | non_empty_tuple_elems { $1 }
  ;

tuple_expr -> Expr
  : "(" arrow_fn_prefix_no_constraint {
    let (params, comma_locs, rparen_loc) = $2
    let lparen_loc = mk_loc($loc($1))
    let es = params.map(@syntax.arrow_fn_param_to_expr)
    match es {
      @list.More(expr, tail=Empty) => {
        match expr {
          Constraint(..) => expr
          _ =>
            Group(
              expr~,
              group = Paren,
              left_delim_loc = lparen_loc,
              right_delim_loc = rparen_loc,
              loc = mk_loc($sloc),
            )
        }
      }
      _ => @syntax.make_tuple_expr(
        loc = mk_loc($sloc),
        lparen_loc~,
        rparen_loc~,
        comma_locs~,
        es,
      )
    }
  }
  | "(" non_empty_tuple_elems_with_prefix {
    let (exprs, comma_locs, rparen_loc) = $2
    let lparen_loc = mk_loc($loc($1))
    match exprs {
      More(expr, tail=Empty) =>
        Group(
          expr~,
          group = Paren,
          left_delim_loc = lparen_loc,
          right_delim_loc = rparen_loc,
          loc = mk_loc($sloc),
        )
      exprs => @syntax.make_tuple_expr(
        loc = mk_loc($sloc),
        lparen_loc~,
        rparen_loc~,
        comma_locs~,
        exprs,
      )
    }
  }
  | "(" binder ":" type_ ")" {
    Constraint(
      expr = @syntax.binder_to_expr($2),
      ty = $4,
      lparen_loc = Some(mk_loc($loc($1))),
      colon_loc = mk_loc($loc($3)),
      rparen_loc = Some(mk_loc($loc($5))),
      loc = mk_loc($sloc),
    )
  }
  | "(" "_" ":" type_ ")" {
    Constraint(
      expr = Hole(loc = mk_loc($loc($2)), kind = Incomplete),
      ty = $4,
      lparen_loc = Some(mk_loc($loc($1))),
      colon_loc = mk_loc($loc($3)),
      rparen_loc = Some(mk_loc($loc($5))),
      loc = mk_loc($sloc),
    )
  }
  | "(" expr ":" type_ ")" {
    Constraint(
      expr = $2,
      ty = $4,
      lparen_loc = Some(mk_loc($loc($1))),
      colon_loc = mk_loc($loc($3)),
      rparen_loc = Some(mk_loc($loc($5))),
      loc = mk_loc($sloc),
    )
  }
  | "(" ")" {
    Unit(
      loc = mk_loc($sloc),
      faked = false,
      lparen_loc = mk_loc($loc($1)),
      rparen_loc = mk_loc($loc($2)),
    )
  }
  ;

anony_fn -> Func
  : is_async "fn" parameters_with_locs func_return_type_with_loc block_expr_with_locs {
    let (parameters, lparen_loc, rparen_loc, comma_locs) = $3
    let (return_type, error_type, return_arrow_loc) = $4
    let (body, body_lbrace_loc, body_rbrace_loc) = $5
    Func::{
      parameters,
      params_loc : lparen_loc.merge(rparen_loc),
      body,
      return_type,
      error_type,
      kind : Lambda,
      is_async : $1,
      fn_loc : Some(mk_loc($loc($2))),
      lparen_loc : Some(lparen_loc),
      rparen_loc : Some(rparen_loc),
      comma_locs,
      return_arrow_loc,
      fat_arrow_loc : None,
      body_lbrace_loc : Some(body_lbrace_loc),
      body_rbrace_loc : Some(body_rbrace_loc),
      loc : mk_loc($sloc)
    }
  }
  ;

simple_expr -> Expr
  : "{" record_defn "}" {
    let (fs, trailing, comma_locs, semi_locs) = $2
    @syntax.make_record_expr(
      loc = mk_loc($sloc),
      trailing~,
      lbrace_loc = mk_loc($loc($1)),
      rbrace_loc = mk_loc($loc($3)),
      comma_locs~,
      semi_locs~,
      None,
      fs,
    )
  }
  | type_name COLONCOLON "{" list_commas_with_trailing_locs(record_defn_single) "}" {
    let (fs, comma_locs, trailing) = $4
    let trailing_mark = if trailing { TrailingMark::Comma } else { TrailingMark::None }
    @syntax.make_record_expr(
      loc = mk_loc($sloc),
      trailing = trailing_mark,
      coloncolon_loc = Some(mk_loc($loc($2))),
      lbrace_loc = mk_loc($loc($3)),
      rbrace_loc = mk_loc($loc($5)),
      comma_locs~,
      Some($1),
      fs,
    )
  }
  | "{" ".." expr "}" {
    RecordUpdate(
      type_name = None,
      record = $3,
      fields = @list.empty(),
      coloncolon_loc = None,
      lbrace_loc = mk_loc($loc($1)),
      dotdot_loc = mk_loc($loc($2)),
      rbrace_loc = mk_loc($loc($4)),
      comma_locs = @list.empty(),
      loc = mk_loc($sloc),
    )
  }
  | type_name "::" "{" ".." expr "}" {
    RecordUpdate(
      type_name = Some($1),
      record = $5,
      fields = @list.empty(),
      coloncolon_loc = Some(mk_loc($loc($2))),
      lbrace_loc = mk_loc($loc($3)),
      dotdot_loc = mk_loc($loc($4)),
      rbrace_loc = mk_loc($loc($6)),
      comma_locs = @list.empty(),
      loc = mk_loc($sloc),
    )
  }
  | "{" ".." expr "," list_commas_with_trailing_locs(record_defn_single) "}" {
    let (fields, comma_locs, _) = $5
    RecordUpdate(
      type_name = None,
      record = $3,
      fields~,
      coloncolon_loc = None,
      lbrace_loc = mk_loc($loc($1)),
      dotdot_loc = mk_loc($loc($2)),
      rbrace_loc = mk_loc($loc($6)),
      comma_locs = comma_locs.add(mk_loc($loc($4))),
      loc = mk_loc($sloc),
    )
  }
  | type_name "::" "{" ".." expr "," list_commas_with_trailing_locs(record_defn_single) "}" {
    let (fields, comma_locs, _) = $7
    RecordUpdate(
      type_name = Some($1),
      record = $5,
      fields~,
      coloncolon_loc = Some(mk_loc($loc($2))),
      lbrace_loc = mk_loc($loc($3)),
      dotdot_loc = mk_loc($loc($4)),
      rbrace_loc = mk_loc($loc($8)),
      comma_locs = comma_locs.add(mk_loc($loc($6))),
      loc = mk_loc($sloc),
    )
  }
  | "{" semi_expr_semi_opt "}" {
    let (expr, trailing, semi_locs) = $2
    match expr {
      Ident(id = { name: Ident(name~), loc }, ..) => {
        let label = Label::{ name, loc }
        let field = @syntax.make_field_def(loc~, label, expr, true)
        let trailing_mark = if trailing { TrailingMark::Semi } else { TrailingMark::None }
        @syntax.make_record_expr(
          loc = mk_loc($sloc),
          trailing = trailing_mark,
          lbrace_loc = mk_loc($loc($1)),
          rbrace_loc = mk_loc($loc($3)),
          semi_locs~,
          None,
          @list.singleton(field),
        )
      }
      _ =>
        Group(
          expr~,
          group = Brace,
          left_delim_loc = mk_loc($loc($1)),
          right_delim_loc = mk_loc($loc($3)),
          loc = mk_loc($sloc),
        )
    }
  }
  | "{" list_commas_with_trailing_locs(map_expr_elem) "}" {
    let (elems, comma_locs, _) = $2
    Map(
      elems~,
      lbrace_loc = mk_loc($loc($1)),
      rbrace_loc = mk_loc($loc($3)),
      comma_locs~,
      loc = mk_loc($sloc),
    )
  }
  | anony_fn { Function(func = $1, loc = mk_loc($sloc)) }
  | atomic_expr { $1 }
  | "_" %prec prec_lower_than_arrow_fn { Hole(loc = mk_loc($sloc), kind = Incomplete) }
  | qual_ident_simple_expr { @syntax.make_ident_expr(loc = mk_loc($sloc), Var::{ name: $1, loc: mk_loc($sloc) }) }
  | constr { Constr(constr = $1, loc = mk_loc($sloc)) }
  | simple_expr "(" list_commas_with_trailing_locs(argument) ")" {
    let (args, comma_locs, _) = $3
    Apply(
      func = $1,
      args~,
      lparen_loc = mk_loc($loc($2)),
      rparen_loc = mk_loc($loc($4)),
      comma_locs~,
      loc = mk_loc($sloc),
    )
  }
  | simple_expr "[" expr "]" {
    ArrayGet(
      array = $1,
      index = $3,
      lbracket_loc = mk_loc($loc($2)),
      rbracket_loc = mk_loc($loc($4)),
      loc = mk_loc($sloc),
    )
  }
  | simple_expr "[" option(expr) ":" option(expr) "]" {
    ArrayGetSlice(
      array = $1,
      start_index = $3,
      end_index = $5,
      index_loc = mk_loc(($loc($2).0, $loc($6).1)),
      lbracket_loc = mk_loc($loc($2)),
      colon_loc = mk_loc($loc($4)),
      rbracket_loc = mk_loc($loc($6)),
      loc = mk_loc($sloc)
    )
  }
  | simple_expr DOT_LIDENT "(" list_commas_with_trailing_locs(argument) ")" {
    let method_name = Label::{ name: $2, loc: mk_loc($loc($2)) }
    let (args, comma_locs, _) = $4
    DotApply(
      self = $1,
      method_name~,
      args~,
      return_self = false,
      dot_loc = mk_loc($loc($2)),
      lparen_loc = mk_loc($loc($3)),
      rparen_loc = mk_loc($loc($5)),
      comma_locs~,
      loc = mk_loc($sloc)
    )
  }
  | simple_expr ".." LIDENT "(" list_commas_with_trailing_locs(argument) ")" {
    let method_name = Label::{ name: $3, loc: mk_loc($loc($3)) }
    let (args, comma_locs, _) = $5
    DotApply(
      self = $1,
      method_name~,
      args~,
      return_self = true,
      dot_loc = mk_loc($loc($2)),
      lparen_loc = mk_loc($loc($4)),
      rparen_loc = mk_loc($loc($6)),
      comma_locs~,
      loc = mk_loc($sloc)
    )
  }
  | simple_expr accessor %prec prec_field {
    Field(record = $1, accessor = $2, loc = mk_loc($sloc))
  }
  | type_name "::" LIDENT {
    let method_name = Label::{ name: $3, loc: mk_loc($loc($3)) }
    Method(
      type_name = $1,
      method_name~,
      coloncolon_loc = mk_loc($loc($2)),
      loc = mk_loc($sloc),
    )
  }
  | "[" "for" non_empty_list_commas_with_locs(foreach_binder) "in" infix_expr foreach_optional_loop_vars_infix_with_locs list_comp_guard "=>" expr "]" {
    let (binders, binder_comma_locs) = $3
    let (
      init,
      continue_block,
      semi_locs,
      init_comma_locs,
      init_equal_locs,
      continue_comma_locs,
      continue_equal_locs,
    ) = $6
    let (guard_, if_loc) = $7
    ListComprehension(
      kind = Foreach(
        binders~,
        expr = $5,
        init~,
        continue_block~,
        for_loc = mk_loc($loc($2)),
        in_loc = mk_loc($loc($4)),
        binder_comma_locs~,
        semi_locs~,
        init_comma_locs~,
        init_equal_locs~,
        continue_comma_locs~,
        continue_equal_locs~,
      ),
      guard_~,
      body = $9,
      lbracket_loc = mk_loc($loc($1)),
      rbracket_loc = mk_loc($loc($10)),
      if_loc~,
      fat_arrow_loc = mk_loc($loc($8)),
      loc = mk_loc($sloc)
    )
  }
  | "[" "for" list_comp_for_header list_comp_guard "=>" expr "]" {
    let (
      binders,
      condition,
      continue_block,
      binder_comma_locs,
      semi_locs,
      binder_equal_locs,
      continue_comma_locs,
      continue_equal_locs,
    ) = $3
    let (guard_, if_loc) = $4
    ListComprehension(
      kind = For(
        binders~,
        condition~,
        continue_block~,
        for_loc = mk_loc($loc($2)),
        binder_comma_locs~,
        semi_locs~,
        binder_equal_locs~,
        continue_comma_locs~,
        continue_equal_locs~,
      ),
      guard_~,
      body = $6,
      lbracket_loc = mk_loc($loc($1)),
      rbracket_loc = mk_loc($loc($7)),
      if_loc~,
      fat_arrow_loc = mk_loc($loc($5)),
      loc = mk_loc($sloc)
    )
  }
  | "[" list_commas_with_trailing_locs(spreadable_elem) "]" {
    let (elems, comma_locs, _) = $2
    @syntax.make_array_expr(
      loc = mk_loc($sloc),
      lbracket_loc = mk_loc($loc($1)),
      rbracket_loc = mk_loc($loc($3)),
      comma_locs~,
      elems,
    )
  }
  | tuple_expr { $1 }
  ;

%inline label -> Label
  : LIDENT { Label::{ name: $1, loc: mk_loc($sloc) } }
  ;

%inline accessor -> Accessor
  : DOT_LIDENT {
    if $1 == "_" {
      Newtype(loc = mk_loc($loc($1)))
    } else {
      Label(Label::{ name: $1, loc: mk_loc($sloc) })
    }
  }
  | DOT_INT { Index(tuple_index = $1, loc = mk_loc($sloc)) }
  ;

%inline binder -> Binder
  : LIDENT { Binder::{ name: $1, loc: mk_loc($sloc) } }
  ;

tvar_binder -> TypeVarBinder
  : UIDENT {
    TypeVarBinder::{
      name: $1,
      constraints: @list.empty(),
      name_loc: mk_loc($loc($1)),
      colon_loc: None,
      plus_locs: @list.empty(),
    }
  }
  | UIDENT COLON non_empty_list_pluses_with_locs(tvar_constraint) {
    let (constraints, plus_locs) = $3
    TypeVarBinder::{
      name: $1,
      constraints,
      name_loc: mk_loc($loc($1)),
      colon_loc: Some(mk_loc($loc($2))),
      plus_locs,
    }
  }
  ;

type_decl_binder -> TypeDeclBinder
  : UIDENT { TypeDeclBinder::{ name: Some($1), loc: mk_loc($sloc) } }
  | "_" { TypeDeclBinder::{ name: None, loc: mk_loc($sloc) } }
  ;

tvar_constraint -> TypeVarConstraint
  : qual_ident_ty { TypeVarConstraint::{ trait_: $1, loc: mk_loc($sloc) } }
  ;

%inline var -> Var
  : qual_ident { Var::{ name: $1, loc: mk_loc($sloc) } }
  ;

type_name -> TypeName
  : qual_ident_ty {
    TypeName::{ name: $1, is_object: false, object_amp_loc: None, loc: mk_loc($sloc) }
  }
  | "&" qual_ident_ty {
    TypeName::{ name: $2, is_object: true, object_amp_loc: Some(mk_loc($loc($1))), loc: mk_loc($sloc) }
  }
  ;

multiline_string -> MultilineStringElem
  : MULTILINE_STRING { String($1) }
  | MULTILINE_INTERP {
    Interp(make_interps($1))
  }
  ;

atomic_expr -> Expr
  : simple_constant { make_constant_expr(loc = mk_loc($sloc), $1) }
  | non_empty_list(multiline_string) {
    MultilineString(elems = $1, loc = mk_loc($sloc))
  }
  | INTERP { make_interp_expr(loc = mk_loc($sloc), $1) }
  ;

simple_constant -> Constant
  : TRUE { Bool(true) }
  | FALSE { Bool(false) }
  | BYTE { Byte($1) }
  | BYTES { Bytes($1) }
  | CHAR { Char($1) }
  | INT { make_int($1) }
  | DOUBLE { make_double($1) }
  | FLOAT { make_float($1) }
  | STRING { String($1) }
  | REGEX_LITERAL { Regex($1) }
  ;

map_syntax_key -> Constant
  : simple_constant { $1 }
  | MINUS INT { make_int("-" + $2) }
  | MINUS DOUBLE { make_double("-" + $2) }
  | MINUS FLOAT { make_float("-" + $2) }
  ;

%inline loced_string -> (StringLiteral, Location)
  : STRING { ($1, mk_loc($sloc)) }
  ;

%inline assignop -> Var
  : "+=" { Var::{ name: Ident(name = "+"), loc: mk_loc($sloc) } }
  | AUGMENTED_ASSIGNMENT { Var::{ name: Ident(name = $1), loc: mk_loc($sloc) } }
  ;

%inline infixop -> Var
  : INFIX4 { Var::{ name: Ident(name = $1), loc: mk_loc($sloc) } }
  | INFIX3 { Var::{ name: Ident(name = $1), loc: mk_loc($sloc) } }
  | INFIX2 { Var::{ name: Ident(name = $1), loc: mk_loc($sloc) } }
  | INFIX1 { Var::{ name: Ident(name = $1), loc: mk_loc($sloc) } }
  | PLUS { Var::{ name: Ident(name = "+"), loc: mk_loc($sloc) } }
  | MINUS { Var::{ name: Ident(name = "-"), loc: mk_loc($sloc) } }
  | AMPER { Var::{ name: Ident(name = "&"), loc: mk_loc($sloc) } }
  | CARET { Var::{ name: Ident(name = "^"), loc: mk_loc($sloc) } }
  | BAR { Var::{ name: Ident(name = "|"), loc: mk_loc($sloc) } }
  | AMPERAMPER { Var::{ name: Ident(name = "&&"), loc: mk_loc($sloc) } }
  | BARBAR { Var::{ name: Ident(name = "||"), loc: mk_loc($sloc) } }
  ;

optional_question -> Location?
  : "?" { Some(mk_loc($sloc)) }
  |  { None }
  ;

argument -> Argument
  : label optional_question "=" expr {
    let equal_loc = mk_loc($loc($3))
    let arg_kind : ArgumentKind = match $2 {
      Some(question_loc) => LabelledOption(label = $1, question_loc~, equal_loc~)
      None => Labelled(label = $1, equal_loc~)
    }
    Argument::{ value: $4, kind: arg_kind }
  }
  | expr { Argument::{ value: $1, kind: Positional } }
  | POST_LABEL {
    let label = Label::{ name: $1, loc: mk_loc($loc($1)) }
    let arg_value = @syntax.make_ident_expr(loc = mk_loc($loc($1)), Var::{ name: Ident(name = $1), loc: mk_loc($loc($1)) })
    Argument::{ value: arg_value, kind: LabelledPun(label) }
  }
  | LIDENT "?" {
    let loc = mk_loc($loc($1))
    let label = Label::{ name: $1, loc }
    let arg_value = @syntax.make_ident_expr(loc~, Var::{ name: Ident(name = $1), loc })
    Argument::{ value: arg_value, kind: LabelledOptionPun(label~, question_loc = mk_loc($loc($2))) }
  }
  ;

spreadable_elem -> SpreadableElem
  : expr { Regular($1) }
  | ".." expr {
    Spread(expr = $2, dotdot_loc = mk_loc($loc($1)), loc = mk_loc($sloc))
  }
  ;

map_expr_elem -> MapExprElem
  : map_syntax_key ":" expr {
    MapExprElem::{
      key: $1,
      expr: $3,
      colon_loc: mk_loc($loc($2)),
      key_loc: mk_loc($loc($1)),
      loc: mk_loc($sloc)
    }
  }
  ;

pattern -> Pattern
  : pattern "as" binder {
    @syntax.make_alias_pattern(
      loc = mk_loc($sloc),
      as_loc = mk_loc($loc($2)),
      $1,
      $3,
    )
  }
  | or_pattern { $1 }
  ;

or_pattern -> Pattern
  : range_pattern "|" or_pattern {
    Or(pat1 = $1, pat2 = $3, bar_loc = mk_loc($loc($2)), loc = mk_loc($sloc))
  }
  | range_pattern { $1 }
  ;

range_pattern -> Pattern
  : simple_pattern "..<" simple_pattern {
    Range(lhs = $1, rhs = $3, kind=Exclusive, range_op_loc = mk_loc($loc($2)), loc = mk_loc($sloc))
  }
  | simple_pattern "..=" simple_pattern {
    Range(lhs = $1, rhs = $3, kind=Inclusive, range_op_loc = mk_loc($loc($2)), loc = mk_loc($sloc))
  }
  | simple_pattern { $1 }
  ;

simple_pattern -> Pattern
  : TRUE { @syntax.make_constant_pattern(loc = mk_loc($sloc), Bool(true)) }
  | FALSE { @syntax.make_constant_pattern(loc = mk_loc($sloc), Bool(false)) }
  | CHAR { @syntax.make_constant_pattern(loc = mk_loc($sloc), Char($1)) }
  | INT { @syntax.make_constant_pattern(loc = mk_loc($sloc), @syntax.make_int($1)) }
  | BYTE { @syntax.make_constant_pattern(loc = mk_loc($sloc), Byte($1)) }
  | DOUBLE { @syntax.make_constant_pattern(loc = mk_loc($sloc), @syntax.make_double($1)) }
  | FLOAT { @syntax.make_constant_pattern(loc = mk_loc($sloc), @syntax.make_float($1)) }
  | "-" INT { @syntax.make_constant_pattern(loc = mk_loc($sloc), @syntax.make_int("-" + $2)) }
  | "-" DOUBLE { @syntax.make_constant_pattern(loc = mk_loc($sloc), @syntax.make_double("-" + $2)) }
  | "-" FLOAT { @syntax.make_constant_pattern(loc = mk_loc($sloc), @syntax.make_float("-" + $2)) }
  | STRING { @syntax.make_constant_pattern(loc = mk_loc($sloc), String($1)) }
  | BYTES { @syntax.make_constant_pattern(loc = mk_loc($sloc), Bytes($1)) }
  | UNDERSCORE { Any(loc = mk_loc($sloc)) }
  | binder { Var($1) }
  | constr optional_constr_pat_arguments {
    let (
      args,
      is_open,
      args_lparen_loc,
      args_rparen_loc,
      arg_comma_locs,
      open_dotdot_loc,
    ) = $2
    @syntax.make_constr_pattern(
      loc = mk_loc($sloc),
      args_lparen_loc~,
      args_rparen_loc~,
      arg_comma_locs~,
      open_dotdot_loc~,
      $1,
      args,
      is_open,
    )
  }
  // bits constr pattern `i32(args)`
  // To disambiguate with pattern variable, the args list must be present.
  | binder "(" constr_pat_arguments_no_open ")" {
    let (args, comma_locs) = $3
    Pattern::SpecialConstr(
      binder = $1,
      args~,
      lparen_loc = mk_loc($loc($2)),
      rparen_loc = mk_loc($loc($4)),
      comma_locs~,
      loc = mk_loc($sloc),
    )
  }
  | "(" pattern ")" { $2 }
  | "(" pattern "," non_empty_list_commas_with_trailing_locs(pattern) ")" {
    let (rest, rest_comma_locs, _) = $4
    let comma_locs = [mk_loc($loc($3))]
    rest_comma_locs.each(loc => comma_locs.push(loc))
    @syntax.make_tuple_pattern(
      loc = mk_loc($sloc),
      lparen_loc = mk_loc($loc($1)),
      rparen_loc = mk_loc($loc($5)),
      comma_locs = @list.from_array(comma_locs),
      rest.add($2),
    )
  }
  | "(" pattern ":" type_ ")" {
    Constraint(
      pat = $2,
      ty = $4,
      lparen_loc = Some(mk_loc($loc($1))),
      colon_loc = mk_loc($loc($3)),
      rparen_loc = Some(mk_loc($loc($5))),
      loc = mk_loc($sloc),
    )
  }
  | "[" array_sub_patterns "]" {
    Array(
      pats = $2,
      lbracket_loc = mk_loc($loc($1)),
      rbracket_loc = mk_loc($loc($3)),
      loc = mk_loc($sloc),
    )
  }
  | "{" "}" {
    Record(
      fields = @list.empty(),
      is_closed = true,
      lbrace_loc = mk_loc($loc($1)),
      rbrace_loc = mk_loc($loc($2)),
      comma_locs = @list.empty(),
      dotdot_loc = None,
      loc = mk_loc($sloc),
    )
  }
  | "{" ".." optional_comma_loc "}" {
    let comma_locs = match $3 {
      Some(loc) => @list.singleton(loc)
      None => @list.empty()
    }
    Record(
      fields = @list.empty(),
      is_closed = false,
      lbrace_loc = mk_loc($loc($1)),
      rbrace_loc = mk_loc($loc($4)),
      comma_locs~,
      dotdot_loc = Some(mk_loc($loc($2))),
      loc = mk_loc($sloc),
    )
  }
  | "{" non_empty_fields_pat "}" {
    let (fields, is_closed, comma_locs, dotdot_loc) = $2
    Record(
      fields~,
      is_closed~,
      lbrace_loc = mk_loc($loc($1)),
      rbrace_loc = mk_loc($loc($3)),
      comma_locs~,
      dotdot_loc~,
      loc = mk_loc($sloc),
    )
  }
  | "{" non_empty_map_elems_pat "}" {
    let (elems, is_closed, comma_locs, dotdot_loc) = $2
    Map(
      elems~,
      is_closed~,
      lbrace_loc = mk_loc($loc($1)),
      rbrace_loc = mk_loc($loc($3)),
      comma_locs~,
      dotdot_loc~,
      loc = mk_loc($sloc),
    )
  }
  ;

array_sub_pattern -> ArrayPattern
  : pattern { Pattern($1) }
  | ".." STRING {
    StringSpread(str = $2, dotdot_loc = mk_loc($loc($1)), loc = mk_loc($loc($2)))
  }
  | ".." BYTES {
    BytesSpread(bytes = $2, dotdot_loc = mk_loc($loc($1)), loc = mk_loc($loc($2)))
  }
  | ".." UIDENT {
    let binder = Binder::{ name: $2, loc: mk_loc($loc($2)) }
    ConstSpread(
      binder~,
      pkg = None,
      dotdot_loc = mk_loc($loc($1)),
      pkg_loc = None,
      dot_uident_loc = None,
      loc = mk_loc($sloc),
    )
  }
  | ".." PACKAGE_NAME DOT_UIDENT {
    let binder = Binder::{ name: $3, loc: mk_loc($loc($3)) }
    ConstSpread(
      binder~,
      pkg = Some($2),
      dotdot_loc = mk_loc($loc($1)),
      pkg_loc = Some(mk_loc($loc($2))),
      dot_uident_loc = Some(mk_loc($loc($3))),
      loc = mk_loc($sloc),
    )
  }
  ;

dotdot_binder -> DotDotBinder
  : ".." binder { Binder(binder = $2, dotdot_loc = mk_loc($loc($1))) }
  | ".." "_" {
    Underscore(dotdot_loc = mk_loc($loc($1)), underscore_loc = mk_loc($loc($2)))
  }
  | ".." "as" binder {
    BinderAs(
      binder = $3,
      dotdot_loc = mk_loc($loc($1)),
      as_loc = mk_loc($loc($2)),
    )
  }
  | ".." { NoBinder(dotdot_loc = mk_loc($loc($1))) }
  ;

array_sub_patterns -> ArrayPatterns
  :  { Closed(@list.empty(), comma_locs = @list.empty()) }
  | array_sub_pattern { Closed(@list.singleton($1), comma_locs = @list.empty()) }
  | array_sub_pattern "," array_sub_patterns {
    match $3 {
      Closed(ps, comma_locs~) =>
        Closed(ps.add($1), comma_locs = comma_locs.add(mk_loc($loc($2))))
      Open(
        ps1,
        ps2,
        b,
        left_comma_locs~,
        dotdot_comma_loc~,
        right_comma_locs~,
      ) =>
        Open(
          ps1.add($1),
          ps2,
          b,
          left_comma_locs = left_comma_locs.add(mk_loc($loc($2))),
          dotdot_comma_loc~,
          right_comma_locs~,
        )
    }
  }
  | dotdot_binder "," non_empty_list_commas_with_trailing_locs(array_sub_pattern) {
    let (right, right_comma_locs, _) = $3
    Open(
      @list.empty(),
      right,
      $1,
      left_comma_locs = @list.empty(),
      dotdot_comma_loc = Some(mk_loc($loc($2))),
      right_comma_locs~,
    )
  }
  | dotdot_binder optional_comma_loc {
    Open(
      @list.empty(),
      @list.empty(),
      $1,
      left_comma_locs = @list.empty(),
      dotdot_comma_loc = $2,
      right_comma_locs = @list.empty(),
    )
  }
  ;

error_annotation -> ErrorType
  : "raise" { DefaultErrorType(loc = mk_loc($sloc)) }
  | "raise" error_type {
    ErrorType(ty = $2, raise_loc = mk_loc($loc($1)), loc = mk_loc($sloc))
  }
  | "noraise" { Noraise(loc = mk_loc($sloc)) }
  | "raise" "?" {
    let fake_error = Type::Name(
      constr_id = ConstrId::{ id: Ident(name = "Error"), loc: mk_loc($sloc) },
      tys = @list.empty(),
      type_args_lbracket_loc = None,
      type_args_rbracket_loc = None,
      type_arg_comma_locs = @list.empty(),
      loc = mk_loc($sloc)
    )
    MaybeError(
      ty = fake_error,
      raise_loc = mk_loc($loc($1)),
      question_loc = mk_loc($loc($2)),
      loc = mk_loc($sloc),
    )
  }
  ;

return_type -> (Type, ErrorType)
  : type_ { ($1, NoErrorType) }
  | simple_type error_annotation { ($1, $2) }
  ;

func_return_type -> (Type?, ErrorType)
  : func_return_type_with_loc {
    let (ty, err, _) = $1
    (ty, err)
  }
  ;

func_return_type_with_loc -> (Type?, ErrorType, Location?)
  : "->" return_type {
    match $2 {
      (ty, err) => (Some(ty), err, Some(mk_loc($loc($1))))
    }
  }
  | error_annotation { (None, $1, None) }
  |  { (None, NoErrorType, None) }
  ;

error_type -> Type
  : qual_ident_ty {
    Name(
      constr_id = ConstrId::{ id: $1, loc: mk_loc($sloc) },
      tys = @list.empty(),
      type_args_lbracket_loc = None,
      type_args_rbracket_loc = None,
      type_arg_comma_locs = @list.empty(),
      loc = mk_loc($sloc)
    )
  }
  | "_" { Any(loc = mk_loc($sloc)) }
  ;

simple_type -> Type
  : simple_type "?" { @syntax.make_option_type(loc = mk_loc($sloc), constr_loc = mk_loc($loc($2)), $1) }
  | "(" type_ "," non_empty_list_commas_with_trailing_locs(type_) ")" {
    let (rest, rest_comma_locs, _) = $4
    let comma_locs = [mk_loc($loc($3))]
    rest_comma_locs.each(loc => comma_locs.push(loc))
    @syntax.make_tuple_type(
      loc = mk_loc($sloc),
      lparen_loc = mk_loc($loc($1)),
      rparen_loc = mk_loc($loc($5)),
      comma_locs = @list.from_array(comma_locs),
      rest.add($2),
    )
  }
  | "(" type_ ")" { $2 }
  | qual_ident_ty_inline optional_type_arguments %prec prec_lower_than_as {
    let (type_args, type_args_lbracket_loc, type_args_rbracket_loc, type_arg_comma_locs) = $2
    Name(
      constr_id = ConstrId::{ id: $1, loc: mk_loc($loc($1)) },
      tys = type_args,
      type_args_lbracket_loc~,
      type_args_rbracket_loc~,
      type_arg_comma_locs~,
      loc = mk_loc($sloc)
    )
  }
  | "&" qual_ident_ty {
    Object(
      constr_id = ConstrId::{ id: $2, loc: mk_loc($loc($2)) },
      amp_loc = mk_loc($loc($1)),
      loc = mk_loc($sloc),
    )
  }
  | "_" { Any(loc = mk_loc($sloc)) }
  ;

type_ -> Type
  : simple_type { $1 }
  | is_async "(" type_ "," ioption(non_empty_list_commas_with_trailing_locs(type_)) ")" "->" return_type {
    let (ty_res, ty_err) = $8
    let (ts, rest_comma_locs) = match $5 {
      None => (@list.empty(), @list.empty())
      Some((ts, rest_comma_locs, _)) => (ts, rest_comma_locs)
    }
    let comma_locs = [mk_loc($loc($4))]
    rest_comma_locs.each(loc => comma_locs.push(loc))
    Arrow(
      args = ts.add($3),
      res = ty_res,
      err = ty_err,
      is_async = $1,
      lparen_loc = mk_loc($loc($2)),
      rparen_loc = mk_loc($loc($6)),
      arrow_loc = mk_loc($loc($7)),
      comma_locs = @list.from_array(comma_locs),
      loc = mk_loc($sloc),
    )
  }
  | is_async "(" ")" "->" return_type {
    let (ty_res, ty_err) = $5
    Arrow(
      args = @list.empty(),
      res = ty_res,
      err = ty_err,
      is_async = $1,
      lparen_loc = mk_loc($loc($2)),
      rparen_loc = mk_loc($loc($3)),
      arrow_loc = mk_loc($loc($4)),
      comma_locs = @list.empty(),
      loc = mk_loc($sloc),
    )
  }
  | is_async "(" type_ ")" "->" return_type {
    let (ty_res, ty_err) = $6
    Arrow(
      args = @list.singleton($3),
      res = ty_res,
      err = ty_err,
      is_async = $1,
      lparen_loc = mk_loc($loc($2)),
      rparen_loc = mk_loc($loc($4)),
      arrow_loc = mk_loc($loc($5)),
      comma_locs = @list.empty(),
      loc = mk_loc($sloc),
    )
  }
  ;

record_decl_field -> FieldDecl
  : attributes visibility optional_mut_loc LIDENT ":" type_ {
    FieldDecl::{
      name: FieldName::{ label: $4, loc: mk_loc($loc($4)) },
      ty: $6,
      mut_: $3 is Some(_),
      mut_loc: $3,
      colon_loc: mk_loc($loc($5)),
      vis: $2,
      loc: mk_loc($sloc),
      attrs: $1,
      doc: DocString::empty()
    }
  }
  ;

record_constr_decl -> FunDecl
  : attributes is_async "fn" optional_type_parameters_with_locs binder parameters_with_locs func_return_type_with_loc {
    let (quantifiers, type_params_lbracket_loc, type_params_rbracket_loc, type_param_comma_locs) = $4
    let (params, params_lparen_loc, params_rparen_loc, param_comma_locs) = $6
    let (return_type, error_type, return_arrow_loc) = $7
    FunDecl::{
      type_name : None,
      name : $5,
      is_async : $2,
      declare_loc: None,
      extern_loc: None,
      fn_loc: mk_loc($loc($3)),
      coloncolon_loc: None,
      quantifiers,
      decl_params: Some(params),
      params_loc: mk_loc($loc($6)),
      type_params_lbracket_loc,
      type_params_rbracket_loc,
      type_param_comma_locs,
      params_lparen_loc: Some(params_lparen_loc),
      params_rparen_loc: Some(params_rparen_loc),
      param_comma_locs,
      return_type,
      return_arrow_loc,
      error_type,
      vis: Default,
      doc: DocString::empty(),
      attrs: $1,
      loc : mk_loc($loc)
    }
  }

record_decl_body -> (List[FieldDecl], FunDecl?, List[Location])
  : record_constr_decl option(SEMI) {
    let semi_locs = match $2 {
      Some(true) => @list.singleton(mk_loc($loc($2)))
      _ => @list.empty()
    }
    (@list.empty(), Some($1), semi_locs)
  }
  | {
    (@list.empty(), None, @list.empty())
  }
  | non_empty_list_semi_rev_aux_with_locs(record_decl_field) SEMI record_constr_decl option(SEMI) {
    let (fields, semi_locs) = $1
    let semi_locs = if $2 { semi_locs.add(mk_loc($loc($2))) } else { semi_locs }
    let semi_locs = match $4 {
      Some(true) => semi_locs.add(mk_loc($loc($4)))
      _ => semi_locs
    }
    (fields.rev(), Some($3), semi_locs.rev())
  }
  | non_empty_list_semi_rev_aux_with_locs(record_decl_field) option(SEMI) {
    let (fields, semi_locs) = $1
    let semi_locs = match $2 {
      Some(true) => semi_locs.add(mk_loc($loc($2)))
      _ => semi_locs
    }
    (fields.rev(), None, semi_locs.rev())
  }

constructor_param -> ConstrParam
  : optional_mut_loc type_ {
    ConstrParam::{
      ty: $2,
      mut_: $1 is Some(_),
      label: None,
      mut_loc: $1,
      post_label_loc: None,
      colon_loc: None,
    }
  }
  | optional_mut_loc POST_LABEL ":" type_ {
    let label = Label::{ name: $2, loc: mk_loc($loc($2)).trim_last_char() }
    ConstrParam::{
      ty: $4,
      mut_: $1 is Some(_),
      label: Some(label),
      mut_loc: $1,
      post_label_loc: Some(mk_loc($loc($2))),
      colon_loc: Some(mk_loc($loc($3))),
    }
  }
  ;

enum_constructor -> ConstrDecl
  : attributes UIDENT optional_constructor_params option(eq_int_tag) {
    let (args, args_lparen_loc, args_rparen_loc, arg_comma_locs) = $3
    let (tag, tag_equal_loc) = match $4 {
      None => (None, None)
      Some((tag, equal_loc)) => (Some(tag), Some(equal_loc))
    }
    ConstrDecl::{
      name: ConstrName::{ name: $2, loc: mk_loc($loc($2)) },
      args,
      args_lparen_loc,
      args_rparen_loc,
      arg_comma_locs,
      tag,
      tag_equal_loc,
      loc: mk_loc($sloc),
      attrs: $1,
      doc: DocString::empty()
    }
  }
  ;

optional_constructor_params -> (List[ConstrParam]?, Location?, Location?, List[Location])
  : { (None, None, None, @list.empty()) }
  | "(" non_empty_list_commas_with_trailing_locs(constructor_param) ")" {
    let (args, comma_locs, _) = $2
    (Some(args), Some(mk_loc($loc($1))), Some(mk_loc($loc($3))), comma_locs)
  }
  ;

%inline eq_int_tag -> ((String, Location), Location)
  : "=" INT { (($2, mk_loc($loc($2))), mk_loc($loc($1))) }
  ;

record_defn -> (List[FieldDef], TrailingMark, List[Location], List[Location])
  : label_pun "," list_commas_with_trailing_locs(record_defn_single) {
    let (fs, comma_locs, trailing) = $3
    let trailing_mark = if fs.is_empty() || trailing { TrailingMark::Comma } else { TrailingMark::None }
    (fs.add($1), trailing_mark, comma_locs.add(mk_loc($loc($2))), @list.empty())
  }
  | labeled_expr {
    (@list.singleton($1), TrailingMark::None, @list.empty(), @list.empty())
  }
  | labeled_expr "," {
    (@list.singleton($1), TrailingMark::Comma, @list.singleton(mk_loc($loc($2))), @list.empty())
  }
  | labeled_expr "," non_empty_list_commas_with_trailing_locs(record_defn_single) {
    let (fs, comma_locs, trailing) = $3
    let trailing_mark = if trailing { TrailingMark::Comma } else { TrailingMark::None }
    (fs.add($1), trailing_mark, comma_locs.add(mk_loc($loc($2))), @list.empty())
  }
  ;

record_defn_single -> FieldDef
  : labeled_expr { $1 }
 | label_pun { $1 }
  ;

%inline labeled_expr -> FieldDef
  : label ":" expr {
    @syntax.make_field_def(
      loc = mk_loc($sloc),
      colon_loc = Some(mk_loc($loc($2))),
      $1,
      $3,
      false,
    )
  }
  ;

%inline label_pun -> FieldDef
  : label { @syntax.make_field_def(loc = mk_loc($sloc), $1, @syntax.label_to_expr(loc = mk_loc($sloc), $1), true) }
  ;

non_empty_fields_pat -> (List[FieldPat], Bool, List[Location], Location?)
  : non_empty_list_commas_with_trailing_locs(fields_pat_single) {
    let (fields, comma_locs, _) = $1
    (fields, true, comma_locs, None)
  }
  | non_empty_list_commas_with_trailing_locs(fields_pat_single) ".." optional_comma_loc {
    let (fields, comma_locs, _) = $1
    let comma_locs_array = []
    comma_locs.each(loc => comma_locs_array.push(loc))
    match $3 {
      Some(loc) => comma_locs_array.push(loc)
      None => ()
    }
    (fields, false, @list.from_array(comma_locs_array), Some(mk_loc($loc($2))))
  }
  ;

fields_pat_single -> FieldPat
  : fpat_labeled_pattern { $1 }
 | fpat_label_pun { $1 }
  ;

%inline fpat_labeled_pattern -> FieldPat
  : label ":" pattern {
    @syntax.make_field_pat(
      loc = mk_loc($sloc),
      colon_loc = Some(mk_loc($loc($2))),
      $1,
      $3,
      false,
    )
  }
  ;

%inline fpat_label_pun -> FieldPat
  : label { @syntax.make_field_pat(loc = mk_loc($sloc), $1, @syntax.label_to_pat(loc = mk_loc($sloc), $1), true) }
  ;

non_empty_map_elems_pat -> (List[MapPatElem], Bool, List[Location], Location?)
  : non_empty_list_commas_with_trailing_locs(map_elem_pat) {
    let (elems, comma_locs, _) = $1
    (elems, true, comma_locs, None)
  }
  | non_empty_list_commas_with_trailing_locs(map_elem_pat) ".." optional_comma_loc {
    let (elems, comma_locs, _) = $1
    let comma_locs_array = []
    comma_locs.each(loc => comma_locs_array.push(loc))
    match $3 {
      Some(loc) => comma_locs_array.push(loc)
      None => ()
    }
    (elems, false, @list.from_array(comma_locs_array), Some(mk_loc($loc($2))))
  }
  ;

%inline map_elem_pat -> MapPatElem
  : map_syntax_key option("?") ":" pattern {
    MapPatElem::{
      key: $1,
      pat: $4,
      match_absent: $2 is Some(_),
      key_loc: mk_loc($loc($1)),
      question_loc: $2.map(_ => mk_loc($loc($2))),
      colon_loc: mk_loc($loc($3)),
      loc: mk_loc($sloc)
    }
  }
  ;

optional_constr_pat_arguments -> (List[ConstrPatArg]?, Bool, Location?, Location?, List[Location], Location?)
  : { (None, false, None, None, @list.empty(), None) }
  | "(" constr_pat_arguments ")" {
    let (args, is_open, arg_comma_locs, open_dotdot_loc) = $2
    (
      Some(args),
      is_open,
      Some(mk_loc($loc($1))),
      Some(mk_loc($loc($3))),
      arg_comma_locs,
      open_dotdot_loc,
    )
  }
  ;

constr_pat_arguments -> (List[ConstrPatArg], Bool, List[Location], Location?)
  : constr_pat_argument optional_comma_loc {
    let arg_comma_locs = match $2 {
      Some(loc) => @list.singleton(loc)
      None => @list.empty()
    }
    (@list.singleton($1), false, arg_comma_locs, None)
  }
  | ".." optional_comma_loc {
    let arg_comma_locs = match $2 {
      Some(loc) => @list.singleton(loc)
      None => @list.empty()
    }
    (@list.empty(), true, arg_comma_locs, Some(mk_loc($loc($1))))
  }
  | constr_pat_argument "," constr_pat_arguments {
    let (args, is_open, arg_comma_locs, open_dotdot_loc) = $3
    (args.add($1), is_open, arg_comma_locs.add(mk_loc($loc($2))), open_dotdot_loc)
  }
  ;

constr_pat_arguments_no_open -> (List[ConstrPatArg], List[Location])
  : non_empty_list_commas_with_trailing_locs(constr_pat_argument) {
    let (args, comma_locs, _) = $1
    (args, comma_locs)
  }
  ;

constr_pat_argument -> ConstrPatArg
  : label "=" pattern {
    let equal_loc = mk_loc($loc($2))
    ConstrPatArg::{
      pat: $3,
      kind: Labelled(label = $1, equal_loc~),
      equal_loc: Some(equal_loc),
    }
  }
  | POST_LABEL {
    let loc = mk_loc($loc($1))
    let label = Label::{ name: $1, loc }
    let pat = @syntax.label_to_pat(loc = loc.trim_last_char(), label)
    ConstrPatArg::{
      pat,
      kind: LabelledPun(label),
      equal_loc: None,
    }
  }
  | pattern {
    ConstrPatArg::{
      pat: $1,
      kind: Positional,
      equal_loc: None,
    }
  }
  ;
