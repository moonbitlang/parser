import {
  "moonbitlang/lexer/tokens",
  "moonbitlang/lexer",
  "moonbitlang/lexer/basic",
  "moonbitlang/core/list",
  "moonbitlang/core/debug",
}

warnings = "-6-3"

formatter(ignore: [ "parser.mbt" ])

rule(
  name: "moonyacc",
  command: "moon runwasm moonbitlang/yacc@0.7.17 --input-mode array --external-tokens $input -o $output",
)

dev_build(rule: "moonyacc", input: "parser.mbty", output: "parser.mbt")
