import {
  "moonbitlang/lexer/tokens",
  "moonbitlang/lexer",
  "moonbitlang/lexer/basic",
  "moonbitlang/core/list",
  "moonbitlang/core/debug",
}

warnings = "-unused_type_declaration-unused_constructor"

formatter(ignore: [ "parser.mbt" ])

rule(
  name: "moonyacc",
  command: "moonx moonbitlang/yacc@0.7.26 --input-mode array --external-tokens $input -o $output",
)

dev_build(rule: "moonyacc", input: "parser.mbty", output: "parser.mbt")
