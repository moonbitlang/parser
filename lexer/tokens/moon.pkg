import {
  "moonbitlang/lexer/basic",
}

warnings = "-unused_constructor-deprecated_syntax"

formatter(ignore: [ "tokens.mbt" ])

rule(
  name: "moonyacc",
  command: "moonx moonbitlang/yacc@0.7.25 --mode only-tokens $input -o $output",
)

dev_build(rule: "moonyacc", input: "parser.mbty", output: "tokens.mbt")
