type IntBoolPair = (Int, Bool)
type NestedRaise = () -> (() -> Unit) raise
type NestedTypedRaise = () -> (() -> Unit) raise Error
type NestedMaybeRaise = () -> (() -> Unit) raise?
type NestedNoraise = () -> (() -> Unit) noraise
type NestedNocancel = () -> (() -> Unit) nocancel
type NestedCombined = () -> (() -> Unit) nocancel + raise Error
type NestedAsync = () -> (async () -> Unit) noraise + nocancel
type NestedWithoutEffect = () -> (() -> Unit)
