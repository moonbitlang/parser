///|
pub(all) enum CstDeclarationChild {
  Async(CstNode)
  AsyncLoc(CstNode)
  Attrs(CstNode)
  Body(CstNode)
  Clause(CstNode)
  DeclBodyKind(CstNode)
  DeclLoc(CstNode)
  Declare(CstNode)
  Deriving(CstNode)
  EffectOp(CstNode)
  Error(CstNode)
  Expr(CstNode)
  HeaderLoc(CstNode)
  Kind(CstNode)
  Kw(CstNode)
  Language(CstNode)
  LanguageToken(CstNode)
  Method(CstNode)
  Name(CstNode)
  Nocancel(CstNode)
  Object(CstNode)
  ObjectLoc(CstNode)
  Op(CstNode)
  Params(CstNode)
  Pattern(CstNode)
  Quantifier(CstNode)
  SemanticName(CstNode)
  SemanticTypeName(CstNode)
  Stub(CstNode)
  StubToken(CstNode)
  TestName(CstNode)
  Trait(CstNode)
  Trivia(CstNode)
  Type_(CstNode)
  TypeDesc(CstNode)
  TypeName(CstNode)
  Vis(CstNode)
  Where(CstNode)
}

///|
fn entries_from_cstdeclarationchild(
  entries : ArrayView[CstDeclarationChild],
) -> Array[(String?, CstNode)] {
  let children : Array[(String?, CstNode)] = []
  for entry in entries {
    match entry {
      Async(child) => children.push((Some("async"), child))
      AsyncLoc(child) => children.push((Some("async_loc"), child))
      Attrs(child) => children.push((Some("attrs"), child))
      Body(child) => children.push((Some("body"), child))
      Clause(child) => children.push((Some("clause"), child))
      DeclBodyKind(child) => children.push((Some("decl_body_kind"), child))
      DeclLoc(child) => children.push((Some("decl_loc"), child))
      Declare(child) => children.push((Some("declare"), child))
      Deriving(child) => children.push((Some("deriving"), child))
      EffectOp(child) => children.push((Some("effect_op"), child))
      Error(child) => children.push((Some("error"), child))
      Expr(child) => children.push((Some("expr"), child))
      HeaderLoc(child) => children.push((Some("header_loc"), child))
      Kind(child) => children.push((Some("kind"), child))
      Kw(child) => children.push((Some("kw"), child))
      Language(child) => children.push((Some("language"), child))
      LanguageToken(child) => children.push((Some("language_token"), child))
      Method(child) => children.push((Some("method"), child))
      Name(child) => children.push((Some("name"), child))
      Nocancel(child) => children.push((Some("nocancel"), child))
      Object(child) => children.push((Some("object"), child))
      ObjectLoc(child) => children.push((Some("object_loc"), child))
      Op(child) => children.push((Some("op"), child))
      Params(child) => children.push((Some("params"), child))
      Pattern(child) => children.push((Some("pattern"), child))
      Quantifier(child) => children.push((Some("quantifier"), child))
      SemanticName(child) => children.push((Some("semantic_name"), child))
      SemanticTypeName(child) =>
        children.push((Some("semantic_type_name"), child))
      Stub(child) => children.push((Some("stub"), child))
      StubToken(child) => children.push((Some("stub_token"), child))
      TestName(child) => children.push((Some("test_name"), child))
      Trait(child) => children.push((Some("trait"), child))
      Trivia(child) => children.push((Some("trivia"), child))
      Type_(child) => children.push((Some("type"), child))
      TypeDesc(child) => children.push((Some("type_desc"), child))
      TypeName(child) => children.push((Some("type_name"), child))
      Vis(child) => children.push((Some("vis"), child))
      Where(child) => children.push((Some("where"), child))
    }
  }
  children
}

///|
pub(all) enum CstListChild {
  Case(CstNode)
  Close(CstNode)
  Error(CstNode)
  Item(CstNode)
  Open(CstNode)
  Sep(CstNode)
  Trailing(CstNode)
  Trivia(CstNode)
}

///|
fn entries_from_cstlistchild(
  entries : ArrayView[CstListChild],
) -> Array[(String?, CstNode)] {
  let children : Array[(String?, CstNode)] = []
  for entry in entries {
    match entry {
      Case(child) => children.push((Some("case"), child))
      Close(child) => children.push((Some("close"), child))
      Error(child) => children.push((Some("error"), child))
      Item(child) => children.push((Some("item"), child))
      Open(child) => children.push((Some("open"), child))
      Sep(child) => children.push((Some("sep"), child))
      Trailing(child) => children.push((Some("trailing"), child))
      Trivia(child) => children.push((Some("trivia"), child))
    }
  }
  children
}

///|
pub(all) enum CstMultilineChild {
  Element(CstNode)
  LiteralLoc(CstNode)
  Token(CstNode)
  Trivia(CstNode)
}

///|
fn entries_from_cstmultilinechild(
  entries : ArrayView[CstMultilineChild],
) -> Array[(String?, CstNode)] {
  let children : Array[(String?, CstNode)] = []
  for entry in entries {
    match entry {
      Element(child) => children.push((Some("element"), child))
      LiteralLoc(child) => children.push((Some("literal_loc"), child))
      Token(child) => children.push((Some("token"), child))
      Trivia(child) => children.push((Some("trivia"), child))
    }
  }
  children
}

