///|
pub(all) enum CstRootChild {
  Eof(CstNode)
  Error(CstNode)
  Expr(CstNode)
  Item(CstNode)
  Sep(CstNode)
  Trivia(CstNode)
}

///|
fn entries_from_cstrootchild(
  entries : ArrayView[CstRootChild],
) -> Array[(String?, CstNode)] {
  let children : Array[(String?, CstNode)] = []
  for entry in entries {
    match entry {
      Eof(child) => children.push((Some("eof"), child))
      Error(child) => children.push((Some("error"), child))
      Expr(child) => children.push((Some("expr"), child))
      Item(child) => children.push((Some("item"), child))
      Sep(child) => children.push((Some("sep"), child))
      Trivia(child) => children.push((Some("trivia"), child))
    }
  }
  children
}
