import {
  "moonbitlang/lexer/tokens",
  "moonbitlang/lexer/basic",
  "moonbitlang/parser/mbti_ast",
  "moonbitlang/parser/syntax",
  "moonbitlang/parser/attribute",
  "moonbitlang/lexer",
  "moonbitlang/core/list",
}

warnings = "-unused_constructor-deprecated_syntax"

formatter(ignore: [ "mbti_parser.mbt" ])

rule(
  name: "moonyacc",
  command: "moonx moonbitlang/yacc@0.7.25 --input-mode array --external-tokens $input -o $output",
)

dev_build(
  rule: "moonyacc",
  input: "mbti_parser.mbty",
  output: "mbti_parser.mbt",
)
