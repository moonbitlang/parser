import {
  "moonbitlang/parser/tokens",
  "moonbitlang/parser/basic",
  "moonbitlang/parser/mbti_ast",
  "moonbitlang/parser/syntax",
  "moonbitlang/parser/attribute",
  "moonbitlang/parser/lexer",
  "moonbitlang/core/list",
}

warnings = "-6"

rule(
  name: "moonyacc",
  command: "moon runwasm moonbitlang/yacc@0.7.14 --input-mode array --external-tokens $input -o $output && moonfmt -w $output && moonfmt -w $output",
)

dev_build(
  rule: "moonyacc",
  input: "mbti_parser.mbty",
  output: "mbti_parser.mbt",
)
