%position<@basic.Position>
%derive<Debug> ParseError
%start mbti

%token<CharLiteral> CHAR
%token<String> INT
%token<CharLiteral> BYTE
%token<StringLiteral> BYTES
%token<String> FLOAT
%token<String> DOUBLE
%token<StringLiteral> STRING
%token<String> MULTILINE_STRING
%token<InterpLiteral> MULTILINE_INTERP
%token<InterpLiteral> INTERP
%token<String> REGEX_LITERAL
%token<InterpLiteral> REGEX_INTERP
%token<(String, Option[String], String)> ATTRIBUTE
%token<String> LIDENT
%token<String> UIDENT
%token<String> POST_LABEL
%token<Comment> COMMENT
%token NEWLINE
%token<String> INFIX1
%token<String> INFIX2
%token<String> INFIX3
%token<String> INFIX4
%token<String> AUGMENTED_ASSIGNMENT
%token PLUS_EQUAL "+="
%token EOF
%token FALSE
%token TRUE
%token PUB "pub"
%token PRIV "priv"
%token READONLY "readonly"
%token IMPORT "import"
%token EXTERN "extern"
%token BREAK "break"
%token CONTINUE "continue"
%token STRUCT "struct"
%token ENUM "enum"
%token TRAIT "trait"
%token DERIVE "derive"
%token IMPL "impl"
%token WITH "with"
%token RAISE "raise"
%token THROW "throw"
%token TRY "try"
%token CATCH "catch"
%token ASYNC "async"
%token TYPEALIAS "typealias"
%token TRAITALIAS "traitalias"
%token FNALIAS "fnalias"
%token EQUAL "="
%token EQ_TILDE "=~"
%token LPAREN "("
%token RPAREN ")"
%token COMMA ","
%token MINUS "-"
%token QUESTION "?"
%token EXCLAMATION "!"
%token<String> DOT_LIDENT
%token<String> DOT_UIDENT
%token<Int> DOT_INT
%token DOT_LPAREN ".("
%token COLONCOLON "::"
%token COLON ":"
%token<Bool> SEMI ";"
%token LBRACKET "["
%token PLUS "+"
%token RBRACKET "]"
%token UNDERSCORE "_"
%token BAR "|"
%token LBRACE "{"
%token RBRACE "}"
%token AMPERAMPER "&&"
%token AMPER "&"
%token CARET "^"
%token BARBAR "||"
%token<String> PACKAGE_NAME
%token AS "as"
%token PIPE "|>"
%token PIPE_LEFT "<|"
%token LT_PLUS "<+"
%token ELSE "else"
%token FN "fn"
%token IF "if"
%token LET "let"
%token PROOF_ASSERT "proof_assert"
%token PROOF_LET "proof_let"
%token CONST "const"
%token MATCH "match"
%token MUTABLE "mut"
%token TYPE "type"
%token FAT_ARROW "=>"
%token THIN_ARROW "->"
%token WHILE "while"
%token RETURN "return"
%token DOTDOT ".."
%token RANGE_INCLUSIVE "..="
%token RANGE_LT_INCLUSIVE  "..<="
%token RANGE_EXCLUSIVE "..<"
%token RANGE_INCLUSIVE_REV ">=.."
%token RANGE_EXCLUSIVE_REV ">.."
%token ELLIPSIS "..."
%token TEST "test"
%token LOOP "loop"
%token GUARD "guard"
%token DEFER "defer"
%token FOR "for"
%token IN "in"
%token IS "is"
%token SUBERROR        "suberror"
%token AND "and"
%token FORALL "∀"
%token EXISTS "∃"
%token IMPLIES "→"
%token LETREC "letrec"
%token USING "using"
%token DECLARE         "declare"
%token NORAISE "noraise"
%token NOBREAK         "nobreak"
%token WHERE           "where"
%token ENUMVIEW "enumview"
%token EXTENUM "extenum"
%token TRY_QUESTION    "try?"
%token TRY_EXCLAMATION "try!"
%token LEXMATCH        "lexmatch"
%token LEXMATCH_QUESTION "lexmatch?"
%token PACKAGE         "package"

%%

non_empty_list_commas_rev[T](X : T) -> @list.List[T]
  : X { @list.singleton($1) }
  | non_empty_list_commas_rev(X) "," X { $1.add($3) }
  ;

non_empty_list_commas[T](X : T) -> @list.List[T]
  : non_empty_list_commas_rev(X) option(",") { $1.rev() }
  ;

non_empty_list_commas_with_locs_rev[T](X : T) -> (@list.List[T], @list.List[Location])
  : X { (@list.singleton($1), @list.empty()) }
  | non_empty_list_commas_with_locs_rev(X) "," X {
    let (xs, locs) = $1
    (xs.add($3), locs.add(mk_loc($loc($2))))
  }
  ;

non_empty_list_commas_with_locs[T](X : T) -> (@list.List[T], @list.List[Location])
  : non_empty_list_commas_with_locs_rev(X) {
    let (xs, locs) = $1
    (xs.rev(), locs.rev())
  }
  ;

non_empty_list_semis_with_locs_rev[T](X : T) -> (@list.List[T], @list.List[Location])
  : X { (@list.singleton($1), @list.empty()) }
  | non_empty_list_semis_with_locs_rev(X) ";" X {
    let (xs, locs) = $1
    (xs.add($3), locs.add(mk_loc($loc($2))))
  }
  ;

non_empty_list_semis_with_trailing_locs[T](X : T) -> (@list.List[T], @list.List[Location], Bool)
  : non_empty_list_semis_with_locs_rev(X) {
    let (xs, locs) = $1
    (xs.rev(), locs.rev(), false)
  }
  | non_empty_list_semis_with_locs_rev(X) ";" {
    let (xs, locs) = $1
    (xs.rev(), locs.add(mk_loc($loc($2))).rev(), true)
  }
  ;

list_semis_with_trailing_locs[T](X : T) -> (@list.List[T], @list.List[Location], Bool)
  : { (@list.empty(), @list.empty(), false) }
  | non_empty_list_semis_with_trailing_locs(X) { $1 }
  ;

%inline optional_mut_loc -> Location?
  : "mut" { Some(mk_loc($loc($1))) }
  | { None }
  ;

mbti -> Mbti
  : PACKAGE STRING ioption(";") imports sigs EOF { Mbti::{package_name: $2, imports: $4, sigs: $5, loc : mk_loc($sloc), base_pos: mk_base_pos($loc($1).0)} }
  ;

imports -> @list.List[PackageImport]
  :  { @list.empty() }
  | "import" "{" non_empty_list_commas(package_import) "}" ";" { $3 }
  ;

package_import -> PackageImport
  : STRING { PackageImport::{name: $1, alias_: None} }
  | STRING "as" PACKAGE_NAME { PackageImport::{name: $1, alias_: Some($3)} }
  ;

sigs -> @list.List[(Sig, Location)]
  :  { @list.empty() }
  | sig_ { @list.singleton(($1, mk_loc($sloc))) }
  | sig_ ";" sigs { $3.add(($1, mk_loc($loc($1)))) }
  ;

sig_ -> Sig
  : func_sig { Func($1) }
  | type_sig { Type($1) }
  | alias_sig { Alias($1) }
  | trait_sig { Trait($1) }
  | impl_sig { Impl($1) }
  | const_sig { Const($1) }
  | value_sig { Value($1) }
  ;

const_sig -> ConstSig
  : attributes vis "const" uident ":" type_ "=" constant { ConstSig::{name: $4, type_: $6, value: $8, attrs: $1} }
  ;

value_sig -> ValueSig
  : attributes vis "let" lident ":" type_ { ValueSig::{ attrs: $1, name: $4, type_: $6 } }
  ;

method_self_type_coloncolon -> MethodSelfType
 : UIDENT "::" {
  MethodSelfType::{ name : $1, is_object : false, loc : mk_loc($loc($1)) }
 }
 | "&" UIDENT "::" {
  MethodSelfType::{ name : $2, is_object : true, loc : mk_loc($loc($2)) }
 }
 ;

luident -> Name
  : lident { $1 }
  | uident { $1 }
  ;

func_name -> (MethodSelfType?, Name)
  : luident { (None, $1) }
  | method_self_type_coloncolon luident { (Some($1), $2) }
  ;

method_prefix -> Option[Name]
  : { None }
  | uident "::" { Some($1) }
  ;


func_sig -> FuncSig
  : attributes vis is_async FN loption(type_params_with_constraints) func_name delimited("(", separated_list(",", parameter), ")") "->" return_type {
    let (type_name, name) = $6
    FuncSig::{ attrs: $1, is_async : $3, type_name, name, type_params: $5, params: $7, return_: $9}
  }
  ;

trait_method_sig -> TraitMethodSig
  : attributes is_async lident delimited("(", separated_list(",", parameter), ")") "->" return_type boption(eq_underscore) {
    TraitMethodSig::{ attrs : $1, is_async: $2, name: $3, params: $4, return_: $6, has_default: $7}
  }
  ;

%inline eq_underscore
  : "=" "_" {}
  ;

type_sig -> TypeSig
  : attributes vis "type" type_decl_name_with_params optional_derive {
    TypeSig::{attrs : $1, vis: $2, name: $4.0, type_params: $4.1, components: Abstract, derives: $5}
  }
  | attributes vis "suberror" uident optional_derive {
    TypeSig::{attrs : $1, vis: $2, name: $4, type_params: @list.empty(), components: Error(NoPayload), derives: $5}
  }
  | attributes vis "suberror" uident "{" list_semis_with_trailing_locs(enum_constructor) "}" optional_derive {
    let (constrs, semi_locs, _) = $6
    TypeSig::{attrs : $1, vis: $2, name: $4, type_params: @list.empty(), components: Error(EnumPayload(constrs~, lbrace_loc=mk_loc($loc($5)), rbrace_loc=mk_loc($loc($7)), semi_locs~)), derives: $8}
  }
  | attributes vis "struct" type_decl_name_with_params "{" record_decl_body "}" optional_derive {
    TypeSig::{attrs : $1, vis: $2, name: $4.0, type_params: $4.1, components: $6, derives: $8 }
  }
  | attributes vis "struct" type_decl_name_with_params "(" separated_list(",", type_) ")" optional_derive {
    TypeSig::{attrs : $1, vis: $2, name: $4.0, type_params: $4.1, components: TupleStruct($6), derives: $8}
  }
  | attributes vis "enum" type_decl_name_with_params "{" separated_list(";", enum_constructor) "}" optional_derive {
    TypeSig::{attrs : $1, vis: $2, name: $4.0, type_params: $4.1, components: Variant($6), derives: $8}
  }
  | attributes vis "extenum" type_decl_name_with_params "{" separated_list(";", enum_constructor) "}" optional_derive {
    TypeSig::{attrs : $1, vis: $2, name: $4.0, type_params: $4.1, components: ExtensibleEnum($6), derives: $8}
  }
  | attributes vis "extenum" extensible_enum_extension_target "+=" "{" separated_list(";", enum_constructor) "}" optional_derive {
    let (name, type_params, target) = $4
    TypeSig::{attrs : $1, vis: $2, name, type_params, components: ExtendEnum(target~, constructors = $7), derives: $9}
  }
  ;

optional_derive -> @list.List[QualifiedName]
  : { @list.empty() }
  | "derive" "(" non_empty_list_commas(qualified_uident) ")" { $3 }
  ;

impl_sig -> ImplSig
  : attributes vis "impl" type_params_with_constraints qualified_uident "for" type_ {
    ImplSig::{type_params : $4, trait_name : $5, type_ : $7, attrs : $1}
  }
  | attributes vis "impl" qualified_uident "for" type_ {
    ImplSig::{type_params : @list.empty(), trait_name : $4, type_ : $6, attrs : $1}
  }
  ;

trait_sig -> TraitSig
  : attributes vis "trait" uident loption(preceded(":", separated_nonempty_list("+", qualified_uident))) trait_body {
    TraitSig::{ attrs : $1, vis: $2, name: $4, super_traits: $5, methods: $6}
  }
  ;

trait_body -> @list.List[TraitMethodSig]
  : { @list.empty() }
  | "{" separated_list(";", trait_method_sig) "}" { $2 }
  ;

using_binder -> Name?
  : { None }
  | "as" uident { Some($2) }
  ;

alias_sig -> AliasSig
  : attributes vis "type"  type_decl_name_with_params "=" type_ {
    TypeAlias(attrs = $1, vis=$2, name=$4.0, type_params=$4.1, type_=$6)
  }
  | attributes vis "fnalias" uident "::" lident {
    FuncAlias(attrs = $1,name=$6, type_name=$4)
  }
  | attributes vis "using" PACKAGE_NAME "{" "type" uident using_binder "}" {
    let pkg = Name::{ name : $4, loc : mk_loc($loc($4)) }
    Using(pkg~, target = $7, name = $8, kind = Type(loc=mk_loc($loc($6))), attrs = $1)
  }
  | attributes vis "using" PACKAGE_NAME "{" "trait" uident using_binder "}" {
    let pkg = Name::{ name : $4, loc : mk_loc($loc($4)) }
    Using(pkg~, target = $7, name = $8, kind = Trait(loc=mk_loc($loc($6))), attrs = $1)
  }
  ;

enum_constructor -> ConstrDecl
  : attributes UIDENT optional_constructor_params option(eq_tag) {
    let (args, args_lparen_loc, args_rparen_loc, arg_comma_locs) = $3
    let (tag, tag_equal_loc) = match $4 {
      None => (None, None)
      Some((tag, equal_loc)) => (Some(tag), Some(equal_loc))
    }
    ConstrDecl::{name: ConstrName::{ name : $2, loc : mk_loc($loc($2)) }, args, args_lparen_loc, args_rparen_loc, arg_comma_locs, tag, tag_equal_loc, loc: mk_loc($sloc), attrs: $1, doc: DocString::empty()}
  }
  ;

optional_constructor_params -> (@list.List[ConstrParam]?, Location?, Location?, @list.List[Location])
  : { (None, None, None, @list.empty()) }
  | "(" non_empty_list_commas_with_locs(constructor_param) ")" {
    let (args, comma_locs) = $2
    (Some(args), Some(mk_loc($loc($1))), Some(mk_loc($loc($3))), comma_locs)
  }
  ;

%inline eq_tag -> ((String, Location), Location)
  : "=" INT { (($2, mk_loc($loc($2))), mk_loc($loc($1))) }
  ;

constructor_param -> ConstrParam
  : optional_mut_loc type_ { ConstrParam::{mut_: $1 is Some(_), ty: $2, label: None, mut_loc: $1, post_label_loc: None, colon_loc: None} }
  | optional_mut_loc post_label ":" type_ { ConstrParam::{mut_: $1 is Some(_), ty: $4, label: Some($2), mut_loc: $1, post_label_loc: Some(mk_loc($loc($2))), colon_loc: Some(mk_loc($loc($3)))} }
  ;

record_decl_field -> FieldDecl
  : attributes optional_mut_loc LIDENT ":" type_ {
    FieldDecl::{ name: FieldName::{ label: $3, loc : mk_loc($loc($3)) }, vis: Default, mut_: $2 is Some(_), mut_loc: $2, colon_loc: mk_loc($loc($4)), ty: $5, loc: mk_loc($sloc), attrs: $1, doc: DocString::empty() }
  }
  ;

record_decl_body -> TypeDefinition
  : separated_list(";", record_decl_field) {
    Record(fields = $1, constr = None)
  }
  ;

type_param_with_constraints -> TypeParamWithConstraints
  : uident { TypeParamWithConstraints::{name: $1, constraints: @list.empty()} }
  | uident ":" separated_nonempty_list("+", type_constraint) { TypeParamWithConstraints::{name: $1, constraints: $3} }
  ;

type_params_with_constraints -> @list.List[TypeParamWithConstraints]
  : "[" separated_list(",", type_param_with_constraints) "]" { $2 }
  ;

type_param_no_constraints -> TypeParamNoConstraints
  : uident { Name($1) }
  | "_" { Underscore(mk_loc($sloc)) }
  ;

type_params_no_constraints -> @list.List[TypeParamNoConstraints]
  : "[" separated_list(",", type_param_no_constraints) "]" { $2 }
  ;

optional_type_params_no_constraints -> @list.List[TypeParamNoConstraints]
  : { @list.empty() }
  | type_params_no_constraints { $1 }
  ;

type_constraint -> QualifiedName
  : qualified_uident { $1 }
  ;

type_decl_name_with_params -> (Name, @list.List[TypeParamNoConstraints])
  : uident optional_type_params_no_constraints { ($1, $2) }
  ;

extensible_enum_extension_target -> (Name, @list.List[TypeParamNoConstraints], QualifiedName)
  : uident optional_type_params_no_constraints {
    let target = QualifiedName::{ name: Ident(name = $1.name), loc: $1.loc }
    ($1, $2, target)
  }
  | PACKAGE_NAME DOT_UIDENT optional_type_params_no_constraints {
    let name = Name::{ name: $2, loc: mk_loc($loc($2)) }
    let target = QualifiedName::{
      name: Dot(pkg = $1, id = $2, pkg_loc = mk_loc($loc($1)), dot_id_loc = mk_loc($loc($2))),
      loc: mk_loc($sloc),
    }
    (name, $3, target)
  }
  ;

simple_type -> Type
  : simple_type "?" { Option(ty=$1, loc=mk_loc($sloc), question_loc=mk_loc($loc($2))) }
  | "(" type_ "," non_empty_list_commas_with_locs(type_) ")" {
    let (rest, rest_comma_locs) = $4
    let comma_locs = [mk_loc($loc($3))]
    rest_comma_locs.each(loc => comma_locs.push(loc))
    Tuple(
      tys = rest.add($2),
      lparen_loc = mk_loc($loc($1)),
      rparen_loc = mk_loc($loc($5)),
      comma_locs = @list.from_array(comma_locs),
      loc = mk_loc($sloc),
    )
  }
  | "(" type_ ")" { $2 }
  | qualified_uident_ optional_type_arguments {
    let (type_args, type_args_lbracket_loc, type_args_rbracket_loc, type_arg_comma_locs) = $2
    Name(
      constr_id=$1,
      tys=type_args,
      type_args_lbracket_loc~,
      type_args_rbracket_loc~,
      type_arg_comma_locs~,
      loc=mk_loc($sloc),
    )
  }
  | "&" qualified_uident_ {
    Object(constr_id=$2, amp_loc=mk_loc($loc($1)), loc=mk_loc($sloc))
  }
  | "_" { Any(loc=mk_loc($sloc)) }


type_ -> Type
  : simple_type { $1 }
  | is_async "(" type_ "," ioption(non_empty_list_commas_with_locs(type_)) ")" "->" return_type {
    let (rest, rest_comma_locs) = match $5 {
      None => (@list.empty(), @list.empty())
      Some(pair) => pair
    }
    let comma_locs = [mk_loc($loc($4))]
    rest_comma_locs.each(loc => comma_locs.push(loc))
    Arrow(
      args=rest.add($3),
      res=$8.0,
      err=$8.1,
      is_async=$1,
      lparen_loc=mk_loc($loc($2)),
      rparen_loc=mk_loc($loc($6)),
      arrow_loc=mk_loc($loc($7)),
      comma_locs=@list.from_array(comma_locs),
      loc=mk_loc($sloc),
    )
  }
  | is_async "(" ")" "->" return_type {
    Arrow(
      args=@list.empty(),
      res=$5.0,
      err=$5.1,
      is_async=$1,
      lparen_loc=mk_loc($loc($2)),
      rparen_loc=mk_loc($loc($3)),
      arrow_loc=mk_loc($loc($4)),
      comma_locs=@list.empty(),
      loc=mk_loc($sloc),
    )
  }
  | is_async "(" type_ ")" "->" return_type {
    Arrow(
      args=@list.singleton($3),
      res=$6.0,
      err=$6.1,
      is_async=$1,
      lparen_loc=mk_loc($loc($2)),
      rparen_loc=mk_loc($loc($4)),
      arrow_loc=mk_loc($loc($5)),
      comma_locs=@list.empty(),
      loc=mk_loc($sloc),
    )
  }
  ;

return_type -> (Type, ErrorType)
  : type_ { ($1, NoErrorType) }
  | simple_type "noraise" { ($1, Noraise(loc=mk_loc($sloc))) }
  | simple_type "raise" { ($1, DefaultErrorType(loc=mk_loc($loc($2)))) }
  | simple_type "raise" error_type {
    let raise_loc = mk_loc($loc($2))
    ($1, ErrorType(ty = $3, raise_loc~, loc = raise_loc.merge(mk_loc($loc($3)))))
  }
  | simple_type "raise" "?" {
    let raise_loc = mk_loc($loc($2))
    let question_loc = mk_loc($loc($3))
    let loc = raise_loc.merge(question_loc)
    let fake_error : Type = Name(
      constr_id={ id : QualifiedIdent::Ident(name="Error"), loc },
      tys=@list.empty(),
      type_args_lbracket_loc=None,
      type_args_rbracket_loc=None,
      type_arg_comma_locs=@list.empty(),
      loc~,
    )
    ($1, MaybeError(
      ty=fake_error,
      raise_loc~,
      question_loc~,
      loc~,
    ))
  }
  ;

error_type -> Type
  : qualified_uident_ {
    Name(
      constr_id=$1,
      tys=@list.empty(),
      type_args_lbracket_loc=None,
      type_args_rbracket_loc=None,
      type_arg_comma_locs=@list.empty(),
      loc=mk_loc($sloc),
    )
  }
  ;

optional_type_arguments -> (@list.List[Type], Location?, Location?, @list.List[Location])
  : "[" non_empty_list_commas_with_locs(type_) "]" {
    let (types, comma_locs) = $2
    (types, Some(mk_loc($loc($1))), Some(mk_loc($loc($3))), comma_locs)
  }
  |  { (@list.empty(), None, None, @list.empty()) }
  ;

parameter -> Parameter
  : type_ {
    DiscardPositional(
      ty = Some($1),
      colon_loc = None,
      loc = @syntax.no_location,
    )
  }
  | POST_LABEL ":" type_ {
    Labelled(
      binder = { name : $1, loc : mk_loc($loc($1)).trim_last_char() },
      ty = Some($3),
      post_label_loc = Some(mk_loc($loc($1))),
      colon_loc = Some(mk_loc($loc($2))),
    )
  }
  | label "?" ":" type_ {
    QuestionOptional(
      binder = { name : $1.name, loc : $1.loc },
      ty = Some($4),
      question_loc = mk_loc($loc($2)),
      colon_loc = Some(mk_loc($loc($3))),
    )
  }
  ;

constant -> Constant
  : TRUE { Bool(true) }
  | FALSE { Bool(false) }
  | BYTE { Byte($1) }
  | BYTES { Bytes($1) }
  | CHAR { Char($1) }
  | INT { make_int_literal($1) }
  | "-" INT { make_int_literal("-" + $2) }
  | FLOAT { make_float_literal($1) }
  | "-" FLOAT { make_float_literal("-" + $2) }
  | DOUBLE { Double($1) }
  | "-" DOUBLE { Double("-" + $2) }
  | STRING { String($1) }
  ;

%inline vis -> Visibility
  : { Default }
  | "priv" { Priv(loc=mk_loc($sloc)) }
  | "pub" pub_attr { Pub(attr=$2, loc=mk_loc($sloc)) }
  ;

pub_attr -> String?
  : { None }
  | "(" "readonly" ")" { Some("readonly") }
  | "(" LIDENT ")" { Some($2) }
  ;

%inline is_async -> Location?
  : "async" { Some(mk_loc($loc($1))) }
  | { None }
  ;

qualified_uident -> QualifiedName
  : UIDENT { QualifiedName::{ name: Ident(name=$1), loc: mk_loc($sloc)} }
  | PACKAGE_NAME DOT_UIDENT {
    QualifiedName::{
      name: Dot(pkg=$1, id=$2, pkg_loc=mk_loc($loc($1)), dot_id_loc=mk_loc($loc($2))),
      loc: mk_loc($sloc),
    }
  }
  ;

qualified_uident_ -> ConstrId
  : UIDENT { ConstrId::{ id: Ident(name=$1), loc: mk_loc($sloc)} }
  | PACKAGE_NAME DOT_UIDENT {
    ConstrId::{
      id: Dot(pkg=$1, id=$2, pkg_loc=mk_loc($loc($1)), dot_id_loc=mk_loc($loc($2))),
      loc: mk_loc($sloc),
    }
  }
  ;

uident -> Name
  : UIDENT { Name::{name: $1, loc: mk_loc($sloc)} }
  ;

lident -> Name
  : LIDENT { Name::{name: $1, loc: mk_loc($sloc)} }
  ;

label -> Label
  : LIDENT { Label::{name: $1, loc: mk_loc($sloc)} }
  ;

post_label -> Label
  : POST_LABEL { Label::{name: $1, loc: Location::trim_last_char(mk_loc($sloc))} }
  ;

%inline attributes -> @list.List[Attribute]
  :  {  @list.empty() }
  | nonempty_list(attribute) { $1 }
  ;

%inline attribute -> Attribute
  : ATTRIBUTE { Attribute::new(loc=mk_loc($sloc), $1) }
  ;
