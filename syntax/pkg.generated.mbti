  fn visit_Label(Self, Label) -> Label = _
  fn visit_ConstrName(Self, ConstrName) -> ConstrName = _
  fn visit_LongIdent(Self, LongIdent) -> LongIdent = _
  fn visit_LongIdent_Ident(Self, name~ : String) -> LongIdent = _
  fn visit_LongIdent_Dot(Self, pkg~ : String, id~ : String, pkg_loc~ : @basic.Location, dot_id_loc~ : @basic.Location) -> LongIdent = _
  fn visit_TypeName(Self, TypeName) -> TypeName = _
  fn visit_ConstrId(Self, ConstrId) -> ConstrId = _
  fn visit_Type(Self, Type) -> Type = _
  fn visit_Type_Any(Self, loc~ : @basic.Location) -> Type = _
  fn visit_Type_Arrow(Self, args~ : @list.List[Type], res~ : Type, err~ : ErrorType, is_async~ : @basic.Location?, lparen_loc~ : @basic.Location, rparen_loc~ : @basic.Location, arrow_loc~ : @basic.Location, comma_locs~ : @list.List[@basic.Location], loc~ : @basic.Location) -> Type = _
  fn visit_Type_Tuple(Self, tys~ : @list.List[Type], lparen_loc~ : @basic.Location, rparen_loc~ : @basic.Location, comma_locs~ : @list.List[@basic.Location], loc~ : @basic.Location) -> Type = _
  fn visit_Type_Name(Self, constr_id~ : ConstrId, tys~ : @list.List[Type], type_args_lbracket_loc~ : @basic.Location?, type_args_rbracket_loc~ : @basic.Location?, type_arg_comma_locs~ : @list.List[@basic.Location], loc~ : @basic.Location) -> Type = _
  fn visit_Type_Option(Self, ty~ : Type, loc~ : @basic.Location, question_loc~ : @basic.Location) -> Type = _
  fn visit_Type_Object(Self, constr_id~ : ConstrId, amp_loc~ : @basic.Location, loc~ : @basic.Location) -> Type = _
  fn visit_ErrorType(Self, ErrorType) -> ErrorType = _
  fn visit_ErrorType_ErrorType(Self, ty~ : Type, raise_loc~ : @basic.Location, loc~ : @basic.Location) -> ErrorType = _
