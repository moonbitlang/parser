// Traits
pub(open) trait IterVisitor {
  fn base(Self) -> IterVisitorBase[Self] = _
  fn visit_Visibility(Self, Visibility) -> Unit = _
  fn visit_Visibility_Pub(Self, attr~ : String?, loc~ : @basic.Location) -> Unit = _
  fn visit_Visibility_Priv(Self, loc~ : @basic.Location) -> Unit = _
  fn visit_Constant(Self, Constant) -> Unit = _
  fn visit_Label(Self, Label) -> Unit = _
  fn visit_ConstrName(Self, ConstrName) -> Unit = _
  fn visit_LongIdent(Self, LongIdent) -> Unit = _
  fn visit_LongIdent_Ident(Self, name~ : String) -> Unit = _
  fn visit_LongIdent_Dot(Self, pkg~ : String, id~ : String, pkg_loc~ : @basic.Location, dot_id_loc~ : @basic.Location) -> Unit = _
  fn visit_TypeName(Self, TypeName) -> Unit = _
  fn visit_ConstrId(Self, ConstrId) -> Unit = _
  fn visit_Type(Self, Type) -> Unit = _
  fn visit_Type_Any(Self, loc~ : @basic.Location) -> Unit = _
  fn visit_Type_Arrow(Self, args~ : @list.List[Type], res~ : Type, err~ : ErrorType, is_async~ : @basic.Location?, lparen_loc~ : @basic.Location, rparen_loc~ : @basic.Location, arrow_loc~ : @basic.Location, comma_locs~ : @list.List[@basic.Location], loc~ : @basic.Location) -> Unit = _
  fn visit_Type_Name(Self, constr_id~ : ConstrId, tys~ : @list.List[Type], type_args_lbracket_loc~ : @basic.Location?, type_args_rbracket_loc~ : @basic.Location?, type_arg_comma_locs~ : @list.List[@basic.Location], loc~ : @basic.Location) -> Unit = _
  fn visit_Type_Tuple(Self, tys~ : @list.List[Type], lparen_loc~ : @basic.Location, rparen_loc~ : @basic.Location, comma_locs~ : @list.List[@basic.Location], loc~ : @basic.Location) -> Unit = _
  fn visit_Type_Option(Self, ty~ : Type, loc~ : @basic.Location, question_loc~ : @basic.Location) -> Unit = _
  fn visit_Type_Object(Self, constr_id~ : ConstrId, amp_loc~ : @basic.Location, loc~ : @basic.Location) -> Unit = _
  fn visit_ErrorType(Self, ErrorType) -> Unit = _
  fn visit_ErrorType_ErrorType(Self, ty~ : Type, raise_loc~ : @basic.Location, loc~ : @basic.Location) -> Unit = _
  fn visit_ErrorType_DefaultErrorType(Self, loc~ : @basic.Location) -> Unit = _
  fn visit_ErrorType_Noraise(Self, loc~ : @basic.Location) -> Unit = _
  fn visit_ErrorType_MaybeError(Self, ty~ : Type, raise_loc~ : @basic.Location, question_loc~ : @basic.Location, loc~ : @basic.Location) -> Unit = _
  fn visit_ConstrParam(Self, ConstrParam) -> Unit = _
  fn visit_ConstrDecl(Self, ConstrDecl) -> Unit = _
  fn visit_ExceptionDecl(Self, ExceptionDecl) -> Unit = _
  fn visit_ExceptionDecl_EnumPayload(Self, constrs~ : @list.List[ConstrDecl], lbrace_loc~ : @basic.Location, rbrace_loc~ : @basic.Location, semi_locs~ : @list.List[@basic.Location]) -> Unit = _
  fn visit_FieldName(Self, FieldName) -> Unit = _
  fn visit_FieldDecl(Self, FieldDecl) -> Unit = _
  fn visit_TypeDesc(Self, TypeDesc) -> Unit = _
  fn visit_TypeDesc_Error(Self, ExceptionDecl) -> Unit = _
  fn visit_TypeDesc_Variant(Self, constrs~ : @list.List[ConstrDecl], lbrace_loc~ : @basic.Location, rbrace_loc~ : @basic.Location, semi_locs~ : @list.List[@basic.Location]) -> Unit = _
  fn visit_TypeDesc_Record(Self, fields~ : @list.List[FieldDecl], constr_decl~ : FunDecl?, lbrace_loc~ : @basic.Location, rbrace_loc~ : @basic.Location, semi_locs~ : @list.List[@basic.Location]) -> Unit = _
  fn visit_TypeDesc_TupleStruct(Self, types~ : @list.List[Type], lparen_loc~ : @basic.Location, rparen_loc~ : @basic.Location, comma_locs~ : @list.List[@basic.Location]) -> Unit = _
  fn visit_TypeDesc_Alias(Self, type_~ : Type, equal_loc~ : @basic.Location) -> Unit = _
  fn visit_Hole(Self, Hole) -> Unit = _
  fn visit_ArgumentKind(Self, ArgumentKind) -> Unit = _
  fn visit_ArgumentKind_Labelled(Self, label~ : Label, equal_loc~ : @basic.Location) -> Unit = _
  fn visit_ArgumentKind_LabelledPun(Self, Label) -> Unit = _
  fn visit_ArgumentKind_LabelledOption(Self, label~ : Label, question_loc~ : @basic.Location, equal_loc~ : @basic.Location) -> Unit = _
  fn visit_ArgumentKind_LabelledOptionPun(Self, label~ : Label, question_loc~ : @basic.Location) -> Unit = _
  fn visit_FnKind(Self, FnKind) -> Unit = _
  fn visit_Group(Self, Group) -> Unit = _
  fn visit_TrailingMark(Self, TrailingMark) -> Unit = _
  fn visit_TypeVarConstraint(Self, TypeVarConstraint) -> Unit = _
  fn visit_TypeVarBinder(Self, TypeVarBinder) -> Unit = _
  fn visit_TypeDeclBinder(Self, TypeDeclBinder) -> Unit = _
  fn visit_Binder(Self, Binder) -> Unit = _
  fn visit_Var(Self, Var) -> Unit = _
  fn visit_ConstructorExtraInfo(Self, ConstructorExtraInfo) -> Unit = _
  fn visit_ConstructorExtraInfo_TypeName(Self, type_name~ : TypeName, coloncolon_loc~ : @basic.Location) -> Unit = _
  fn visit_ConstructorExtraInfo_Package(Self, pkg~ : String, pkg_loc~ : @basic.Location, dot_constr_loc~ : @basic.Location) -> Unit = _
  fn visit_Constructor(Self, Constructor) -> Unit = _
  fn visit_Accessor(Self, Accessor) -> Unit = _
  fn visit_Accessor_Label(Self, Label) -> Unit = _
  fn visit_Accessor_Index(Self, tuple_index~ : Int, loc~ : @basic.Location) -> Unit = _
  fn visit_Accessor_Newtype(Self, loc~ : @basic.Location) -> Unit = _
  fn visit_AliasTarget(Self, AliasTarget) -> Unit = _
  fn visit_Argument(Self, Argument) -> Unit = _
  fn visit_Parameter(Self, Parameter) -> Unit = _
  fn visit_Parameter_DiscardPositional(Self, ty~ : Type?, colon_loc~ : @basic.Location?, loc~ : @basic.Location) -> Unit = _
  fn visit_Parameter_Positional(Self, binder~ : Binder, ty~ : Type?, colon_loc~ : @basic.Location?) -> Unit = _
  fn visit_Parameter_Labelled(Self, binder~ : Binder, ty~ : Type?, post_label_loc~ : @basic.Location?, colon_loc~ : @basic.Location?) -> Unit = _
  fn visit_Parameter_Optional(Self, binder~ : Binder, default~ : Expr, ty~ : Type?, post_label_loc~ : @basic.Location?, question_loc~ : @basic.Location?, colon_loc~ : @basic.Location?, equal_loc~ : @basic.Location) -> Unit = _
  fn visit_Parameter_QuestionOptional(Self, binder~ : Binder, ty~ : Type?, question_loc~ : @basic.Location, colon_loc~ : @basic.Location?) -> Unit = _
  fn visit_Case(Self, Case) -> Unit = _
  fn visit_LexCase(Self, LexCase) -> Unit = _
  fn visit_LexTopPattern(Self, LexTopPattern) -> Unit = _
  fn visit_LexTopPattern_Pattern(Self, LexPattern) -> Unit = _
  fn visit_LexTopPattern_Binder(Self, Binder) -> Unit = _
  fn visit_LexTopPattern_Wildcard(Self, loc~ : @basic.Location) -> Unit = _
  fn visit_LexPattern(Self, LexPattern) -> Unit = _
  fn visit_LexPattern_Regex(Self, lit~ : String, offset~ : Int, loc~ : @basic.Location) -> Unit = _
  fn visit_LexPattern_RegexInterp(Self, elems~ : @list.List[InterpElem], loc~ : @basic.Location) -> Unit = _
  fn visit_LexPattern_ConstantRef(Self, lid~ : LongIdent, loc~ : @basic.Location) -> Unit = _
  fn visit_LexPattern_Alias(Self, pat~ : LexPattern, binder~ : Binder, as_loc~ : @basic.Location, loc~ : @basic.Location) -> Unit = _
  fn visit_LexPattern_Sequence(Self, pats~ : @list.List[LexPattern], semi_locs~ : @list.List[@basic.Location], loc~ : @basic.Location) -> Unit = _
  fn visit_SpreadableElem(Self, SpreadableElem) -> Unit = _
  fn visit_SpreadableElem_Regular(Self, Expr) -> Unit = _
  fn visit_SpreadableElem_Spread(Self, expr~ : Expr, dotdot_loc~ : @basic.Location, loc~ : @basic.Location) -> Unit = _
  fn visit_MapExprElem(Self, MapExprElem) -> Unit = _
  fn visit_StaticAssertion(Self, StaticAssertion) -> Unit = _
  fn visit_Func(Self, Func) -> Unit = _
  fn visit_FieldDef(Self, FieldDef) -> Unit = _
  fn visit_InterpElem(Self, InterpElem) -> Unit = _
  fn visit_InterpElem_Literal(Self, repr~ : String, loc~ : @basic.Location) -> Unit = _
