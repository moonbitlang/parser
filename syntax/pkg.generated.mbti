  fn visit_ConstrId(Self, ConstrId) -> Unit = _
  fn visit_Type(Self, Type) -> Unit = _
  fn visit_Type_Any(Self, loc~ : @basic.Location) -> Unit = _
  fn visit_Type_Arrow(Self, args~ : @list.List[Type], res~ : Type, err~ : ErrorType, is_async~ : @basic.Location?, loc~ : @basic.Location) -> Unit = _
  fn visit_Type_Name(Self, constr_id~ : ConstrId, tys~ : @list.List[Type], loc~ : @basic.Location) -> Unit = _
  fn visit_Type_Tuple(Self, tys~ : @list.List[Type], loc~ : @basic.Location) -> Unit = _
  fn visit_Type_Option(Self, ty~ : Type, loc~ : @basic.Location, question_loc~ : @basic.Location) -> Unit = _
  fn visit_Type_Object(Self, ConstrId) -> Unit = _
  fn visit_ErrorType(Self, ErrorType) -> Unit = _
  fn visit_ErrorType_ErrorType(Self, ty~ : Type) -> Unit = _
  fn visit_ErrorType_DefaultErrorType(Self, loc~ : @basic.Location) -> Unit = _
  fn visit_ErrorType_Noraise(Self, loc~ : @basic.Location) -> Unit = _
  fn visit_ErrorType_MaybeError(Self, ty~ : Type) -> Unit = _
  fn visit_ConstrParam(Self, ConstrParam) -> Unit = _
  fn visit_ConstrDecl(Self, ConstrDecl) -> Unit = _
  fn visit_ExceptionDecl(Self, ExceptionDecl) -> Unit = _
  fn visit_ExceptionDecl_EnumPayload(Self, @list.List[ConstrDecl]) -> Unit = _
  fn visit_FieldName(Self, FieldName) -> Unit = _
  fn visit_FieldDecl(Self, FieldDecl) -> Unit = _
  fn visit_TypeDesc(Self, TypeDesc) -> Unit = _
  fn visit_TypeDesc_Error(Self, ExceptionDecl) -> Unit = _
  fn visit_TypeDesc_Variant(Self, @list.List[ConstrDecl]) -> Unit = _
  fn visit_TypeDesc_Record(Self, fields~ : @list.List[FieldDecl]) -> Unit = _
  fn visit_TypeDesc_TupleStruct(Self, @list.List[Type]) -> Unit = _
  fn visit_TypeDesc_Alias(Self, Type) -> Unit = _
  fn visit_Hole(Self, Hole) -> Unit = _
  fn visit_ArgumentKind(Self, ArgumentKind) -> Unit = _
  fn visit_ArgumentKind_Labelled(Self, Label) -> Unit = _
  fn visit_ArgumentKind_LabelledPun(Self, Label) -> Unit = _
  fn visit_ArgumentKind_LabelledOption(Self, label~ : Label, question_loc~ : @basic.Location) -> Unit = _
  fn visit_ArgumentKind_LabelledOptionPun(Self, label~ : Label, question_loc~ : @basic.Location) -> Unit = _
  fn visit_FnKind(Self, FnKind) -> Unit = _
  fn visit_Group(Self, Group) -> Unit = _
  fn visit_TrailingMark(Self, TrailingMark) -> Unit = _
  fn visit_TypeVarConstraint(Self, TypeVarConstraint) -> Unit = _
  fn visit_TypeVarBinder(Self, TypeVarBinder) -> Unit = _
  fn visit_TypeDeclBinder(Self, TypeDeclBinder) -> Unit = _
  fn visit_Binder(Self, Binder) -> Unit = _
  fn visit_Var(Self, Var) -> Unit = _
  fn visit_ConstructorExtraInfo(Self, ConstructorExtraInfo) -> Unit = _
  fn visit_ConstructorExtraInfo_TypeName(Self, TypeName) -> Unit = _
  fn visit_ConstructorExtraInfo_Package(Self, String) -> Unit = _
  fn visit_Constructor(Self, Constructor) -> Unit = _
  fn visit_Accessor(Self, Accessor) -> Unit = _
  fn visit_Accessor_Label(Self, Label) -> Unit = _
  fn visit_Accessor_Index(Self, tuple_index~ : Int, loc~ : @basic.Location) -> Unit = _
  fn visit_Accessor_Newtype(Self, loc~ : @basic.Location) -> Unit = _
  fn visit_AliasTarget(Self, AliasTarget) -> Unit = _
  fn visit_Argument(Self, Argument) -> Unit = _
  fn visit_Parameter(Self, Parameter) -> Unit = _
  fn visit_Parameter_DiscardPositional(Self, ty~ : Type?, loc~ : @basic.Location) -> Unit = _
  fn visit_Parameter_Positional(Self, binder~ : Binder, ty~ : Type?) -> Unit = _
  fn visit_Parameter_Labelled(Self, binder~ : Binder, ty~ : Type?) -> Unit = _
  fn visit_Parameter_Optional(Self, binder~ : Binder, default~ : Expr, ty~ : Type?) -> Unit = _
  fn visit_Parameter_QuestionOptional(Self, binder~ : Binder, ty~ : Type?) -> Unit = _
  fn visit_Case(Self, Case) -> Unit = _
  fn visit_LexCase(Self, LexCase) -> Unit = _
  fn visit_LexTopPattern(Self, LexTopPattern) -> Unit = _
  fn visit_LexTopPattern_Pattern(Self, LexPattern) -> Unit = _
  fn visit_LexTopPattern_Binder(Self, Binder) -> Unit = _
  fn visit_LexTopPattern_Wildcard(Self, loc~ : @basic.Location) -> Unit = _
  fn visit_LexPattern(Self, LexPattern) -> Unit = _
  fn visit_LexPattern_Regex(Self, lit~ : String, offset~ : Int, loc~ : @basic.Location) -> Unit = _
  fn visit_LexPattern_RegexInterp(Self, elems~ : @list.List[InterpElem], loc~ : @basic.Location) -> Unit = _
  fn visit_LexPattern_ConstantRef(Self, lid~ : LongIdent, loc~ : @basic.Location) -> Unit = _
  fn visit_LexPattern_Alias(Self, pat~ : LexPattern, binder~ : Binder, loc~ : @basic.Location) -> Unit = _
  fn visit_LexPattern_Sequence(Self, pats~ : @list.List[LexPattern], loc~ : @basic.Location) -> Unit = _
  fn visit_SpreadableElem(Self, SpreadableElem) -> Unit = _
  fn visit_SpreadableElem_Regular(Self, Expr) -> Unit = _
  fn visit_SpreadableElem_Spread(Self, expr~ : Expr, loc~ : @basic.Location) -> Unit = _
  fn visit_MapExprElem(Self, MapExprElem) -> Unit = _
  fn visit_StaticAssertion(Self, StaticAssertion) -> Unit = _
  fn visit_Func(Self, Func) -> Unit = _
  fn visit_FieldDef(Self, FieldDef) -> Unit = _
  fn visit_InterpElem(Self, InterpElem) -> Unit = _
  fn visit_InterpElem_Literal(Self, repr~ : String, loc~ : @basic.Location) -> Unit = _
  fn visit_InterpElem_Expr(Self, expr~ : Expr, loc~ : @basic.Location) -> Unit = _
  fn visit_InterpElem_Source(Self, @tokens.InterpSource) -> Unit = _
  fn visit_MultilineStringElem(Self, MultilineStringElem) -> Unit = _
  fn visit_MultilineStringElem_String(Self, String) -> Unit = _
  fn visit_MultilineStringElem_Interp(Self, @list.List[InterpElem]) -> Unit = _
  fn visit_TryOperatorKind(Self, TryOperatorKind) -> Unit = _
  fn visit_DotDotBinder(Self, DotDotBinder) -> Unit = _
  fn visit_DotDotBinder_BinderAs(Self, Binder) -> Unit = _
  fn visit_DotDotBinder_Binder(Self, Binder) -> Unit = _
  fn visit_ArrayPattern(Self, ArrayPattern) -> Unit = _
  fn visit_ArrayPattern_Pattern(Self, Pattern) -> Unit = _
  fn visit_ArrayPattern_StringSpread(Self, str~ : String, loc~ : @basic.Location) -> Unit = _
  fn visit_ArrayPattern_BytesSpread(Self, bytes~ : String, loc~ : @basic.Location) -> Unit = _
  fn visit_ArrayPattern_ConstSpread(Self, binder~ : Binder, pkg~ : String?, loc~ : @basic.Location) -> Unit = _
  fn visit_ArrayPatterns(Self, ArrayPatterns) -> Unit = _
  fn visit_ArrayPatterns_Closed(Self, @list.List[ArrayPattern]) -> Unit = _
  fn visit_ArrayPatterns_Open(Self, @list.List[ArrayPattern], @list.List[ArrayPattern], DotDotBinder) -> Unit = _
  fn visit_WhereClause(Self, WhereClause) -> Unit = _
  fn visit_FieldPat(Self, FieldPat) -> Unit = _
  fn visit_ConstrPatArg(Self, ConstrPatArg) -> Unit = _
  fn visit_MapPatElem(Self, MapPatElem) -> Unit = _
  fn visit_RangeKind(Self, RangeKind) -> Unit = _
  fn visit_Pattern(Self, Pattern) -> Unit = _
  fn visit_Pattern_Alias(Self, pat~ : Pattern, alias_~ : Binder, loc~ : @basic.Location) -> Unit = _
  fn visit_Pattern_Any(Self, loc~ : @basic.Location) -> Unit = _
  fn visit_Pattern_Array(Self, pats~ : ArrayPatterns, loc~ : @basic.Location) -> Unit = _
  fn visit_Pattern_Constant(Self, c~ : Constant, loc~ : @basic.Location) -> Unit = _
  fn visit_Pattern_Constraint(Self, pat~ : Pattern, ty~ : Type, loc~ : @basic.Location) -> Unit = _
  fn visit_Pattern_Constr(Self, constr~ : Constructor, args~ : @list.List[ConstrPatArg]?, is_open~ : Bool, loc~ : @basic.Location) -> Unit = _
  fn visit_Pattern_Or(Self, pat1~ : Pattern, pat2~ : Pattern, loc~ : @basic.Location) -> Unit = _
  fn visit_Pattern_Tuple(Self, pats~ : @list.List[Pattern], loc~ : @basic.Location) -> Unit = _
  fn visit_Pattern_Var(Self, Binder) -> Unit = _
  fn visit_Pattern_Record(Self, fields~ : @list.List[FieldPat], is_closed~ : Bool, loc~ : @basic.Location) -> Unit = _
  fn visit_Pattern_Map(Self, elems~ : @list.List[MapPatElem], is_closed~ : Bool, loc~ : @basic.Location) -> Unit = _
  fn visit_Pattern_Range(Self, lhs~ : Pattern, rhs~ : Pattern, kind~ : RangeKind, loc~ : @basic.Location) -> Unit = _
