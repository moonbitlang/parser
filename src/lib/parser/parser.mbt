    T_MULTILINE_INTERP => Shift(yy_state_4)
    T_MULTILINE_STRING => Shift(yy_state_5)
    T_STRING => Shift(yy_state_6)
    T_FLOAT => Shift(yy_state_7)
    T_DOUBLE => Shift(yy_state_8)
    T_INT => Shift(yy_state_9)
    T_CHAR => Shift(yy_state_10)
    T_BYTES => Shift(yy_state_11)
    T_BYTE => Shift(yy_state_12)
    T_FALSE => Shift(yy_state_13)
    T_TRUE => Shift(yy_state_14)
    T_INTERP => Shift(yy_state_15)
    NT_non_empty_list_multiline_string_ => Shift(yy_state_16)
    NT_simple_constant => Shift(yy_state_17)
    T_AMPER => Shift(yy_state_18)
    NT_luident => Shift(yy_state_23)
    NT_qual_ident_ty => Shift(yy_state_26)
    NT_tuple_expr => Shift(yy_state_27)
    T_LBRACKET => Shift(yy_state_28)
    NT_constr => Shift(yy_state_35)
    NT_qual_ident_simple_expr => Shift(yy_state_36)
    NT_atomic_expr => Shift(yy_state_37)
    NT_anony_fn => Shift(yy_state_38)
    T_LBRACE => Shift(yy_state_39)
    NT_fn_header_no_binder => Shift(yy_state_47)
    T_UIDENT => Shift(yy_state_101)
    T_ASYNC => Shift(yy_state_262)
    NT_type_name => Shift(yy_state_280)
    NT_simple_expr => Shift(yy_state_291)
    T_EXCLAMATION => Shift(yy_state_302)
    T_MINUS => Shift(yy_state_317)
    T_PLUS => Shift(yy_state_319)
    T_FN => Shift(yy_state_321)
    NT_prefix_expr => Shift(yy_state_334)
    T_PACKAGE_NAME => Shift(yy_state_337)
    NT_range_expr => Shift(yy_state_347)
    NT_postfix_expr => Shift(yy_state_352)
    NT_infix_expr => Shift(yy_state_353)
    T_UNDERSCORE => Shift(yy_state_376)
    T_LPAREN => Shift(yy_state_384)
    NT_pipe_expr => Shift(yy_state_417)
    NT_arrow_fn_expr => Shift(yy_state_428)
    NT_simple_try_expr => Shift(yy_state_429)
    NT_match_expr => Shift(yy_state_430)
    NT_if_expr => Shift(yy_state_431)
    NT_try_expr => Shift(yy_state_432)
    NT_while_expr => Shift(yy_state_433)
    NT_foreach_expr => Shift(yy_state_434)
    NT_for_expr => Shift(yy_state_435)
    NT_loop_expr => Shift(yy_state_436)
    NT_match_header => Shift(yy_state_437)
    T_MATCH => Shift(yy_state_441)
    T_IF => Shift(yy_state_447)
    T_TRY => Shift(yy_state_453)
    NT_loop_label_colon => Shift(yy_state_475)
    T_POST_LABEL => Shift(yy_state_488)
    T_LIDENT => Shift(yy_state_490)
    NT_expr => Shift(yy_state_729)
    T_WHILE | T_LOOP | T_FOR => Reduce(0, NT_loop_label_colon, yy_action_477)
